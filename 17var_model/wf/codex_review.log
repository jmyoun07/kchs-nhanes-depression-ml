  32: # §2.8 튜닝된 LightGBM (ROUND F 내부CV 선택 설정)
  33: LGB=dict(num_leaves=31,min_child_samples=1000,learning_rate=0.01,n_estimators=900,reg_alpha=1.0,reg_lambda=20.0,subsample=0.6,colsample_bytree=0.6,random_state=SEED,n_jobs=-1,verbose=-1)
  34: def _logit(p): p=np.clip(p,1e-6,1-1e-6); return np.log(p/(1-p))
  35: def cal_si(yv,p,w=None):
  36:     """보정 기울기와 (기울기 자유추정 모델의) 절편."""
  37:     c=LogisticRegression(penalty=None,solver="lbfgs").fit(_logit(p).reshape(-1,1),yv,sample_weight=w); return float(c.coef_[0,0]),float(c.intercept_[0])
  38: def citl(yv,p,w=None):
  39:     """정식 CITL(§2.9): 선형예측자를 offset으로 고정(기울기=1)한 절편. 양수 = 관측>예측(과소예측)."""
  40:     lp=_logit(p); w=np.ones_like(lp) if w is None else w; a=0.0
  41:     for _ in range(200):
  42:         mu=1/(1+np.exp(-(a+lp))); g=np.sum(w*(yv-mu)); h=np.sum(w*mu*(1-mu))
  43:         if h<=0: break
  44:         step=g/h; a+=step
  45:         if abs(step)<1e-10: break
  46:     return float(a)
  47: def metrics(yv,p,w=None):
  48:     sl,_=cal_si(yv,p,w)
  49:     return dict(AUROC=roc_auc_score(yv,p,sample_weight=w),AUPRC=average_precision_score(yv,p,sample_weight=w),
  50:                 Brier=brier_score_loss(yv,p,sample_weight=w),cal_slope=sl,CITL=citl(yv,p,w),
  51:                 obs=float(np.average(yv,weights=w)),pred=float(np.average(p,weights=w)))
  52: class ClusterBoot:
  53:     """층별 군집 부트스트랩(§2.9): 각 층 h에서 n_h개 PSU를 복원추출(Rao-Wu)."""
  54:     def __init__(self,strata,psu):
  55:         cl=pd.factorize(pd.Series(strata).astype(str)+"|"+pd.Series(psu).astype(str))[0]
  56:         st=pd.factorize(pd.Series(strata).astype(str))[0]
  57:         order=np.argsort(cl,kind="stable"); self.members=order
  58:         self.counts=np.bincount(cl); self.offs=np.concatenate([[0],np.cumsum(self.counts)])
  59:         first=np.zeros(len(self.counts),dtype=int); first[cl[order]]=st[order]
  60:         o2=np.argsort(first,kind="stable"); self.cl_sorted=o2
  61:         sc=np.bincount(first[o2]); st_start=np.concatenate([[0],np.cumsum(sc)])[:-1]
  62:         self.slot_start=st_start[first[o2]]; self.slot_n=sc[first[o2]]; self.C=len(self.counts)
  63:     def draw(self,rng):
  64:         cs=self.cl_sorted[self.slot_start+(rng.random_sample(self.C)*self.slot_n).astype(int)]
  65:         L=self.counts[cs]; tot=int(L.sum())
  66:         return self.members[np.repeat(self.offs[cs],L)+np.arange(tot)-np.repeat(np.concatenate([[0],np.cumsum(L)])[:-1],L)]
