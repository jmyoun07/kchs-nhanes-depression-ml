 211: # ---------------------------------------------------------------- 요약 비교
 212: BIN = ["employed", "alcohol_freq", "alcohol_qty", "binge", "welfare", "welfare_12mo", "food_insecure"]
 213: CON = ["oral_health", "sleep_weekend", "alcohol_qty_drinks"]
 214: def stats(df, v):
 215:     s = pd.to_numeric(df[v], errors="coerce"); w = pd.to_numeric(df["W"], errors="coerce")
 216:     ok = s.notna() & w.notna() & (w > 0)
 217:     val = np.nan if ok.sum() == 0 else float(np.average(s[ok], weights=w[ok]))
 218:     return dict(miss=float(s.isna().mean() * 100), val=val, unw=float(s.mean()) if s.notna().any() else np.nan,
 219:                 n=int(s.notna().sum()))
 220: rows = []
 221: for v in BIN + CON:
 222:     k, p1, p2 = stats(kout, v), stats(outs["pre"], v), stats(outs["post"], v)
 223:     nh = np.nanmean([p1["val"], p2["val"]])
 224:     if v in BIN:
 225:         lo, hi = min(k["val"], nh), max(k["val"], nh)
 226:         ratio = hi / lo if lo and lo > 0 else np.inf
 227:         match = "good" if ratio < 1.5 else ("fair" if ratio < 2.0 else "poor")
 228:     else:
 229:         ratio = abs(k["val"] - nh) / nh if nh else np.inf
 230:         match = "good" if ratio < 0.10 else ("fair" if ratio < 0.25 else "poor")
 231:     rows.append(dict(var=v, kind="binary" if v in BIN else "cont",
 232:                      kchs=k["val"], pre=p1["val"], post=p2["val"],
 233:                      kchs_miss=k["miss"], pre_miss=p1["miss"], post_miss=p2["miss"],
 234:                      kchs_n=k["n"], pre_n=p1["n"], post_n=p2["n"],
 235:                      ratio=ratio, match=match))
 236: summ = pd.DataFrame(rows)
 237: pd.set_option("display.width", 250)
 238: qc("\n=== 가중 유병률/평균 비교 (binary=비율, cont=평균) ===")
 239: qc(summ.to_string(index=False, float_format=lambda x: f"{x:.4f}"))
 240: summ.to_csv(os.path.join(RES, "ext_candidate_distributions.csv"), index=False, encoding="utf-8-sig")
 241: 
 242: # ---- 전이 가능성 진단: 변수↔우울 관계가 양국에서 같은 방향·유사 강도인가 (concept shift 검사)
 243: def wm(s, w):
 244:     ok = s.notna() & w.notna() & (w > 0)
 245:     return float(np.average(s[ok], weights=w[ok])) if ok.sum() else np.nan
 246: def logor(df, v):
 247:     """가중 로그오즈비(이진) 또는 SD당 로그오즈비 근사(연속). 부호·크기 비교용."""
 248:     d, w, x = df["dep"], df["W"], pd.to_numeric(df[v], errors="coerce")
 249:     ok = d.notna() & w.notna() & (w > 0) & x.notna()
 250:     if ok.sum() < 50: return np.nan
 251:     d, w, x = d[ok], w[ok], x[ok]
 252:     if v in BIN:
 253:         p1, p0 = wm(d.where(x == 1), w), wm(d.where(x == 0), w)
 254:         if not (0 < p1 < 1 and 0 < p0 < 1): return np.nan
 255:         return float(np.log((p1 / (1 - p1)) / (p0 / (1 - p0))))
 256:     # 연속: 가중 최소제곱 로지스틱 대신 표준화 후 단순 로지스틱 1스텝(부호/스케일 비교 목적)
 257:     z = (x - np.average(x, weights=w)) / (np.sqrt(np.average((x - np.average(x, weights=w)) ** 2, weights=w)) or 1)
 258:     hi, lo = wm(d.where(z >= 0.5), w), wm(d.where(z <= -0.5), w)
 259:     if not (0 < hi < 1 and 0 < lo < 1): return np.nan
 260:     return float(np.log((hi / (1 - hi)) / (lo / (1 - lo))))
 261: tr = []
 262: for v in BIN + CON:
