  12: except Exception: pass
  13: ROOT = r"C:/Users/rudtn/Desktop/claude code/지역사회건강"
  14: KB = os.path.join(ROOT, "data/raw/kchs"); NB = os.path.join(ROOT, "data/raw/nhanes")
