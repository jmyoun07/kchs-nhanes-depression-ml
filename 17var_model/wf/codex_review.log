  54:         header = split_row(ln); body = []
  55:         i += 2
  56:         while i < len(lines) and lines[i].lstrip().startswith("|"):
  57:             body.append(split_row(lines[i])); i += 1
  58:         t = doc.add_table(rows=1, cols=len(header)); t.style = "Table Grid"
  59:         for c, txt in zip(t.rows[0].cells, header):
  60:             c.paragraphs[0].text = ""; add_runs(c.paragraphs[0], txt)
  61:             for r in c.paragraphs[0].runs: r.bold = True; r.font.size = Pt(9)
  62:         for row in body:
  63:             cells = t.add_row().cells
  64:             for c, txt in zip(cells, row + [""] * (len(header) - len(row))):
  65:                 c.paragraphs[0].text = ""; add_runs(c.paragraphs[0], txt)
  66:                 for r in c.paragraphs[0].runs: r.font.size = Pt(9)
  67:         doc.add_paragraph()
  68:         continue
