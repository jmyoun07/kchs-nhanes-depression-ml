  27: DEV_YEARS = list(range(2017, 2026))
  28: PHQ_K = [f"mtb_07{c}1" for c in "abcdefghi"]
  29: # 개념 → (우선 시도 변수명, 라벨 정규식 대체탐색)
  30: C = {
  31:  "age": (["age"], r"만나이|연령"), "sex": (["sex"], r"^성별$"),
  32:  "edu": (["sob_01z1"], r"교육\s*수준"),
  33:  "income": (["fma_14z1", "fma_13z1"], r"가구소득.*금액|월.*소득|가구.*소득"),
  34:  "marital": (["sod_02z3"], r"결혼\s*상태|혼인|배우자"),
  35:  "hh": (["mbhld_co"], r"총가구원수|가구원\s*수|세대원\s*수"),
  36:  "smk": (["sma_03z2"], r"현재흡연.*여부"),
  37:  "alc_ever": (["dra_01z1"], r"평생\s*음주\s*여부"), "alc_freq": (["drb_01z3"], r"연간\s*음주\s*빈도"),
  38:  "pa_vd": (["pha_04z1"], r"격렬.*신체활동\s*일수"), "pa_vh": (["pha_05z1"], r"격렬.*시간\(시\)"), "pa_vm": (["pha_06z1"], r"격렬.*시간\(분\)"),
  39:  "pa_md": (["pha_07z1"], r"중등도.*신체활동\s*일수"), "pa_mh": (["pha_08z1"], r"중등도.*시간\(시\)"), "pa_mm": (["pha_09z1"], r"중등도.*시간\(분\)"),
  40:  "pa_wd": (["phb_01z1"], r"걷기.*실천\s*일수"),
  41:  "slp_wd": (["mtc_17z1", "mtc_01z1"], r"평균\s*수면시간.*주중|^수면시간$"), "slp_we": (["mtc_18z1"], r"평균\s*수면시간.*주말"),
  42:  "bmi": (["oba_bmi"], r"BMI\(자가보고\)"), "ht": (["oba_02z1"], r"^키$"), "wtkg": (["oba_03z1"], r"몸무게"),
  43:  "srh": (["qoa_01z1"], r"주관적\s*건강수준"), "stress": (["mta_01z1"], r"주관적\s*스트레스\s*수준"),
  44:  "htn": (["hya_04z1"], r"고혈압\s*진단\s*경험"), "dm": (["dia_04z1"], r"당뇨병\s*진단\s*경험"),
  45:  "strata": (["kstrata"], r"층화"), "wt": (["wt_p"], r"개인가중치|개인\s*가중"), "psu": (["SPOT_NO"], r"표본지점"),
  46: }
  47: 
  48: def resolve(names, rx, n2l, avail):
  49:     for n in names:
  50:         if n in avail: return n
  51:     r = re.compile(rx)
  52:     for n, l in n2l.items():
  53:         if l and r.search(l): return n
  54:     return None
