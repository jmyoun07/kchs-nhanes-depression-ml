  18: def wl(p):
  19:     p = os.path.abspath(p).replace("/", "\\"); return "\\\\?\\" + p if not p.startswith("\\\\?\\") else p
  20: def clean(s, miss=(), lo=None, hi=None):
  21:     s = pd.to_numeric(s, errors="coerce")
  22:     if miss: s = s.mask(s.isin(list(miss)))
  23:     if lo is not None: s = s.mask(s < lo)
  24:     if hi is not None: s = s.mask(s > hi)
  25:     return s
