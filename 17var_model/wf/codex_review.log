import numpy as np, pandas as pd
from sklearn.model_selection import train_test_split, StratifiedKFold
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import roc_auc_score, roc_curve
import lightgbm as lgb
D='.'; SEED=42
k=pd.read_parquet('data/ext_kchs.parquet'); pre=pd.read_parquet('data/ext_pre.parquet'); post=pd.read_parquet('data/ext_post.parquet')
NUM=['age','sleep_hrs','bmi','income_q','srh','oral_health']; BIN=['partnered','living_alone','current_drinker','active','htn','dm','employed','food_insecure']; CAT=['sex','edu','smoking']; FE=NUM+BIN+CAT
y=k.dep.astype(int).to_numpy(); tr,ho=train_test_split(np.arange(len(k)),train_size=500000,test_size=100000,stratify=y,random_state=SEED)
ct=ColumnTransformer([('num',Pipeline([('i',SimpleImputer(strategy='median')),('s',StandardScaler())]),NUM),('bin','passthrough',BIN),('cat',Pipeline([('i',SimpleImputer(strategy='most_frequent')),('o',OneHotEncoder(handle_unknown='ignore',drop='first'))]),CAT)])
pars=dict(num_leaves=31,min_child_samples=1000,learning_rate=.01,n_estimators=900,reg_alpha=1.,reg_lambda=20.,subsample=.6,colsample_bytree=.6,random_state=42,n_jobs=-1,verbose=-1)
m=Pipeline([('pre',ct),('clf',lgb.LGBMClassifier(**pars))]).fit(k.iloc[tr][FE],y[tr])
def pred(d): return m.predict_proba(d[FE])[:,1]
def ece(d,p,bins=10):
 y=d.dep.astype(int).to_numpy(); w=d.W.to_numpy(float); edges=np.quantile(p,np.linspace(0,1,bins+1)); edges[-1]+=1e-9; ix=np.digitize(p,edges[1:-1]); return sum(w[ix==b].sum()/w.sum()*abs(np.average(p[ix==b],weights=w[ix==b])-np.average(y[ix==b],weights=w[ix==b])) for b in range(bins) if (ix==b).any())
def op(y,p,w,t):
 q=p>=t; tp=w[q&(y==1)].sum(); fp=w[q&(y==0)].sum(); tn=w[(~q)&(y==0)].sum(); fn=w[(~q)&(y==1)].sum(); return tp/(tp+fn),tn/(tn+fp),tp/(tp+fp),tn/(tn+fn)
def crossfit(y,p,w):
 lp=np.log(np.clip(p,1e-6,1-1e-6)/(1-np.clip(p,1e-6,1-1e-6))); out=np.zeros_like(p)
 for a,b in StratifiedKFold(5,shuffle=True,random_state=42).split(lp,y):
  lr=LogisticRegression(penalty=None,solver='lbfgs').fit(lp[a,None],y[a],sample_weight=w[a]); out[b]=lr.predict_proba(lp[b,None])[:,1]
 return out
def apparent(y,p,w):
 lp=np.log(np.clip(p,1e-6,1-1e-6)/(1-np.clip(p,1e-6,1-1e-6))); lr=LogisticRegression(penalty=None,solver='lbfgs').fit(lp[:,None],y,sample_weight=w); return lr.predict_proba(lp[:,None])[:,1]
def nb(y,p,w,pt):
 q=p>=pt; return w[q&(y==1)].sum()/w.sum()-w[q&(y==0)].sum()/w.sum()*pt/(1-pt)
print('SPLIT EVENTS',y[tr].sum(),y[ho].sum(),'rates',y[tr].mean(),y[ho].mean())
print('MISSING KCHS', {c:round(k[c].isna().mean()*100,4) for c in ['food_insecure','sleep_hrs','bmi']})
for name,d in [('Internal',k.iloc[ho]),('pre',pre),('post',post)]:
 p=pred(d); yy=d.dep.astype(int).to_numpy(); w=d.W.to_numpy(float)
 fpr,tpr,th=roc_curve(yy,p,sample_weight=w); j=tpr-fpr; z=np.argmax(j); exact_t=th[z]
 grid=np.arange(.02,.60001,.01); jt=max(grid,key=lambda t:sum(op(yy,p,w,t)[:2])-1)
 print(name,'auc',roc_auc_score(yy,p,sample_weight=w),'ECE',ece(d,p),'exactYouden_t',exact_t,'exact_op',op(yy,p,w,exact_t),'grid_t',jt,'grid_op',op(yy,p,w,jt))
 pa=apparent(yy,p,w); pc=crossfit(yy,p,w)
 for pt in [.10,.15]: print(name,'pt',pt,'NB_apparent',nb(yy,pa,w,pt),'NB_crossfit',nb(yy,pc,w,pt),'flag_app',np.average(pa>=pt,weights=w),'flag_cf',np.average(pc>=pt,weights=w))
# subgroup calibration slopes, exactly as script
Dho=k.iloc[ho].copy(); Dho['_p']=pred(Dho)
for lab,mask in [('female',Dho.sex=='F'),('male',Dho.sex=='M'),('20-39',pd.to_numeric(Dho.age)<40),('60+',pd.to_numeric(Dho.age)>=60)]:
 dd=Dho[mask]; pp=dd._p.to_numpy(); lp=np.log(np.clip(pp,1e-6,1-1e-6)/(1-np.clip(pp,1e-6,1-1e-6))); lr=LogisticRegression(penalty=None).fit(lp[:,None],dd.dep.astype(int),sample_weight=dd.W); print('slope',lab,lr.coef_[0,0])
# weighted prevalences cutoff5
for name,d in [('internal',k.iloc[ho]),('pre',pre),('post',post)]: print('prev5',name,np.average(pd.to_numeric(d.phq_sum)>=5,weights=d.W))
