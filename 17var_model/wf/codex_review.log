  30:     return yv.astype(float),p,w.astype(float)
  31: def sens_at(yv,p,w,target):
  32:     # 양성자 점수의 가중 분위로 목표 민감도 임계 찾기
  33:     pos=yv==1; order=np.argsort(-p[pos]); wp=w[pos][order]; cum=np.cumsum(wp)/wp.sum()
  34:     k=int(np.searchsorted(cum,target)); k=min(k,len(order)-1)
  35:     return p[pos][order][k]
  36: def metrics(yv,p,w,t):
  37:     P=w[(yv==1)&(p>=t)].sum(); FN=w[(yv==1)&(p<t)].sum(); FP=w[(yv==0)&(p>=t)].sum(); TN=w[(yv==0)&(p<t)].sum()
  38:     sens=P/(P+FN) if P+FN>0 else 0; spec=TN/(TN+FP) if TN+FP>0 else 0
  39:     ppv=P/(P+FP) if P+FP>0 else 0; npv=TN/(TN+FN) if TN+FN>0 else 0
  40:     flag=(P+FP)/w.sum(); nns=1/ppv if ppv>0 else np.nan
  41:     return sens,spec,ppv,npv,flag,nns
  42: def recalib(p_ho_dummy, p_ext, yv, w):
  43:     # Platt: KCHS는 자체, 외부는 자체 라벨로 intercept/slope (배포 지역재보정)
  44:     lp=np.log(np.clip(p_ext,1e-6,1-1e-6)/(1-np.clip(p_ext,1e-6,1-1e-6))).reshape(-1,1)
  45:     lr=LogisticRegression(penalty=None).fit(lp,yv,sample_weight=w)
  46:     return lr.predict_proba(lp)[:,1]
  47: 
