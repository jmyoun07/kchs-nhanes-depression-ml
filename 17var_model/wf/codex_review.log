  54: # ??????????????????????????????????????????????????????????????????
  55: # B3. 정식 CITL ? slope 고정(offset) vs 기존(slope 자유추정 절편)
  56: # ??????????????????????????????????????????????????????????????????
  57: def logit(p): p = np.clip(p, 1e-6, 1-1e-6); return np.log(p/(1-p))
  58: 
  59: def cal_slope_intercept(yv, p, w):
  60:     """slope·intercept 동시 추정 (기존 방식). 절편은 'calibration intercept'."""
  61:     c = LogisticRegression(penalty=None, solver="lbfgs").fit(logit(p).reshape(-1,1), yv, sample_weight=w)
  62:     return float(c.coef_[0,0]), float(c.intercept_[0])
  63: 
  64: def citl_offset(yv, p, w):
  65:     """정식 CITL: 선형예측자를 offset으로 고정(slope=1)한 절편만 추정."""
  66:     lp = logit(p)
  67:     # offset 로지스틱: logit(pi) = a + lp  →  뉴턴-랩슨으로 a 추정
  68:     a = 0.0
  69:     for _ in range(200):
  70:         eta = a + lp; mu = 1/(1+np.exp(-eta))
  71:         g = np.sum(w*(yv-mu)); h = np.sum(w*mu*(1-mu))
  72:         if h <= 0: break
  73:         step = g/h; a += step
  74:         if abs(step) < 1e-10: break
  75:     return float(a)
  76: 
  77: print("\n" + "="*78); print("[B3] CITL 재계산 ? 정식(offset, slope=1 고정) vs 기존(slope 자유추정 절편)"); print("="*78, flush=True)
  78: def recalib_cv(yv, p, w):
  79:     """5-fold 교차적합 절편/기울기 재보정 (기존 파이프라인과 동일)."""
  80:     lp = logit(p); oof = np.zeros_like(p)
  81:     for tri, tei in StratifiedKFold(5, shuffle=True, random_state=SEED).split(lp, yv):
  82:         c = LogisticRegression(penalty=None, solver="lbfgs").fit(lp[tri].reshape(-1,1), yv[tri], sample_weight=w[tri])
  83:         oof[tei] = c.predict_proba(lp[tei].reshape(-1,1))[:,1]
  84:     return oof
