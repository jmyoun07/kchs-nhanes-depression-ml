===== 46_review_fixes.py =====
   1: # -*- coding: utf-8 -*-
   2: """46_review_fixes.py ? 2차 리뷰 지적사항 근거 산출.
   3: 
   4: (1) 하위군 보정 slope를 파일로 저장(기존엔 콘솔 출력만 → 추적 불가)
   5: (2) 하위군 AUROC에 층별 군집 부트스트랩 CI 부여(§3.8이 CI 없이 "wide CIs"라고만 서술)
   6: (3) NHANES 자기적합 오라클을 학습기별로 재산출 + 부트스트랩 CI(§3.5의 "0.765?0.775", "CI ?0.75?0.79" 출처 부재)
   7: 
   8: 출력: results/subgroup_calibration.csv, results/fairness_ci.csv, results/oracle_ci.csv
   9: """
  10: import sys, warnings, numpy as np, pandas as pd
  11: sys.stdout.reconfigure(encoding="utf-8"); warnings.filterwarnings("ignore")
  12: from sklearn.model_selection import train_test_split, StratifiedKFold
  13: from sklearn.compose import ColumnTransformer
  14: from sklearn.pipeline import Pipeline
  15: from sklearn.impute import SimpleImputer
  16: from sklearn.preprocessing import StandardScaler, OneHotEncoder
  17: from sklearn.linear_model import LogisticRegression
  18: from sklearn.ensemble import HistGradientBoostingClassifier
  19: from sklearn.metrics import roc_auc_score
  20: import lightgbm as lgb
  21: 
  22: D = r"C:/Users/rudtn/Desktop/claude code/지역사회건강/17var_model"; RES = f"{D}/results"; SEED = 42
  23: kchs = pd.read_parquet(f"{D}/data/ext_kchs.parquet"); pre = pd.read_parquet(f"{D}/data/ext_pre.parquet"); post = pd.read_parquet(f"{D}/data/ext_post.parquet")
  24: NUM = ["age","sleep_hrs","bmi","income_q","srh","oral_health"]
  25: BIN = ["partnered","living_alone","current_drinker","active","htn","dm","employed","food_insecure"]
  26: CAT = ["sex","edu","smoking"]; FE = NUM+BIN+CAT
  27: y = kchs["dep"].astype(int).values
  28: LGB = dict(num_leaves=31, min_child_samples=1000, learning_rate=0.01, n_estimators=900, reg_alpha=1.0,
  29:            reg_lambda=20.0, subsample=0.6, colsample_bytree=0.6, random_state=SEED, n_jobs=-1, verbose=-1)
  30: def make_ct(NU=NUM, BI=BIN, CA=CAT, native=True):
  31:     t = [("num", Pipeline([("i", SimpleImputer(strategy="median")), ("s", StandardScaler())]), NU),
  32:          ("bin", "passthrough" if native else SimpleImputer(strategy="most_frequent"), BI),
  33:          ("cat", Pipeline([("i", SimpleImputer(strategy="most_frequent")), ("o", OneHotEncoder(handle_unknown="ignore", drop="first"))]), CA)]
  34:     return ColumnTransformer(t)
  35: 
  36: class ClusterBoot:
  37:     """층 내 PSU 복원추출(Rao-Wu)."""
  38:     def __init__(self, strata, psu):
  39:         cl = pd.factorize(pd.Series(strata).astype(str)+"|"+pd.Series(psu).astype(str))[0]
  40:         st = pd.factorize(pd.Series(strata).astype(str))[0]
  41:         o = np.argsort(cl, kind="stable"); self.members = o
  42:         self.counts = np.bincount(cl); self.offs = np.concatenate([[0], np.cumsum(self.counts)])
  43:         first = np.zeros(len(self.counts), dtype=int); first[cl[o]] = st[o]
  44:         o2 = np.argsort(first, kind="stable"); self.cl_sorted = o2
  45:         sc = np.bincount(first[o2]); start = np.concatenate([[0], np.cumsum(sc)])[:-1]
  46:         self.slot_start = start[first[o2]]; self.slot_n = sc[first[o2]]; self.C = len(self.counts)
  47:     def draw(self, rng):
  48:         cs = self.cl_sorted[self.slot_start + (rng.random_sample(self.C)*self.slot_n).astype(int)]
  49:         L = self.counts[cs]; tot = int(L.sum())
  50:         return self.members[np.repeat(self.offs[cs], L) + np.arange(tot) - np.repeat(np.concatenate([[0], np.cumsum(L)])[:-1], L)]
  51: 
  52: def auc_ci(d, p, B=1000):
  53:     yv = d["dep"].astype(int).values; w = d["W"].to_numpy(float)
  54:     cb = ClusterBoot(d["strata"].values, d["psu"].values); rng = np.random.RandomState(SEED); a = []
  55:     for _ in range(B):
  56:         ii = cb.draw(rng)
  57:         try: a.append(roc_auc_score(yv[ii], p[ii], sample_weight=w[ii]))
  58:         except Exception: pass
  59:     a = np.array(a); return float(np.percentile(a, 2.5)), float(np.percentile(a, 97.5))
  60: 
  61: def cal_slope(yv, p, w):
  62:     p = np.clip(p, 1e-6, 1-1e-6); lp = np.log(p/(1-p)).reshape(-1,1)
  63:     return float(LogisticRegression(penalty=None, solver="lbfgs").fit(lp, yv, sample_weight=w).coef_[0,0])
  64: 
  65: tr, ho = train_test_split(np.arange(len(kchs)), train_size=500000, test_size=100000, stratify=y, random_state=SEED)
  66: model = Pipeline([("pre", make_ct()), ("clf", lgb.LGBMClassifier(**LGB))]).fit(kchs.iloc[tr][FE], y[tr])
  67: dho = kchs.iloc[ho].copy(); dho["_p"] = model.predict_proba(dho[FE])[:,1]
  68: prd = pre.copy(); prd["_p"] = model.predict_proba(pre[FE])[:,1]
  69: age = pd.to_numeric(dho["age"])
  70: 
  71: # ?????????? (1)(2) 하위군: 보정 slope + AUROC CI ??????????
  72: print("="*82); print("[1-2] 하위군 보정 slope + AUROC 층별 군집 부트스트랩 CI"); print("="*82, flush=True)
  73: groups = [("Sex: female", dho, dho["sex"]=="F"), ("Sex: male", dho, dho["sex"]=="M"),
  74:           ("Age 20-39", dho, age<40), ("Age 40-59", dho, (age>=40)&(age<60)), ("Age 60+", dho, age>=60),
  75:           ("Education: college", dho, dho["edu"]=="college"), ("Education: high school", dho, dho["edu"]=="high"),
  76:           ("Education: middle", dho, dho["edu"]=="middle"), ("Education: <=elementary", dho, dho["edu"]=="elem_low")]
  77: RACE = {1:"Mexican American", 2:"Other Hispanic", 3:"Non-Hispanic White", 4:"Non-Hispanic Black", 6:"Non-Hispanic Asian", 7:"Other/multiracial"}
  78: for code, lab in RACE.items():
  79:     groups.append((f"NHANES pre race: {lab}", prd, prd["race"]==code))
  80: rows = []
  81: for lab, src, mask in groups:
  82:     dd = src[mask]
  83:     if dd["dep"].nunique() < 2 or len(dd) < 100: continue
  84:     yv = dd["dep"].astype(int).values; w = dd["W"].to_numpy(float); p = dd["_p"].values
  85:     a = roc_auc_score(yv, p, sample_weight=w); lo, hi = auc_ci(dd, p, B=1000)
  86:     sl = cal_slope(yv, p, w)
  87:     cohort = "KCHS hold-out" if src is dho else "NHANES pre"
  88:     print(f"  {lab:<32} n={len(dd):>6,}  AUROC {a:.3f} [{lo:.3f},{hi:.3f}]  slope {sl:.3f}", flush=True)
  89:     rows.append(dict(cohort=cohort, subgroup=lab, n=len(dd), AUROC=round(a,3), CI_lo=round(lo,3), CI_hi=round(hi,3), cal_slope=round(sl,3)))
  90: sub = pd.DataFrame(rows)
  91: sub.to_csv(f"{RES}/fairness_ci.csv", index=False, encoding="utf-8-sig")
  92: sub[sub.cohort=="KCHS hold-out"][["subgroup","n","cal_slope"]].to_csv(f"{RES}/subgroup_calibration.csv", index=False, encoding="utf-8-sig")
  93: 
  94: # ?????????? (3) NHANES 자기적합 오라클: 학습기별 + 부트스트랩 CI ??????????
  95: print("\n" + "="*82); print("[3] NHANES 자기적합 오라클(진단 목적) ? 학습기별 5-fold CV + 부트스트랩 CI"); print("="*82, flush=True)
  96: pooled = pd.concat([pre.assign(_period="pre"), post.assign(_period="post")], ignore_index=True)
  97: pooled["strata"] = pooled["_period"].astype(str) + "|" + pooled["strata"].astype(str)   # 주기별 설계 분리
  98: yo = pooled["dep"].astype(int).values; Wo = pooled["W"].to_numpy(float)
  99: LEARNERS = {
 100:     "Logistic regression": lambda: Pipeline([("pre", make_ct(native=False)), ("clf", LogisticRegression(max_iter=2000))]),
 101:     "Penalized logistic (L2, C=0.1)": lambda: Pipeline([("pre", make_ct(native=False)), ("clf", LogisticRegression(C=0.1, max_iter=2000))]),
 102:     "Histogram gradient boosting": lambda: Pipeline([("pre", make_ct()), ("clf", HistGradientBoostingClassifier(random_state=SEED, max_iter=300, learning_rate=0.05))]),
 103:     "LightGBM (small)": lambda: Pipeline([("pre", make_ct()), ("clf", lgb.LGBMClassifier(random_state=SEED, n_jobs=-1, verbose=-1, num_leaves=7, min_child_samples=200, learning_rate=0.05, n_estimators=300))]),
 104: }
 105: orows = []; best_oof = None; best_auc = -1
 106: skf = StratifiedKFold(5, shuffle=True, random_state=SEED)
 107: for nm, mk in LEARNERS.items():
 108:     oof = np.zeros(len(pooled))
 109:     for tri, tei in skf.split(pooled[FE], yo):
 110:         m = mk().fit(pooled.iloc[tri][FE], yo[tri])
 111:         oof[tei] = m.predict_proba(pooled.iloc[tei][FE])[:,1]
 112:     a = roc_auc_score(yo, oof, sample_weight=Wo)
 113:     lo, hi = auc_ci(pooled, oof, B=1000)
 114:     print(f"  {nm:<34} oracle AUROC {a:.4f}  95% CI [{lo:.3f},{hi:.3f}]", flush=True)
 115:     orows.append(dict(learner=nm, oracle_AUROC=round(a,4), CI_lo=round(lo,3), CI_hi=round(hi,3)))
 116:     if a > best_auc: best_auc, best_oof = a, oof
 117: ap = LEARNERS["LightGBM (small)"]().fit(pooled[FE], yo)
 118: appar = roc_auc_score(yo, ap.predict_proba(pooled[FE])[:,1], sample_weight=Wo)
 119: orows.append(dict(learner="In-sample (apparent) upper bound", oracle_AUROC=round(appar,4), CI_lo=None, CI_hi=None))
 120: print(f"  {'In-sample (apparent) upper bound':<34} {appar:.4f}", flush=True)
 121: pd.DataFrame(orows).to_csv(f"{RES}/oracle_ci.csv", index=False, encoding="utf-8-sig")
 122: lo_b, hi_b = auc_ci(pooled, best_oof, B=1000)
 123: print(f"\n  → 학습기별 오라클 범위 {min(r['oracle_AUROC'] for r in orows[:-1]):.3f}?{max(r['oracle_AUROC'] for r in orows[:-1]):.3f} · 최고 학습기 CI [{lo_b:.3f},{hi_b:.3f}]", flush=True)
 124: print("\n저장: results/fairness_ci.csv, subgroup_calibration.csv, oracle_ci.csv\n완료.", flush=True)

