 106: def pa_nhanes_pre(m):
 107:     def c(x): return clean(m.get(x), (7, 9, 7777, 9999, 77, 99))
 108:     vig = np.where(c("PAQ650") == 1, c("PAQ655").fillna(0) * c("PAD660").fillna(0), 0)
 109:     mod = np.where(c("PAQ665") == 1, c("PAQ670").fillna(0) * c("PAD675").fillna(0), 0)
 110:     meets = (mod >= 150) | (vig >= 75)
 111:     any_pa = c("PAQ650").notna() | c("PAQ665").notna()
 112:     return pd.Series(np.where(any_pa, meets.astype(float), np.nan), index=m.index)
 113: 
 114: def pa_nhanes_post(m):
 115:     def c(x): return clean(m.get(x), (7, 9, 7777, 9999))
 116:     def unit_factor(s):
 117:         """[버그수정#2] PAQ_L의 PAD790U/PAD810U는 **문자형**('D','W','M','Y').
 118:         기존 코드는 pd.to_numeric으로 파싱해 전량 NaN→fillna(0)→post 신체활동 100% '0분'(전원 비활동)이 됐다.
 119:         문자 코드를 주당 환산계수로 직접 매핑한다. 숫자 코드(1~4)로 오는 경우도 함께 허용."""
 120:         u = m.get(s)
 121:         if u is None: return pd.Series(np.nan, index=m.index)
 122:         us = pd.Series(u, index=m.index).astype(str).str.strip().str.upper()
 123:         fac = us.map({"D": 7.0, "W": 1.0, "M": 1 / 4.3, "Y": 1 / 52,
 124:                       "1": 7.0, "2": 1.0, "3": 1 / 4.3, "4": 1 / 52})
 125:         return pd.to_numeric(fac, errors="coerce")
 126:     def wk(qs, us, ms):
 127:         q = c(qs); mn = c(ms); f = unit_factor(us)
 128:         return q * f * mn   # (빈도 × 주당환산) × 1회 분 = 주당 분
 129:     mod = wk("PAD790Q", "PAD790U", "PAD800"); vig = wk("PAD810Q", "PAD810U", "PAD820")
 130:     meets = (mod.fillna(0) >= 150) | (vig.fillna(0) >= 75)
 131:     any_pa = c("PAD790Q").notna() | c("PAD810Q").notna()
 132:     return pd.Series(np.where(any_pa, meets.astype(float), np.nan), index=m.index)
