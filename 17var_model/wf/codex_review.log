  48:     print(f"  {nm}: 14변수={a14:.4f} → 17변수={a17:.4f}  Δ={dd:+.4f}  95%CI[{lo:+.4f},{hi:+.4f}]  p?{pval:.4f}  P(Δ>0)={pgt:.3f}  → {sig}")
  49:     rows.append((nm,round(a14,4),round(a17,4),round(dd,4),round(lo,4),round(hi,4),round(pval,4),sig))
  50: pd.DataFrame(rows,columns=["set","AUROC_14","AUROC_17","delta","CI_lo","CI_hi","p","verdict"]).to_csv(f"{D}/results/gain_14to17_bootstrap.csv",index=False,encoding="utf-8-sig")
