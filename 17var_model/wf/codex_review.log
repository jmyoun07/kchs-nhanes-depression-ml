 266:     rat = abs(lnh) / abs(lk) if lk and abs(lk) > 1e-9 else np.nan
 267:     tr.append(dict(var=v, logOR_kchs=lk, logOR_pre=lp, logOR_post=lq,
 268:                    same_direction=bool(same), strength_ratio_nh_over_kchs=rat))
