  30: def boot_diff(d,B=2000):
  31:     yv=d["dep"].astype(int).values; w=d["W"].to_numpy(float)
  32:     p17=P(c17,m17,fe17,d); p14=P(c14,m14,fe14,d)
  33:     a17=roc_auc_score(yv,p17,sample_weight=w); a14=roc_auc_score(yv,p14,sample_weight=w)
  34:     grp=(d["strata"].astype(str)+"|"+d["psu"].astype(str)).values; uid=pd.unique(grp)
  35:     idx={u:np.where(grp==u)[0] for u in uid}; r=np.random.RandomState(SEED); diffs=[]
  36:     for _ in range(B):
  37:         ii=np.concatenate([idx[u] for u in r.choice(uid,len(uid),replace=True)])
  38:         try:
  39:             d17=roc_auc_score(yv[ii],p17[ii],sample_weight=w[ii]); d14=roc_auc_score(yv[ii],p14[ii],sample_weight=w[ii]); diffs.append(d17-d14)
  40:         except: pass
  41:     diffs=np.array(diffs); lo,hi=np.percentile(diffs,[2.5,97.5]); pval=2*min((diffs<=0).mean(),(diffs>=0).mean())
  42:     return a14,a17,a17-a14,lo,hi,pval,(diffs>0).mean()
  43: print("14→17 외부 AUROC 이득 (PSU군집 짝지음 부트스트랩, B=2000):\n")
  44: rows=[]
