 106: 
 107: class ClusterBoot:
 108:     """층별 군집 부트스트랩: 각 층 h에서 n_h개 PSU를 복원추출."""
 109:     def __init__(self, strata, psu):
 110:         cl = pd.factorize(pd.Series(strata).astype(str) + "|" + pd.Series(psu).astype(str))[0]
 111:         st = pd.factorize(pd.Series(strata).astype(str))[0]
 112:         order = np.argsort(cl, kind="stable")
 113:         self.members = order
 114:         counts = np.bincount(cl)
 115:         self.offs = np.concatenate([[0], np.cumsum(counts)])
 116:         self.counts = counts
 117:         # 군집별 소속 층
 118:         first = np.zeros(len(counts), dtype=int)
 119:         first[cl[order]] = st[order]
 120:         self.cl_stratum = first
 121:         # 층별 군집 범위(층 기준 정렬)
 122:         o2 = np.argsort(self.cl_stratum, kind="stable")
 123:         self.cl_sorted = o2                      # 층순 정렬된 군집 인덱스
 124:         s_sorted = self.cl_stratum[o2]
 125:         sc = np.bincount(s_sorted)
 126:         self.st_start = np.concatenate([[0], np.cumsum(sc)])[:-1]
 127:         self.st_n = sc
 128:         self.slot_start = self.st_start[s_sorted]  # 각 슬롯의 층 시작
 129:         self.slot_n = self.st_n[s_sorted]
 130:         self.C = len(counts)
 131: 
 132:     def draw(self, rng):
 133:         u = rng.random_sample(self.C)
 134:         pick = self.slot_start + (u*self.slot_n).astype(int)      # 층 내 균등 복원추출
 135:         cs = self.cl_sorted[pick]
 136:         L = self.counts[cs]; tot = int(L.sum())
 137:         starts = np.repeat(self.offs[cs], L)
 138:         run = np.arange(tot) - np.repeat(np.concatenate([[0], np.cumsum(L)])[:-1], L)
 139:         return self.members[starts + run]
 140: 
 141: def boot_ci(d, p, yv, w, fn, B=1000, stratified=True):
 142:     cb = ClusterBoot(d["strata"].values, d["psu"].values)
 143:     rng = np.random.RandomState(SEED); a = []
 144:     if stratified:
 145:         for _ in range(B):
 146:             ii = cb.draw(rng)
 147:             try: a.append(fn(yv[ii], p[ii], w[ii]))
 148:             except Exception: pass
 149:     else:
 150:         grp = (d["strata"].astype(str)+"|"+d["psu"].astype(str)).values
 151:         uid = pd.unique(grp); idx = {u: np.where(grp==u)[0] for u in uid}
 152:         for _ in range(B):
 153:             ii = np.concatenate([idx[u] for u in rng.choice(uid, len(uid), replace=True)])
 154:             try: a.append(fn(yv[ii], p[ii], w[ii]))
 155:             except Exception: pass
 156:     a = np.array(a); return float(np.percentile(a,2.5)), float(np.percentile(a,97.5))
