 137: class ClusterBoot:
 138:     def __init__(self, strata, psu):
 139:         cl = pd.factorize(pd.Series(strata).astype(str) + "|" + pd.Series(psu).astype(str))[0]
 140:         st = pd.factorize(pd.Series(strata).astype(str))[0]
 141:         order = np.argsort(cl, kind="stable"); self.members = order
 142:         counts = np.bincount(cl); self.counts = counts
 143:         self.offs = np.concatenate([[0], np.cumsum(counts)])
 144:         first = np.zeros(len(counts), dtype=int); first[cl[order]] = st[order]; self.cl_stratum = first
 145:         o2 = np.argsort(self.cl_stratum, kind="stable"); self.cl_sorted = o2
 146:         s_sorted = self.cl_stratum[o2]; sc = np.bincount(s_sorted)
 147:         self.st_start = np.concatenate([[0], np.cumsum(sc)])[:-1]; self.st_n = sc
 148:         self.slot_start = self.st_start[s_sorted]; self.slot_n = self.st_n[s_sorted]; self.C = len(counts)
 149:     def draw(self, rng):
 150:         u = rng.random_sample(self.C)
 151:         cs = self.cl_sorted[self.slot_start + (u*self.slot_n).astype(int)]
 152:         L = self.counts[cs]; tot = int(L.sum())
 153:         starts = np.repeat(self.offs[cs], L)
 154:         run = np.arange(tot) - np.repeat(np.concatenate([[0], np.cumsum(L)])[:-1], L)
 155:         return self.members[starts + run]
