 195: qc("\n=== NHANES 후보변수 추출 ===")
 196: outs = {}
 197: for per, pq in [("pre", "nhanes_pre"), ("post", "nhanes_post")]:
 198:     base = pd.read_parquet(os.path.join(PROC, f"{pq}.parquet"))
 199:     ne = build_nhanes(per)
 200:     qc(f"NHANES {per}: DEMO행={len(ne)} / 기존 parquet index max={base.index.max()} n={len(base)}")
 201:     al = ne.reindex(base.index)
 202:     a1, a2 = al["_age"].to_numpy(dtype=float), base["age"].to_numpy(dtype=float)
 203:     chk = np.mean((a1 == a2) | (np.isnan(a1) & np.isnan(a2)))
 204:     qc(f"NHANES {per} 정렬검증: age 일치율={chk:.6f}")
 205:     assert chk > 0.9999, f"NHANES {per} 정렬 검증 실패"
 206:     out = pd.concat([base, al[EXT]], axis=1)
 207:     out.to_parquet(os.path.join(PROC, f"ext_{per}.parquet"))
 208:     outs[per] = out
 209:     qc(f"저장: data/processed/ext_{per}.parquet {out.shape}")
