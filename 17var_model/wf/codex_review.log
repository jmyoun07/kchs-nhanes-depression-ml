 148: # ---------------------------------------------------------------- NHANES
 149: FOLD = {"pre": ("pre_2017_2020", lambda m: f"P_{m}.xpt"), "post": ("post_2021_2023", lambda m: f"{m}_L.xpt")}
 150: def build_nhanes(period):
 151:     folder, namer = FOLD[period]
 152:     def rd(mod, cols):
 153:         p = os.path.join(NB, folder, namer(mod))
 154:         df = pyreadstat.read_xport(p, usecols=["SEQN"] + cols, encoding="latin1")[0]
 155:         miss = [c for c in cols if c not in df.columns]
 156:         if miss: qc(f"  [!] [{period}/{mod}] 원자료 부재 컬럼: {miss}")
 157:         for c in miss: df[c] = np.nan
 158:         return df
 159:     demo = rd("DEMO", ["RIDAGEYR"])          # 기존 parquet index 복원 기준 (동일 파일·동일 순서)
 160:     m = demo.copy()
 161:     for mod, cols in [("OCQ", ["OCD150"]), ("OHQ", ["OHQ845"]),
 162:                       ("ALQ", ["ALQ111", "ALQ121", "ALQ130", "ALQ142"]),
 163:                       ("FSQ", ["FSQ165", "FSQ012", "FSD230", "FSDAD"]), ("SLQ", ["SLD013"])]:
 164:         m = m.merge(rd(mod, cols), on="SEQN", how="left")
 165:     o = pd.DataFrame(index=m.index); o["_age"] = m["RIDAGEYR"]
 166: 
 167:     ocd = clean(m["OCD150"], (7, 9))
 168:     o["employed"] = np.where(ocd.isin([1, 2]), 1.0, np.where(ocd.isin([3, 4]), 0.0, np.nan))
 169:     o["oral_health"] = clean(m["OHQ845"], (7, 9), 1, 5)
 170: 
 171:     a111 = clean(m["ALQ111"], (7, 9))          # 평생 12잔+ 음주 1=예 2=아니오
 172:     a121 = clean(m["ALQ121"], (77, 99))        # 0=연간 비음주, 1=매일 … 10=연1-2회
 173:     never = (a111 == 2)
 174:     # 주 2회 이상 = ALQ121 {1,2,3,4} (매일/거의매일/주3-4회/주2회). 5=주1회는 제외(KCHS 경계와 일치)
 175:     o["alcohol_freq"] = np.where(a121.isin([1, 2, 3, 4]), 1.0,
 176:                         np.where(a121.isin([0, 5, 6, 7, 8, 9, 10]) | never, 0.0, np.nan))
 177:     a130 = clean(m["ALQ130"], (777, 999), 1, 90)
 178:     nondrink = never | (a121 == 0)
 179:     o["alcohol_qty"] = np.where(a130.notna(), (a130 >= 5).astype(float), np.where(nondrink, 0.0, np.nan))
 180:     o["alcohol_qty_drinks"] = np.where(a130.notna(), a130, np.where(nondrink, 0.0, np.nan))
 181:     a142 = clean(m["ALQ142"], (77, 99))
 182:     o["binge"] = np.where(a142.isin([1, 2, 3, 4, 5, 6, 7]), 1.0,
 183:                  np.where(a142.isin([0, 8, 9, 10]) | nondrink, 0.0, np.nan))
 184: 
 185:     # SNAP: 스킵패턴 FSQ165(ever) → FSQ012(12개월) → FSD230(현재). KCHS '현재 수급자'와 맞추려면 FSD230.
 186:     f165, f012, f230 = clean(m["FSQ165"], (7, 9)), clean(m["FSQ012"], (7, 9)), clean(m["FSD230"], (7, 9))
 187:     o["welfare"] = np.where(f230 == 1, 1.0,
 188:                    np.where((f230 == 2) | (f012 == 2) | (f165 == 2), 0.0, np.nan))
 189:     o["welfare_12mo"] = np.where(f012 == 1, 1.0, np.where((f012 == 2) | (f165 == 2), 0.0, np.nan))
 190:     o["sleep_weekend"] = clean(m["SLD013"], (77, 99), 0, 24)
 191:     fd = clean(m["FSDAD"], (7, 9))
 192:     o["food_insecure"] = fd.isin([3, 4]).astype(float).where(fd.isin([1, 2, 3, 4]))
 193:     return o
