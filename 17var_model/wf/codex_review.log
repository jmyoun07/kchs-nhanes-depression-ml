  51:     sets={"Internal":(kchs.iloc[ho],), "NHANES pre":(pre,), "NHANES post":(post,)}
  52:     for nm,(d,) in sets.items():
  53:         p=m.predict_proba(c.transform(d[fe]))[:,1]; yv=d["dep"].astype(int).values; w=d["W"].astype(float).values
  54:         for target in [0.85,0.90]:
  55:             t=sens_at(yv,p,w,target); s,sp,ppv,npv,flag,nns=metrics(yv,p,w,t)
  56:             rows.append((tag,nm,f"sens?{target:.2f}",round(s,3),round(sp,3),round(ppv,3),round(npv,3),round(flag,3),round(nns,1)))
  57:         # 순편익(재보정 후) ? 외부만 재보정, 내부는 자체
  58:         pc=recalib(None,p,yv,w)
