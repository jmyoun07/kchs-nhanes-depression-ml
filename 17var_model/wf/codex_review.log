  56: def build_kchs_year(year):
  57:     dd = os.path.join(KB, str(year), "data")
  58:     f = [x for x in sorted(os.listdir(dd)) if x.lower().endswith(".sas7bdat") and "ctv" not in x.lower()][0]
  59:     path = os.path.join(dd, f)
  60:     _, meta = pyreadstat.read_sas7bdat(wl(path), metadataonly=True)
  61:     n2l = dict(zip(meta.column_names, meta.column_labels or [""] * len(meta.column_names))); A = set(meta.column_names)
  62:     pick = {k: resolve(v[0], v[1], n2l, A) for k, v in C.items()}
  63:     XW.append(f"{year}: " + ", ".join(f"{k}={pick[k]}" for k in ["income","marital","hh","slp_wd","bmi","ht","wt","psu","pa_md"]))
  64:     need = [v for v in pick.values() if v] + [c for c in PHQ_K if c in A]
  65:     df, _ = pyreadstat.read_sas7bdat(wl(path), usecols=list(dict.fromkeys(need)))
  66:     g = lambda k: df[pick[k]] if pick[k] and pick[k] in df.columns else pd.Series(np.nan, index=df.index)
  67:     o = pd.DataFrame(index=df.index); o["year"] = year
  68:     phq = df[[c for c in PHQ_K if c in df.columns]].apply(pd.to_numeric, errors="coerce").mask(lambda x: x.isin([7, 8, 9])) - 1
  69:     _pv = phq.to_numpy(); _pv = _pv[~np.isnan(_pv)]  # 코덱스 #8: 재코딩 범위 QC(1-4→0-3 가정 검증)
  70:     if _pv.size and not ((_pv >= 0) & (_pv <= 3)).all():
  71:         qc(f"[경고] KCHS {year} PHQ 재코딩 범위 이탈 min={_pv.min():.0f} max={_pv.max():.0f} ? 코딩 확인 필요")
  72:     comp = phq.notna().all(axis=1) & (phq.shape[1] == 9)
  73:     o["phq_sum"] = phq.sum(axis=1).where(comp); o["dep"] = (o["phq_sum"] >= 10).astype(float).where(comp)
  74:     o["age"] = clean(g("age"), lo=1, hi=120); o["sex"] = clean(g("sex")).map({1: "M", 2: "F"})
  75:     o["edu"] = clean(g("edu"), (77, 99)).map({1: "elem_low", 2: "elem_low", 3: "elem_low", 4: "middle", 5: "high", 6: "college", 7: "college", 8: "college"})
  76:     # [버그수정#3] 77777(응답거부) 누락 → 17,354건이 최상위 소득분위로 편입되던 결함. 7/9 계열 센티넬 전체 보강.
  77:     o["income_raw"] = clean(g("income"), (7777, 9999, 77777, 88888, 99999, 777777, 888888, 999999, 8888))
  78:     o["income_q"] = pd.qcut(o["income_raw"], 5, labels=False, duplicates="drop")  # 연도별 상대분위(척도 상이 보정)
  79:     o["partnered"] = clean(g("marital"), (7, 9)).map({1: 1, 2: 0, 3: 0, 4: 0, 5: 0})
  80:     hh = pd.to_numeric(g("hh"), errors="coerce"); o["living_alone"] = (hh == 1).astype(float).where(hh.notna())
  81:     o["smoking"] = clean(g("smk"), (7, 9)).map({1: "current", 2: "current", 3: "former", 8: "never"})
  82:     ae, af = clean(g("alc_ever"), (7, 9)), clean(g("alc_freq"), (7, 9))
  83:     o["current_drinker"] = np.where((ae == 1) & (af.between(1, 6)), 1.0, np.where(ae.notna(), 0.0, np.nan))
  84:     # 신체활동: 유산소 권장 충족(주당 중등도>=150분 or 격렬>=75분). 분 변수 없으면 일수 근사.
  85:     def mins(dv, hv, mv):
  86:         d = clean(g(dv), (77, 88, 99), lo=0, hi=7); h = clean(g(hv), (77, 88, 99), lo=0, hi=24); mm = clean(g(mv), (77, 88, 99), lo=0, hi=60)
  87:         dur = np.where(h.notna() | mm.notna(), h.fillna(0) * 60 + mm.fillna(0), np.nan)  # 지속시간 완전결측→NaN(0 아님)
  88:         return d * pd.Series(dur, index=d.index)
  89:     vig = mins("pa_vd", "pa_vh", "pa_vm"); mod = mins("pa_md", "pa_mh", "pa_mm")
  90:     meets = (mod >= 150) | (vig >= 75)
  91:     if pick["pa_mh"] is None:  # 분 없으면 일수 근사
  92:         vd = clean(g("pa_vd"), (77, 88, 99), lo=0, hi=7); md = clean(g("pa_md"), (77, 88, 99), lo=0, hi=7); wd = clean(g("pa_wd"), (77, 88, 99), lo=0, hi=7)
  93:         meets = (md >= 5) | (vd >= 3) | (wd >= 5); any_pa = md.notna() | vd.notna() | wd.notna()
  94:     else:
  95:         any_pa = clean(g("pa_md"), (88, 99)).notna() | clean(g("pa_vd"), (88, 99)).notna()
  96:     o["active"] = meets.astype(float).where(any_pa)
  97:     swd = clean(g("slp_wd"), (88, 99), 0, 24); swe = clean(g("slp_we"), (88, 99), 0, 24)
  98:     o["sleep_hrs"] = np.where(swe.notna() & swd.notna(), (5 * swd + 2 * swe) / 7, swd)
  99:     bmi = clean(g("bmi"), lo=10, hi=70); ht = clean(g("ht"), lo=100, hi=220); wt = clean(g("wtkg"), lo=20, hi=250)
 100:     comp_b = wt / (ht / 100) ** 2; o["bmi"] = bmi.where(bmi.notna(), comp_b.where((comp_b >= 10) & (comp_b <= 70)))
 101:     o["htn"] = clean(g("htn"), (7, 9)).map({1: 1, 2: 0}); o["dm"] = clean(g("dm"), (7, 9)).map({1: 1, 2: 0})
 102:     o["srh"] = clean(g("srh"), (7, 9), 1, 5); o["stress"] = clean(g("stress"), (7, 9), 1, 5); o["race"] = np.nan
 103:     o["W"] = pd.to_numeric(g("wt"), errors="coerce"); o["strata"] = g("strata").astype(str); o["psu"] = g("psu").astype(str)
 104:     return o
