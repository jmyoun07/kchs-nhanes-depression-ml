  45: | 17-predictor | NHANES post | 0.10 | +0.0578 | +0.0244 | +0.0333 | +0.0333 | 0.398 |
  46: | 17-predictor | NHANES post | 0.15 | +0.0397 | -0.0329 | +0.0726 | +0.0397 | 0.255 |
  47: | 8-item | Internal | 0.10 | +0.0088 | -0.0711 | +0.0799 | +0.0088 | 0.083 |
  48: | 8-item | Internal | 0.15 | +0.0058 | -0.1341 | +0.1399 | +0.0058 | 0.047 |
  49: | 8-item | NHANES pre | 0.10 | +0.0302 | -0.0172 | +0.0474 | +0.0302 | 0.260 |
  50: | 8-item | NHANES pre | 0.15 | +0.0179 | -0.0771 | +0.0949 | +0.0179 | 0.157 |
