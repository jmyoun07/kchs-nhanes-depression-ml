 142: qc(f"KCHS 정렬검증: year 일치율={chk_y:.6f}, age 일치율={chk_a:.6f}")
 143: assert chk_y > 0.9999 and chk_a > 0.9999, "KCHS 정렬 검증 실패"
 144: kout = pd.concat([kchs, kal[EXT]], axis=1)
 145: kout.to_parquet(os.path.join(PROC, "ext_kchs.parquet"))
 146: qc(f"저장: data/processed/ext_kchs.parquet {kout.shape}")
