 134: def build_nhanes(period, folder, namer):
 135:     def rd(mod, cols):
 136:         """[버그수정#1-a] pyreadstat은 usecols에 없는 컬럼을 요청해도 **에러 없이 조용히 누락**시킨다.
 137:         DMDHHSIZ가 P_DEMO에 부재한 것을 이 침묵 때문에 놓쳐 living_alone이 pre에서 전량 날조됐다.
 138:         요청 대비 실제 반환 컬럼을 대조해 누락을 QC에 명시 기록한다."""
 139:         path = os.path.join(NB, folder, namer(mod))
 140:         df = pyreadstat.read_xport(path, usecols=["SEQN"] + cols, encoding="latin1")[0]
 141:         missing = [c for c in cols if c not in df.columns]
 142:         if missing:
 143:             qc(f"  [!] [{period}/{mod}] 원자료에 부재하여 누락된 컬럼: {missing}")
 144:         return df
 145:     wtmec = "WTMECPRP" if period == "pre" else "WTMEC2YR"
 146:     demo = rd("DEMO", ["RIAGENDR", "RIDAGEYR", "DMDEDUC2", "DMDMARTZ", "DMDHHSIZ", "INDFMPIR", "RIDRETH3", wtmec, "SDMVSTRA", "SDMVPSU"])
 147:     parts = [rd("DPQ", [f"DPQ0{i}0" for i in range(1, 10)]), rd("SMQ", ["SMQ020", "SMQ040"]),
 148:              rd("ALQ", ["ALQ111", "ALQ121", "ALQ130"]), rd("BMX", ["BMXBMI"]), rd("BPQ", ["BPQ020"]),
 149:              rd("DIQ", ["DIQ010"]), rd("SLQ", ["SLD012"])]
 150:     if period == "pre":
 151:         parts.append(rd("PAQ", ["PAQ650", "PAQ655", "PAD660", "PAQ665", "PAQ670", "PAD675"]))
 152:     else:
 153:         parts.append(rd("PAQ", ["PAD790Q", "PAD790U", "PAD800", "PAD810Q", "PAD810U", "PAD820"]))
 154:     try:
 155:         parts.append(rd("HUQ", ["HUQ010"]))   # 자가건강: NHANES=HUQ·HUQ010 (Table1의 HSQ·HSD010 오류 정정). 미다운로드면 스킵
 156:     except Exception:
 157:         pass
 158:     m = demo
 159:     for d in parts: m = m.merge(d, on="SEQN", how="left")
 160:     for col in (["DMDHHSIZ", "HUQ010", wtmec] + [f"DPQ0{i}0" for i in range(1, 10)]):
 161:         if col not in m.columns: m[col] = np.nan
 162:     o = pd.DataFrame(index=m.index); o["period"] = period
 163:     phq = m[[f"DPQ0{i}0" for i in range(1, 10)]].apply(pd.to_numeric, errors="coerce").mask(lambda x: x.isin([7, 9]))
 164:     comp = phq.notna().all(axis=1); o["phq_sum"] = phq.sum(axis=1).where(comp); o["dep"] = (o["phq_sum"] >= 10).astype(float).where(comp)
 165:     o["age"] = m["RIDAGEYR"]; o["sex"] = m["RIAGENDR"].map({1: "M", 2: "F"})
 166:     o["edu"] = clean(m["DMDEDUC2"], (7, 9)).map({1: "elem_low", 2: "middle", 3: "high", 4: "college", 5: "college"})
 167:     o["income_raw"] = m["INDFMPIR"]
 168:     o["income_q"] = pd.qcut(o["income_raw"], 5, labels=False, duplicates="drop")
 169:     o["partnered"] = clean(m["DMDMARTZ"], (77, 99)).map({1: 1, 2: 0, 3: 0})
 170:     # [버그수정#1-b] P_DEMO(pre)에는 DMDHHSIZ가 아예 없다(29컬럼 전수확인). 기존엔 전량 NaN이 된 뒤
 171:     # 학습 파이프라인의 최빈값 대체가 걸려 pre 7,888명 전원이 '비독거(0)'로 **날조**됐다.
 172:     # 여기서는 NaN을 그대로 보존하고(대체는 하지 않음), 결측 사실을 QC에 명시한다.
 173:     o["living_alone"] = (m["DMDHHSIZ"] == 1).astype(float).where(m["DMDHHSIZ"].notna())
 174:     if o["living_alone"].isna().all():
 175:         qc(f"  [!] [{period}] living_alone 100% 결측 ? DMDHHSIZ 부재. 최빈값 대체 시 상수 날조가 되므로 "
 176:            f"모델링 단계에서 결측 유지 또는 변수 제외 필요(민감도로 정량화).")
 177:     s2, s4 = clean(m["SMQ020"], (7, 9)), clean(m["SMQ040"], (7, 9))
 178:     sm = pd.Series(np.nan, index=m.index, dtype=object)
 179:     sm[s2 == 2] = "never"; sm[(s2 == 1) & (s4 == 3)] = "former"; sm[(s2 == 1) & (s4.isin([1, 2]))] = "current"; o["smoking"] = sm
 180:     a1, a2 = clean(m["ALQ111"], (7, 9)), clean(m["ALQ121"], (77, 99))
 181:     o["current_drinker"] = np.where((a1 == 1) & (a2.between(1, 10)), 1.0, np.where(a1.notna(), 0.0, np.nan))
 182:     o["active"] = pa_nhanes_pre(m) if period == "pre" else pa_nhanes_post(m)
 183:     o["sleep_hrs"] = clean(m["SLD012"], lo=0, hi=24); o["bmi"] = clean(m["BMXBMI"], lo=8, hi=80)
 184:     o["htn"] = clean(m["BPQ020"], (7, 9)).map({1: 1, 2: 0}); o["dm"] = clean(m["DIQ010"], (7, 9)).map({1: 1, 2: 0, 3: 0})
 185:     o["srh"] = clean(m["HUQ010"], (7, 9), 1, 5); o["stress"] = np.nan; o["race"] = m["RIDRETH3"]
 186:     o["W"] = pd.to_numeric(m[wtmec], errors="coerce"); o["strata"] = m["SDMVSTRA"].astype(str); o["psu"] = m["SDMVPSU"].astype(str)
 187:     return o
 188: 
 189: def finalize(df, name):
 190:     n0 = len(df); df = df[df["age"] >= 20]; df = df[df["dep"].notna()]
 191:     qc(f"[{name}] 성인20+·PHQ완결 n={len(df)} (원 {n0}) | 우울 유병률 {df['dep'].mean():.3%}")
 192:     pcols = ["age", "sex", "edu", "income_raw", "partnered", "smoking", "current_drinker", "active", "sleep_hrs", "bmi", "htn", "dm"]
 193:     qc("  결측%: " + ", ".join(f"{c}={df[c].isna().mean()*100:.1f}" for c in pcols))
 194:     return df
 195: 
 196: kfr = [build_kchs_year(y) for y in DEV_YEARS]
 197: for d in kfr: qc(f"KCHS {int(d['year'].iloc[0])}: n={len(d)} 완결={int(d['dep'].notna().sum())} 유병={d['dep'].mean():.3%} active결측%={d['active'].isna().mean()*100:.0f} bmi결측%={d['bmi'].isna().mean()*100:.0f}")
 198: kchs = finalize(pd.concat(kfr, ignore_index=True), "KCHS dev 2017-2025")
 199: kchs["W"] = kchs.groupby("year")["W"].transform(lambda w: w / w.sum())  # #15: 연도별 가중치 정규화(연도 동일 기여, person-period 추정)
 200: kchs.to_parquet(os.path.join(PROC, "kchs_dev.parquet"))
 201: npre = finalize(build_nhanes("pre", "pre_2017_2020", lambda x: f"P_{x}.xpt"), "NHANES pre"); npre.to_parquet(os.path.join(PROC, "nhanes_pre.parquet"))
 202: npost = finalize(build_nhanes("post", "post_2021_2023", lambda x: f"{x}_L.xpt"), "NHANES post"); npost.to_parquet(os.path.join(PROC, "nhanes_post.parquet"))
 203: qc("\n=== 연도별 크로스워크(핵심 변수) ===\n" + "\n".join(XW))
 204: open(os.path.join(ROOT, "results", "qc_crosswalk.txt"), "w", encoding="utf-8").write("\n".join(QC + [""] + XW))
 205: qc("\n저장 완료.")
===== ..\src\15_ext_harmonize.py =====
   1: # -*- coding: utf-8 -*-
   2: """
   3: 15_ext_harmonize.py ? 확장 후보 8변수를 KCHS / NHANES pre / NHANES post 에서 동일 정의로 추출.
   4: 기존 data/processed/{kchs_dev,nhanes_pre,nhanes_post}.parquet 에 병합 → ext_{kchs,pre,post}.parquet
   5: 
   6: 정렬 근거:
   7:  - NHANES: 기존 parquet의 index는 DEMO 파일의 위치 index. 동일 순서로 DEMO를 재독해 SEQN을 복원하고
   8:    SEQN 기준으로 후보 모듈을 merge한 뒤 index로 재정렬. (age 일치 검증 포함)
   9:  - KCHS: 기존 parquet의 index는 연도순 concat(ignore_index)의 위치 index. 동일 순서로 재구성 후 reindex.
  10:    (year 일치 검증 포함)
  11: 
  12: 조화 정의(검증된 코딩 근거는 results/ext_qc.txt 참조):
  13:  employed        KCHS soa_01z1 1→1, 2→0 (7/9 결측)            | NHANES OCD150 {1,2}→1, {3,4}→0 (7/9 결측)
  14:  oral_health     KCHS ora_01z1 1..5 그대로 (7/9 결측)          | NHANES OHQ845 1..5 그대로 (7/9 결측)
  15:  alcohol_freq    '주 2회 이상 음주' 이진. 경계가 양국에서 정확히 일치하는 유일한 지점.
  16:                  KCHS 2017-19 drb_01z2 {4,5}=1 / 2020-25 drb_01z3 {5,6}=1, 그 외 유효값·비음주(8)=0
  17:                  NHANES ALQ121 {1,2,3,4}=1 (주2회 이상), {5..10}=0, 0(연간비음주)=0
  18:  alcohol_qty     '1회 음주량 5잔 이상' 이진. KCHS drb_03z1 {3,4,5}=1, {1,2}=0, 8(비음주)=0
  19:                  NHANES ALQ130 >=5 →1, <5 →0, 비음주(스킵)=0
  20:                  (+ alcohol_qty_drinks 연속: KCHS 범주중앙값 1.5/3.5/5.5/8/12잔, NHANES ALQ130 원값)
  21:  binge           '월 1회 이상 폭음' 이진. KCHS drb_04z1(남)/drb_05z1(여) {3,4,5}=1, {1,2}=0, 8(비음주)=0
  22:                  NHANES ALQ142 {1..7}=1, {8,9,10}=0, 0=0, 비음주(스킵)=0
  23:  welfare         KCHS fma_04z1 1(현재수급)=1, {2(과거),3(비수급)}=0
  24:                  NHANES [정정] FSQ165는 라벨 확인 결과 'HH FS benefit: **ever** received'(평생)이며
  25:                  12개월/현재 수급이 아니다(가중 35%, 비가중 49% ? 현재수급으로 볼 수 없는 값).
  26:                  KCHS '현재 수급자'와 맞는 것은 FSD230('currently receive'). 스킵패턴 반영:
  27:                  FSD230=1→1 / FSD230=2 or FSQ012=2 or FSQ165=2 →0. (+ welfare_12mo = FSQ012 기준 보조지표)
  28:  sleep_weekend   KCHS mtc_18z1 (시간, 77/88/99 결측)           | NHANES SLD013 (시간)
  29:  food_insecure   KCHS nue_01z1 {3,4}=1, {1,2}=0               | NHANES FSDAD {3,4}=1, {1,2}=0
  30: """
  31: import os, re, sys, numpy as np, pandas as pd, pyreadstat
  32: try: sys.stdout.reconfigure(encoding="utf-8")
  33: except Exception: pass
  34: 
  35: ROOT = r"C:/Users/rudtn/Desktop/claude code/지역사회건강"
  36: KB = os.path.join(ROOT, "data/raw/kchs"); NB = os.path.join(ROOT, "data/raw/nhanes")
  37: PROC = os.path.join(ROOT, "data/processed"); RES = os.path.join(ROOT, "results")
  38: os.makedirs(RES, exist_ok=True)
  39: QC = []
  40: def qc(s): QC.append(str(s)); print(s)
  41: def wl(p):
  42:     p = os.path.abspath(p).replace("/", "\\"); return "\\\\?\\" + p if not p.startswith("\\\\?\\") else p
  43: def clean(s, miss=(), lo=None, hi=None):
  44:     s = pd.to_numeric(s, errors="coerce")
  45:     if miss: s = s.mask(s.isin(list(miss)))
  46:     if lo is not None: s = s.mask(s < lo)
  47:     if hi is not None: s = s.mask(s > hi)
  48:     return s
  49: 
  50: EXT = ["employed", "oral_health", "alcohol_freq", "alcohol_qty", "alcohol_qty_drinks",
  51:        "binge", "welfare", "welfare_12mo", "sleep_weekend", "food_insecure"]
  52: DEV_YEARS = list(range(2017, 2026))
  53: 
  54: # ---------------------------------------------------------------- KCHS
  55: KC = {  # 개념 → (우선 변수명 후보, 라벨 정규식)
  56:  "emp":  (["soa_01z1"], r"경제활동\s*여부"),
  57:  "oral": (["ora_01z1"], r"주관적\s*구강건강"),
  58:  "afq":  (["drb_01z3", "drb_01z2"], r"연간\s*음주\s*빈도"),
  59:  "aqty": (["drb_03z1"], r"음주량$|섭취\s*시\s*음주량"),
  60:  "bnM":  (["drb_04z1"], r"월간\s*폭음.*_남"),
  61:  "bnF":  (["drb_05z1"], r"월간\s*폭음.*_여"),
  62:  "wel":  (["fma_04z1"], r"기초생활수급자\s*여부"),
  63:  "slwe": (["mtc_18z1"], r"평균\s*수면시간.*주말"),
  64:  "food": (["nue_01z1"], r"가구\s*식품\s*안정성"),
  65:  "age":  (["age"], r"만나이|연령"),
  66: }
  67: def resolve(names, rx, n2l, avail):
  68:     for n in names:
  69:         if n in avail: return n
  70:     r = re.compile(rx)
  71:     for n, l in n2l.items():
  72:         if l and r.search(l): return n
  73:     return None
  74: 
  75: def kchs_path(year):
  76:     dd = os.path.join(KB, str(year), "data")
  77:     f = [x for x in sorted(os.listdir(dd)) if x.lower().endswith(".sas7bdat") and "ctv" not in x.lower()][0]
  78:     return os.path.join(dd, f)
  79: 
  80: XW = []
  81: def build_kchs_year(year):
  82:     path = kchs_path(year)
  83:     _, meta = pyreadstat.read_sas7bdat(wl(path), metadataonly=True)
  84:     n2l = dict(zip(meta.column_names, meta.column_labels or [""] * len(meta.column_names)))
  85:     A = set(meta.column_names)
  86:     pick = {k: resolve(v[0], v[1], n2l, A) for k, v in KC.items()}
  87:     XW.append(f"{year}: " + ", ".join(f"{k}={pick[k]}" for k in KC))
  88:     need = [v for v in pick.values() if v]
  89:     df, _ = pyreadstat.read_sas7bdat(wl(path), usecols=list(dict.fromkeys(need)))
  90:     got = [c for c in need if c in df.columns]
  91:     if set(need) - set(got): qc(f"  [!] KCHS {year} 반환누락: {sorted(set(need)-set(got))}")
  92:     g = lambda k: df[pick[k]] if pick[k] and pick[k] in df.columns else pd.Series(np.nan, index=df.index)
  93: 
  94:     o = pd.DataFrame(index=df.index); o["year"] = year; o["_age"] = clean(g("age"), lo=1, hi=120)
  95:     o["employed"] = clean(g("emp"), (7, 9)).map({1: 1.0, 2: 0.0})
  96:     o["oral_health"] = clean(g("oral"), (7, 9), 1, 5)
  97: 
  98:     # ---- 음주빈도: 2017-19 drb_01z2(1..5, 8=비해당) vs 2020-25 drb_01z3(1=연간비음주,2..6, 8=비해당)
  99:     af = clean(g("afq"), (7, 9))
 100:     if pick["afq"] == "drb_01z2":   # 1=월1회미만 2=월1회 3=월2-4회 4=주2-3회 5=주4회이상
 101:         wk2 = af.isin([4, 5])
 102:     else:                           # drb_01z3: 1=연간비음주 2=월1회미만 3=월1회 4=월2-4회 5=주2-3회 6=주4회이상
 103:         wk2 = af.isin([5, 6])
 104:     valid_af = af.isin([1, 2, 3, 4, 5, 6, 8])
 105:     o["alcohol_freq"] = wk2.astype(float).where(valid_af)
 106: 
 107:     # ---- 1회 음주량: drb_03z1 1=1~2잔 2=3~4잔 3=5~6잔 4=7~9잔 5=10잔+ 8=비해당(비음주)
 108:     aq = clean(g("aqty"), (7, 9))
 109:     valid_aq = aq.isin([1, 2, 3, 4, 5, 8])
 110:     o["alcohol_qty"] = aq.isin([3, 4, 5]).astype(float).where(valid_aq)
 111:     o["alcohol_qty_drinks"] = aq.map({1: 1.5, 2: 3.5, 3: 5.5, 4: 8.0, 5: 12.0, 8: 0.0}).where(valid_aq)
 112: 
 113:     # ---- 폭음: drb_04z1(남)/drb_05z1(여) 1=전혀 2=월1회미만 3=월1회 4=주1회 5=거의매일 8=비해당
 114:     bm, bf = clean(g("bnM"), (7, 9)), clean(g("bnF"), (7, 9))
 115:     bn = pd.Series(np.where(bm.isin([1, 2, 3, 4, 5]), bm, np.where(bf.isin([1, 2, 3, 4, 5]), bf, np.nan)), index=df.index)
 116:     skipped = (bm == 8) & ((bf == 8) | bf.isna())      # 남녀 모두 비해당(=연간 비음주)
 117:     o["binge"] = np.where(bn.isin([3, 4, 5]), 1.0, np.where(bn.isin([1, 2]) | skipped, 0.0, np.nan))
 118:     if pick["bnM"] is None and pick["bnF"] is None: o["binge"] = np.nan
 119: 
 120:     o["welfare"] = clean(g("wel"), (7, 9)).map({1: 1.0, 2: 0.0, 3: 0.0})
 121:     o["welfare_12mo"] = o["welfare"]   # KCHS는 현재 수급만 조사 → 동일값(대조용)
 122:     o["sleep_weekend"] = clean(g("slwe"), (77, 88, 99), 0, 24)
 123:     fi = clean(g("food"), (7, 9))
 124:     o["food_insecure"] = fi.isin([3, 4]).astype(float).where(fi.isin([1, 2, 3, 4]))
 125:     return o
