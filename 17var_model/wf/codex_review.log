 104: def net_benefit(d,p,ts):
 105:     yv=d["dep"].astype(int).values; W=d["W"].to_numpy(float); N=W.sum(); prev=np.average(yv,weights=W)
 106:     nb=[];nball=[]
 107:     for t in ts:
 108:         pred=p>=t; tp=W[(pred)&(yv==1)].sum(); fp=W[(pred)&(yv==0)].sum()
 109:         nb.append(tp/N-(fp/N)*(t/(1-t))); nball.append(prev-(1-prev)*(t/(1-t)))
 110:     return np.array(nb),np.array(nball)
