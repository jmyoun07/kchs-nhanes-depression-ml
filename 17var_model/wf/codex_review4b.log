qc(f"KCHS 정렬검증: year 일치율={chk_y:.6f}, age 일치율={chk_a:.6f}")
assert chk_y > 0.9999 and chk_a > 0.9999, "KCHS 정렬 검증 실패"
kout = pd.concat([kchs, kal[EXT]], axis=1)
kout.to_parquet(os.path.join(PROC, "ext_kchs.parquet"))
