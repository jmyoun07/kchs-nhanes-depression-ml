FIG = f"{D}/results/figures"
FIGURES = [
    ("Figure 1", "characteristics.png",  "Weighted sample characteristics across cohorts: panel A, prevalence/proportion; panel B, means (exact values in Multimedia Appendix 3, Table S6)."),
    ("Figure 2", "calibration.png",      "Calibration plots (internal, NHANES pre, NHANES post; original probabilities)."),
    ("Figure 3", "roc_curves.png",       "Receiver operating characteristic curves (weighted) for internal, NHANES pre, and NHANES post."),
    ("Figure 4", "sensitivity.png",      "Sensitivity analyses: weighted AUROC across specifications for internal, NHANES pre, and NHANES post (exact values in Multimedia Appendix 3, Table S7)."),
    ("Figure 5", "shap_importance.png",  "Global SHAP importance of the 17 predictors (KCHS)."),
    ("Figure 6", "subgroup_forest.png",  "Subgroup discrimination (weighted AUROC with 95% CIs) by sex, age, and education (KCHS hold-out) and by race/ethnicity (NHANES pre and post)."),
    ("Figure 7", "dca.png",              "Decision curves (weighted net benefit) for the three datasets, each with its own screen-all and screen-none default strategies; original, non-recalibrated probabilities."),
]

md = io.open(SRC, encoding="utf-8").read().replace("\r\n", "\n")
doc = Document()
st = doc.styles["Normal"]; st.font.name = "Times New Roman"; st.font.size = Pt(11)
st.paragraph_format.space_after = Pt(6); st.paragraph_format.line_spacing = 1.5

TOKEN = re.compile(r"(\*\*.+?\*\*|(?<![\w*])\*[^*\n]+?\*(?![\w*]))")
def add_runs(par, text):
    """**bold** / *italic* Ã³¸®."""
    for piece in TOKEN.split(text):
        if not piece: continue
        if piece.startswith("**") and piece.endswith("**"):
            par.add_run(piece[2:-2]).bold = True
        elif piece.startswith("*") and piece.endswith("*"):
            par.add_run(piece[1:-1]).italic = True
        else:
            par.add_run(piece)

def split_row(line):
    return [c.strip() for c in line.strip().strip("|").split("|")]

lines = md.split("\n")
i = 0
while i < len(lines):
    ln = lines[i].rstrip()
    if ln.strip() in ("", "---"):
        i += 1; continue
    # Ç¥
    if ln.lstrip().startswith("|") and i + 1 < len(lines) and set(lines[i+1].replace("|", "").replace(" ", "")) <= set("-:") and "-" in lines[i+1]:
        header = split_row(ln); body = []
        i += 2
        while i < len(lines) and lines[i].lstrip().startswith("|"):
            body.append(split_row(lines[i])); i += 1
        t = doc.add_table(rows=1, cols=len(header)); t.style = "Table Grid"
        for c, txt in zip(t.rows[0].cells, header):
            c.paragraphs[0].text = ""; add_runs(c.paragraphs[0], txt)
            for r in c.paragraphs[0].runs: r.bold = True; r.font.size = Pt(9)
        for row in body:
            cells = t.add_row().cells
            for c, txt in zip(cells, row + [""] * (len(header) - len(row))):
                c.paragraphs[0].text = ""; add_runs(c.paragraphs[0], txt)
                for r in c.paragraphs[0].runs: r.font.size = Pt(9)
        doc.add_paragraph()
        continue
    # Á¦¸ñ
    if ln.startswith("### "):
        p = doc.add_heading(level=3); add_runs(p, ln[4:])
    elif ln.startswith("## "):
        p = doc.add_heading(level=2); add_runs(p, ln[3:])
    elif ln.startswith("# "):
        p = doc.add_heading(level=1); add_runs(p, ln[2:])
    elif re.match(r"^\d+\. ", ln) or ln.startswith("- "):
        p = doc.add_paragraph(style="List Number" if re.match(r"^\d+\. ", ln) else "List Bullet")
        add_runs(p, re.sub(r"^(\d+\. |- )", "", ln))
    else:
        p = doc.add_paragraph(); add_runs(p, ln)
    i += 1

doc.add_page_break()
h = doc.add_heading(level=2); h.add_run("Figures")
for label, fn, cap in FIGURES:
    path = os.path.join(FIG, fn)
    if not os.path.exists(path):
        print(f"  [°æ°í] ±×¸² ¾øÀ½: {fn}"); continue
    doc.add_picture(path, width=Inches(6.0))
    doc.paragraphs[-1].alignment = WD_ALIGN_PARAGRAPH.CENTER
    cp = doc.add_paragraph(); r = cp.add_run(f"{label}. "); r.bold = True
    cp.add_run(cap); cp.runs[-1].font.size = Pt(10)
    cp.alignment = WD_ALIGN_PARAGRAPH.CENTER

try:
    doc.save(OUT)
except PermissionError:
    OUT = OUT.replace(".docx", "_rev1.docx")   # ¿øº»ÀÌ Word/ÇÑ±Û¿¡¼­ ¿­·Á ÀÖ´Â °æ¿ì
    doc.save(OUT)
    print("  [¾Ë¸²] ±âÁ¸ docx°¡ ¿­·Á ÀÖ¾î »õ ÆÄÀÏ·Î ÀúÀåÇß½À´Ï´Ù.")
print(f"ÀúÀå: {OUT}")
print(f"  ¹®´Ü {len(doc.paragraphs)} ¡¤ Ç¥ {len(doc.tables)} ¡¤ ±×¸² {len(FIGURES)}")

