class RW:
 def __init__(self,st,ps,w,fix):
  ost=pd.Series(st).astype(str).reset_index(drop=True); ps=pd.Series(ps).astype(str).reset_index(drop=True)
  npsu=pd.DataFrame({'s':ost,'p':ps}).drop_duplicates().groupby('s').size(); single=set(npsu[npsu==1].index)
  nst=ost.where(~ost.isin(single),'__SINGLETON_POOL__')
  clkey=(ost+'|'+ps) if fix else (nst+'|'+ps)
  cl=pd.factorize(clkey)[0]; sid=pd.factorize(nst)[0]; self.cl=cl; self.w=np.asarray(w,float); C=cl.max()+1; self.C=C
  cs=np.zeros(C,dtype=int); cs[cl]=sid; self.cs=cs; self.n=np.bincount(cs); self.mm=np.maximum(self.n-1,1)
  o=np.argsort(cs,kind='stable'); self.o=o; ss=cs[o]; sc=np.bincount(ss); start=np.concatenate([[0],np.cumsum(sc)])[:-1]; self.start=start[ss]; self.sn=sc[ss]; self.sg=self.n[cs]==1
  self.orig_single=len(single); self.pool_clusters=int((cs==pd.factorize(nst)[1].tolist().index('__SINGLETON_POOL__')).sum()) if '__SINGLETON_POOL__' in set(nst) else 0
 def weights(self,rng):
  r=np.zeros(self.C); u=rng.random_sample(self.C); idx=np.arange(self.C)-self.start; sel=np.where(idx<self.mm[self.cs[self.o]])[0]; pick=self.start[sel]+(u[sel]*self.sn[sel]).astype(int); np.add.at(r,self.o[pick],1.); sc=np.where(self.sg,1.,self.n[self.cs]/self.mm[self.cs]*r); return self.w*sc[self.cl]
def cis(fix):
 rw=RW((d.year.astype(str)+'|'+d.strata.astype(str)).to_numpy(),d.psu,basew,fix); rng=np.random.RandomState(42); aa=[]; ap=[]
 for _ in range(1000):
