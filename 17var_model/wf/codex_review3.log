import warnings, numpy as np, pandas as pd
warnings.filterwarnings('ignore')
from sklearn.model_selection import StratifiedKFold
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.metrics import roc_auc_score
import lightgbm as lgb
D='data'; SEED=42
pre=pd.read_parquet(f'{D}/ext_pre.parquet').assign(_period='pre'); post=pd.read_parquet(f'{D}/ext_post.parquet').assign(_period='post'); d=pd.concat([pre,post],ignore_index=True); d['strata2']=d._period.astype(str)+'|'+d.strata.astype(str)
NUM=['age','sleep_hrs','bmi','income_q','srh','oral_health']; BIN=['partnered','living_alone','current_drinker','active','htn','dm','employed','food_insecure']; CAT=['sex','edu','smoking']; FE=NUM+BIN+CAT
def ct(): return ColumnTransformer([('num',Pipeline([('i',SimpleImputer(strategy='median')),('s',StandardScaler())]),NUM),('bin','passthrough',BIN),('cat',Pipeline([('i',SimpleImputer(strategy='most_frequent')),('o',OneHotEncoder(handle_unknown='ignore',drop='first'))]),CAT)])
y=d.dep.astype(int).to_numpy(); w=d.W.to_numpy(float); oof=np.zeros(len(d)); sk=StratifiedKFold(5,shuffle=True,random_state=42)
for tr,te in sk.split(d[FE],y):
 m=Pipeline([('pre',ct()),('clf',lgb.LGBMClassifier(random_state=42,n_jobs=-1,verbose=-1,num_leaves=7,min_child_samples=200,learning_rate=.05,n_estimators=300))]).fit(d.iloc[tr][FE],y[tr]); oof[te]=m.predict_proba(d.iloc[te][FE])[:,1]
print('AUC',roc_auc_score(y,oof,sample_weight=w))
class RW:
 def __init__(self,st,psu,w):
  st=pd.Series(np.asarray(st)).astype(str).to_numpy(); ps=pd.Series(np.asarray(psu)).astype(str); cl=pd.factorize(pd.Series(st)+'|'+ps)[0]; sid=pd.factorize(pd.Series(st))[0]; self.cl=cl;self.w=np.asarray(w,float);C=cl.max()+1;cs=np.zeros(C,int);cs[cl]=sid;self.cs=cs;self.nh=np.bincount(cs);self.mh=np.maximum(self.nh-1,1);self.C=C;o=np.argsort(cs,kind='stable');self.o=o;ss=cs[o];sc=np.bincount(ss);start=np.r_[0,np.cumsum(sc)][:-1];self.start=start[ss];self.sn=sc[ss];self.single=self.nh[cs]==1
 def weights(self,rng):
  r=np.zeros(self.C);u=rng.random_sample(self.C);idx=np.arange(self.C)-self.start;slots=np.where(idx<self.mh[self.cs[self.o]])[0];pick=self.start[slots]+(u[slots]*self.sn[slots]).astype(int);np.add.at(r,self.o[pick],1.);scale=np.where(self.single,1.,self.nh[self.cs]/self.mh[self.cs]*r);return self.w*scale[self.cl]
rw=RW(d.strata2,d.psu,w); rng=np.random.RandomState(42); vals=[]
for _ in range(1000):
 ww=rw.weights(rng)
 try: vals.append(roc_auc_score(y,oof,sample_weight=ww))
 except: pass
print('RaoWu B',len(vals),'CI',np.percentile(vals,[2.5,97.5]),'SE',np.std(vals,ddof=1))
# Reproduce old ordinary n_h bootstrap exactly for comparison
class Old:
 def __init__(self,st,psu):
  cl=pd.factorize(pd.Series(np.asarray(st)).astype(str)+'|'+pd.Series(np.asarray(psu)).astype(str))[0]; sid=pd.factorize(pd.Series(np.asarray(st)).astype(str))[0]; order=np.argsort(cl,kind='stable'); self.mem=order; self.count=np.bincount(cl); self.off=np.r_[0,np.cumsum(self.count)]; first=np.zeros(len(self.count),int);first[cl[order]]=sid[order];o=np.argsort(first,kind='stable');self.o=o;ss=first[o];sc=np.bincount(ss);start=np.r_[0,np.cumsum(sc)][:-1];self.start=start[ss];self.sn=sc[ss];self.C=len(self.count)
 def draw(self,rng):
  cs=self.o[self.start+(rng.random_sample(self.C)*self.sn).astype(int)]; L=self.count[cs];tot=int(L.sum());return self.mem[np.repeat(self.off[cs],L)+np.arange(tot)-np.repeat(np.r_[0,np.cumsum(L)][:-1],L)]
old=Old(d.strata2,d.psu); rng=np.random.RandomState(42); v=[]
for _ in range(1000):
 ii=old.draw(rng)
 try:v.append(roc_auc_score(y[ii],oof[ii],sample_weight=w[ii]))
 except:pass
print('Old B',len(v),'CI',np.percentile(v,[2.5,97.5]),'SE',np.std(v,ddof=1))
