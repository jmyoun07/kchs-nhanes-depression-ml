68-        # ì¸µë³„ë¡œ m_hê°œë§Œ ë½‘ê¸° ìœ„í•´ ìŠ¬ë¡¯ ì¸ë±ìŠ¤ë¥¼ ì¸µ ë‚´ ìˆœë²ˆìœ¼ë¡œ ë³€í™˜
69-        idx_in_stratum = np.arange(self.C) - self.slot_start
