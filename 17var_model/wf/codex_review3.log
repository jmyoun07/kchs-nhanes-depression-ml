   1: # -*- coding: utf-8 -*-
   2: """货 抗螟 档皋牢捞 NHANES 坷扼努 玫厘阑 棵府绰瘤 柳窜.
   3: 货 促款肺靛 绝捞 肺拿 盔磊丰(MCQ/HUQ/HIQ)俊辑 饶焊 档皋牢 眠免 ℃
   4: 扁粮 17函荐俊 眠啊 ℃ NHANES 磊眉 5-fold CV 坷扼努 厚背.
   5: 玫厘(泅 pooled 0.765)捞 坷福搁 KCHS 炼拳 啊摹 乐澜."""
   6: import os, sys, warnings, numpy as np, pandas as pd, pyreadstat
   7: sys.stdout.reconfigure(encoding="utf-8"); warnings.filterwarnings("ignore")
   8: from sklearn.model_selection import StratifiedKFold
