class RW:
 def __init__(self,strata,psu,w):
  st=pd.Series(np.asarray(strata)).astype(str).to_numpy(); pv=pd.Series(np.asarray(psu)).astype(str); cl=pd.factorize(pd.Series(st)+'|'+pv)[0]; sid=pd.factorize(pd.Series(st))[0]; self.cl=cl; self.w=np.asarray(w,float); C=cl.max()+1; cs=np.zeros(C,dtype=int); cs[cl]=sid; self.cs=cs; self.nh=np.bincount(cs); self.mh=np.maximum(self.nh-1,1); self.C=C; o=np.argsort(cs,kind='stable'); self.o=o; ss=cs[o]; sc=np.bincount(ss); start=np.r_[0,np.cumsum(sc)][:-1]; self.start=start[ss]; self.sn=sc[ss]; self.singleton=self.nh[cs]==1
 def weights(self,rng):
  r=np.zeros(self.C); draws=rng.random_sample(self.C); idx=np.arange(self.C)-self.start; keep=idx<self.mh[self.cs[self.o]]; slots=np.where(keep)[0]; pick=self.start[slots]+(draws[slots]*self.sn[slots]).astype(int); np.add.at(r,self.o[pick],1.); scale=np.where(self.singleton,1.,(self.nh[self.cs]/self.mh[self.cs])*r); return self.w*scale[self.cl]
def ci_filtered(d,B=1000,strata=None):
