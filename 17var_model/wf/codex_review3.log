import warnings, numpy as np, pandas as pd, time
warnings.filterwarnings('ignore')
from sklearn.model_selection import train_test_split
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.metrics import roc_auc_score
import lightgbm as lgb
SEED=42
NUM=['age','sleep_hrs','bmi','income_q','srh','oral_health']; BIN=['partnered','living_alone','current_drinker','active','htn','dm','employed','food_insecure']; CAT=['sex','edu','smoking']; FE=NUM+BIN+CAT
NUM14=['age','sleep_hrs','bmi','income_q','srh']; BIN14=['partnered','living_alone','current_drinker','active','htn','dm']; CAT14=CAT; FE14=NUM14+BIN14+CAT14
LGB=dict(num_leaves=31,min_child_samples=1000,learning_rate=0.01,n_estimators=900,reg_alpha=1.0,reg_lambda=20.0,subsample=0.6,colsample_bytree=0.6,random_state=42,n_jobs=-1,verbose=-1)
LGB14=dict(num_leaves=15,min_child_samples=500,learning_rate=0.01,n_estimators=900,reg_alpha=1.0,reg_lambda=1.0,subsample=0.8,colsample_bytree=0.6,random_state=42,n_jobs=-1,verbose=-1)
def ct(NU,BI,CA): return ColumnTransformer([('num',Pipeline([('i',SimpleImputer(strategy='median')),('s',StandardScaler())]),NU),('bin','passthrough',BI),('cat',Pipeline([('i',SimpleImputer(strategy='most_frequent')),('o',OneHotEncoder(handle_unknown='ignore',drop='first'))]),CA)])
k=pd.read_parquet('data/ext_kchs.parquet'); pre=pd.read_parquet('data/ext_pre.parquet'); post=pd.read_parquet('data/ext_post.parquet'); y=k.dep.astype(int).to_numpy(); tr,ho=train_test_split(np.arange(len(k)),train_size=500000,test_size=100000,stratify=y,random_state=42)
t=time.time(); m17=Pipeline([('pre',ct(NUM,BIN,CAT)),('clf',lgb.LGBMClassifier(**LGB))]).fit(k.iloc[tr][FE],y[tr]); print('trained17 sec',round(time.time()-t,1))
dho=k.iloc[ho].copy(); dho['_p']=m17.predict_proba(dho[FE])[:,1]; pre=pre.copy(); post=post.copy(); pre['_p']=m17.predict_proba(pre[FE])[:,1]; post['_p']=m17.predict_proba(post[FE])[:,1]
print('AUCs',*[round(roc_auc_score(d.dep.astype(int),d._p,sample_weight=d.W),6) for d in [dho,pre,post]])
class RW:
 def __init__(self,strata,psu,w):
  st=pd.Series(strata).astype(str).to_numpy(); cl=pd.factorize(pd.Series(st)+'|'+pd.Series(psu).astype(str))[0]; sid=pd.factorize(pd.Series(st))[0]; self.cl=cl; self.w=np.asarray(w,float); C=cl.max()+1; cs=np.zeros(C,dtype=int); cs[cl]=sid; self.cs=cs; self.nh=np.bincount(cs); self.mh=np.maximum(self.nh-1,1); self.C=C; o=np.argsort(cs,kind='stable'); self.o=o; ss=cs[o]; sc=np.bincount(ss); start=np.r_[0,np.cumsum(sc)][:-1]; self.start=start[ss]; self.sn=sc[ss]; self.singleton=self.nh[cs]==1
 def weights(self,rng):
  r=np.zeros(self.C); draws=rng.random_sample(self.C); idx=np.arange(self.C)-self.start; keep=idx<self.mh[self.cs[self.o]]; slots=np.where(keep)[0]; pick=self.start[slots]+(draws[slots]*self.sn[slots]).astype(int); np.add.at(r,self.o[pick],1.); scale=np.where(self.singleton,1.,(self.nh[self.cs]/self.mh[self.cs])*r); return self.w*scale[self.cl]
def ci_filtered(d,B=1000,strata=None):
 rw=RW(d.strata if strata is None else strata,d.psu,d.W); rng=np.random.RandomState(42); vals=[]; yy=d.dep.astype(int).to_numpy(); p=d._p.to_numpy()
 for _ in range(B):
  w=rw.weights(rng)
  try: vals.append(roc_auc_score(yy,p,sample_weight=w))
  except: pass
 return np.percentile(vals,[2.5,97.5]),len(vals)
def ci_domain(full,mask,B=1000):
 rw=RW(full.strata,full.psu,full.W); rng=np.random.RandomState(42); vals=[]; yy=full.dep.astype(int).to_numpy(); p=full._p.to_numpy(); mask=np.asarray(mask,bool)
 for _ in range(B):
  w=rw.weights(rng); w=w[mask]
