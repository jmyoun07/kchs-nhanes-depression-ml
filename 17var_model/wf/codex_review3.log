  18: NB=f"{ROOT}/data/raw/nhanes"; D=f"{ROOT}/17var_model"
  19: FOLD={"pre":("pre_2017_2020",lambda m:f"P_{m}.xpt"),"post":("post_2021_2023",lambda m:f"{m}_L.xpt")}
  20: def clean(s,miss):
  21:     s=pd.to_numeric(s,errors="coerce"); return s.mask(s.isin(miss))
  22: def new_feats(period):
  23:     """SEQN 虐肺 货 函荐 眠免 (DEMO 鉴辑 蜡瘤, index=DEMO 困摹)."""
  24:     folder,namer=FOLD[period]
  25:     def rd(mod,cols):
  26:         df=pyreadstat.read_xport(f"{NB}/{folder}/{namer(mod)}",usecols=["SEQN"]+cols,encoding="latin1")[0]
  27:         for c in cols:
  28:             if c not in df.columns: df[c]=np.nan
  29:         return df
  30:     demo=rd("DEMO",["RIDAGEYR"]); m=demo.copy()   # index 0..N-1 = DEMO 困摹
  31:     mcq=["MCQ010","MCQ160A","MCQ160M","MCQ160P","MCQ160L","MCQ220"]
  32:     m=m.merge(rd("MCQ",mcq),on="SEQN",how="left")
  33:     m=m.merge(rd("HUQ",["HUQ051","HUQ071"]),on="SEQN",how="left")
  34:     m=m.merge(rd("HIQ",["HIQ011"]),on="SEQN",how="left")
  35:     o=pd.DataFrame(index=m.index); o["_age"]=m["RIDAGEYR"].to_numpy()
  36:     cc=np.zeros(len(m)); anyv=np.zeros(len(m),bool)
  37:     for c in mcq:
  38:         v=clean(m[c],(7,9)); cc+=(v==1).astype(float); anyv|=v.notna().to_numpy()
  39:     o["comorb"]=np.where(anyv,cc,np.nan)
  40:     o["hc_visits"]=clean(m["HUQ051"],(77,99)).to_numpy()
  41:     h71=clean(m["HUQ071"],(7,9))
  42:     o["hospitalized"]=np.where(h71==1,1.0,np.where(h71==2,0.0,np.nan))
  43:     h11=clean(m["HIQ011"],(7,9))
  44:     o["insured"]=np.where(h11==1,1.0,np.where(h11==2,0.0,np.nan))
  45:     return o
  46: 
  47: NUM=["age","sleep_hrs","bmi","income_q","srh","oral_health"]; BIN=["partnered","living_alone","current_drinker","active","htn","dm","employed","food_insecure"]; CAT=["sex","edu","smoking"]
  48: def attach(period):
  49:     ext=pd.read_parquet(f"{D}/data/ext_{period}.parquet")   # index=DEMO 困摹 (焊粮凳)
  50:     nf=new_feats(period).reindex(ext.index)                 # DEMO 困摹肺 沥纺
  51:     a1=nf["_age"].to_numpy(float); a2=ext["age"].to_numpy(float)
  52:     chk=np.mean((a1==a2)|(np.isnan(a1)&np.isnan(a2)))
  53:     print(f"  {period} 沥纺八刘 age 老摹啦={chk:.5f}  (comorb 搬螟 {nf['comorb'].isna().mean()*100:.1f}%, hc_visits 搬螟 {nf['hc_visits'].isna().mean()*100:.1f}%)")
  54:     assert chk>0.999, f"{period} 沥纺 角菩"
  55:     ext=ext.reset_index(drop=True)
  56:     for c in ["comorb","hc_visits","hospitalized","insured"]: ext[c]=nf[c].to_numpy()
  57:     return ext,chk
  58: 
  59: print("货 档皋牢 眠免·沥纺:")
  60: pre,c1=attach("pre"); post,c2=attach("post")
  61: both=pd.concat([pre,post],ignore_index=True)
  62: # 窜函樊 脚龋
  63: print("\nNHANES 快匡苞 货 函荐 惑包(pooled):")
  64: for c in ["comorb","hc_visits","hospitalized","insured"]:
  65:     x=both[c]; msk=x.notna()
  66:     print(f"  {c:<14} r={np.corrcoef(x[msk],both['dep'].astype(float)[msk])[0,1]:+.3f}  (mean {x.mean():.2f})")
  67: 
  68: def ct(feN,feB,feC):
  69:     return ColumnTransformer([("num",Pipeline([("i",SimpleImputer(strategy="median")),("s",StandardScaler())]),feN),
  70:         ("bin",Pipeline([("i",SimpleImputer(strategy="most_frequent"))]),feB),
  71:         ("cat",Pipeline([("i",SimpleImputer(strategy="most_frequent")),("o",OneHotEncoder(handle_unknown="ignore",drop="first"))]),feC)])
  72: def oracle(dd,feN,feB,feC,label):
  73:     FE=feN+feB+feC; yy=dd["dep"].astype(int).values; w=dd["W"].to_numpy(float)
  74:     best=0
  75:     for nm,mk in [("Logit",lambda:LogisticRegression(max_iter=4000,C=0.3)),
  76:                   ("LGBM",lambda:lgb.LGBMClassifier(num_leaves=15,min_child_samples=50,learning_rate=0.03,n_estimators=400,reg_lambda=5.0,random_state=SEED,n_jobs=-1,verbose=-1))]:
  77:         skf=StratifiedKFold(5,shuffle=True,random_state=SEED); oof=np.zeros(len(dd))
  78:         for a,b in skf.split(dd,yy):
  79:             c=ct(feN,feB,feC); Xa=c.fit_transform(dd.iloc[a][FE]); Xb=c.transform(dd.iloc[b][FE])
  80:             g=mk().fit(Xa,yy[a],sample_weight=w[a]); oof[b]=g.predict_proba(Xb)[:,1]
  81:         best=max(best,roc_auc_score(yy,oof,sample_weight=w))
  82:     print(f"  {label:<32} pooled 坷扼努={best:.4f}")
  83:     return best
  84: 
  85: print("\n"+"="*64)
  86: print("坷扼努 厚背 (pooled NHANES, 5-fold CV, Logit/LGBM 弥瘩蔼)")
  87: print("="*64)
  88: b0=oracle(both,NUM,BIN,CAT,"17函荐 (扁霖)")
  89: oracle(both,NUM+["comorb"],BIN,CAT,"+促吝捞券(comorb)")
  90: oracle(both,NUM+["hc_visits"],BIN+["hospitalized"],CAT,"+狼丰捞侩(visits+涝盔)")
  91: oracle(both,NUM,BIN+["insured"],CAT,"+焊氰(insured)")
  92: bAll=oracle(both,NUM+["comorb","hc_visits"],BIN+["hospitalized","insured"],CAT,"+货 档皋牢 傈何(4)")
  93: print(f"\n扁霖 坷扼努 {b0:.4f} ℃ 货 档皋牢 傈何 {bAll:.4f}  (ツ={bAll-b0:+.4f})")
  94: print("ツ啊 +0.01 捞惑捞搁 KCHS 炼拳 啊摹 乐澜. 固固窍搁 货 函荐档 玫厘 给 棵覆 犬沥.")
