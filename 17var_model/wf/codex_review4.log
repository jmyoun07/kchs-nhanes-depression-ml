42: # ?????????????????? Rao-Wu-Yue 재척도 군집 부트스트랩 ??????????????????
43: class RaoWuBoot:
44:     """층 h에서 m_h = n_h - 1 개의 PSU를 복원추출하고 가중치를 재척도한다.
45:        w* = w · (n_h/m_h) · r_hi   (m_h = n_h-1 일 때 표준 재척도 부트스트랩; n_h=2면 half-sampling)
46:        n_h = 1 인 층은 재표집하지 않고 가중치를 그대로 둔다(분산 기여 0)."""
47:     def __init__(self, strata, psu, w):
48:         st = pd.Series(strata).astype(str).values
49:         cl = pd.factorize(pd.Series(st) + "|" + pd.Series(psu).astype(str))[0]
50:         sid = pd.factorize(pd.Series(st))[0]
51:         self.cl = cl; self.w = np.asarray(w, float)
52:         C = cl.max()+1
53:         cl_stratum = np.zeros(C, dtype=int); cl_stratum[cl] = sid
54:         self.cl_stratum = cl_stratum
55:         self.n_h = np.bincount(cl_stratum)                    # 층별 PSU 수
56:         self.m_h = np.maximum(self.n_h - 1, 1)
57:         self.C = C
58:         # 층별 군집 인덱스 범위(층순 정렬)
59:         o = np.argsort(cl_stratum, kind="stable"); self.cl_sorted = o
60:         s_sorted = cl_stratum[o]; sc = np.bincount(s_sorted)
61:         self.st_start = np.concatenate([[0], np.cumsum(sc)])[:-1]
62:         self.slot_start = self.st_start[s_sorted]; self.slot_n = sc[s_sorted]
63:         self.singleton = self.n_h[cl_stratum] == 1
64:     def weights(self, rng):
65:         r = np.zeros(self.C)
66:         # 각 층에서 m_h개를 복원추출 → 군집별 선택 횟수 r_hi
67:         draws = rng.random_sample(self.C)                      # 슬롯당 1회 = 총 C회는 과다 → 층별 m_h만 사용
68:         # 층별로 m_h개만 뽑기 위해 슬롯 인덱스를 층 내 순번으로 변환
69:         idx_in_stratum = np.arange(self.C) - self.slot_start
70:         keep = idx_in_stratum < self.m_h[self.cl_stratum[self.cl_sorted]]
71:         sel_slots = np.where(keep)[0]
72:         pick = self.slot_start[sel_slots] + (draws[sel_slots] * self.slot_n[sel_slots]).astype(int)
73:         np.add.at(r, self.cl_sorted[pick], 1.0)
74:         scale = np.where(self.singleton, 1.0, (self.n_h[self.cl_stratum] / self.m_h[self.cl_stratum]) * r)
75:         return self.w * scale[self.cl]
