107:             if yv[m].min()==yv[m].max(): continue
108:             try: est.append(roc_auc_score(yv,p,sample_weight=ww))
109:             except Exception: pass
110:         est=np.array(est); out[tag]=(float(np.percentile(est,2.5)),float(np.percentile(est,97.5)),rw.n_singleton_strata)
111:     lo,hi,ns=out["pooled"]; nlo,nhi,_=out["naive"]
112:     print(f"  {coh:<12} {lab:<28} n={len(d):>6,}  AUROC {a:.3f}  CI [{lo:.3f},{hi:.3f}]  (단일층 {ns}개, 미통합시 [{nlo:.3f},{nhi:.3f}])", flush=True)
113:     rows.append(dict(cohort=coh,subgroup=lab,n=len(d),AUROC=round(a,3),CI_lo=round(lo,3),CI_hi=round(hi,3),
114:                      CI_lo_naive=round(nlo,3),CI_hi_naive=round(nhi,3),singleton_strata=ns,
