===== 48_parsimonious_clean.py =====
1: # -*- coding: utf-8 -*-
2: """48_parsimonious_clean.py ? 경량모델 선택을 학습셋 안에서만 수행하도록 재설계.
3: 
4: 지적사항: 기존에는 (a) SHAP 순서를 hold-out 표본에서 구하고 (b) 문항수 k도 같은 hold-out에서 골랐다.
5: 따라서 보고된 내부 성능은 선택 후(post-selection) 값이었다.
6: 
7: 수정 설계:
8:   학습셋 500,000 → 적합 450,000 / 선택용 검증 50,000 으로 분할
9:   · SHAP 순서: 적합 450k에서 학습한 모델을 450k 표본으로 설명(외부·hold-out 미사용)
10:   · k 선택: 선택용 검증 50k의 가중 AUROC로만 결정
11:   · hold-out 100k과 NHANES는 평가에만 사용
12:   · k = 1..17 전 구간 산출(부분 구간만 보고하던 문제 해소)
13: 
14: 출력: results/parsimonious_clean.csv
15: """
16: import sys, warnings, numpy as np, pandas as pd
17: sys.stdout.reconfigure(encoding="utf-8"); warnings.filterwarnings("ignore")
18: from sklearn.model_selection import train_test_split
19: from sklearn.compose import ColumnTransformer
20: from sklearn.pipeline import Pipeline
21: from sklearn.impute import SimpleImputer
22: from sklearn.preprocessing import StandardScaler, OneHotEncoder
23: from sklearn.metrics import roc_auc_score
24: import lightgbm as lgb, shap
25: 
26: D = r"C:/Users/rudtn/Desktop/claude code/지역사회건강/17var_model"; RES = f"{D}/results"; SEED = 42
27: kchs = pd.read_parquet(f"{D}/data/ext_kchs.parquet"); pre = pd.read_parquet(f"{D}/data/ext_pre.parquet"); post = pd.read_parquet(f"{D}/data/ext_post.parquet")
28: NUM = ["age","sleep_hrs","bmi","income_q","srh","oral_health"]
29: BIN = ["partnered","living_alone","current_drinker","active","htn","dm","employed","food_insecure"]
30: CAT = ["sex","edu","smoking"]; FE = NUM+BIN+CAT
31: y = kchs["dep"].astype(int).values
32: LGB = dict(num_leaves=31, min_child_samples=1000, learning_rate=0.01, n_estimators=900, reg_alpha=1.0,
33:            reg_lambda=20.0, subsample=0.6, colsample_bytree=0.6, random_state=SEED, n_jobs=-1, verbose=-1)
34: def make_ct(NU, BI, CA):
35:     t=[]
36:     if NU: t.append(("num", Pipeline([("i",SimpleImputer(strategy="median")),("s",StandardScaler())]), NU))
37:     if BI: t.append(("bin","passthrough",BI))
38:     if CA: t.append(("cat", Pipeline([("i",SimpleImputer(strategy="most_frequent")),("o",OneHotEncoder(handle_unknown="ignore",drop="first"))]), CA))
39:     return ColumnTransformer(t)
40: 
41: tr, ho = train_test_split(np.arange(len(kchs)), train_size=500000, test_size=100000, stratify=y, random_state=SEED)
42: fit_idx, sel_idx = train_test_split(tr, train_size=450000, test_size=50000, stratify=y[tr], random_state=SEED)
43: print(f"[분할] 학습 500,000 → 적합 {len(fit_idx):,} / 선택검증 {len(sel_idx):,} · hold-out {len(ho):,}(평가 전용)", flush=True)
44: 
45: # ── SHAP 순서: 적합셋에서만 ──
46: full = Pipeline([("pre", make_ct(NUM,BIN,CAT)), ("clf", lgb.LGBMClassifier(**LGB))]).fit(kchs.iloc[fit_idx][FE], y[fit_idx])
47: samp = kchs.iloc[np.random.RandomState(SEED).choice(fit_idx, 20000, replace=False)]
48: Xs = full.named_steps["pre"].transform(samp[FE])
49: names = full.named_steps["pre"].get_feature_names_out()
50: sv = shap.TreeExplainer(full.named_steps["clf"]).shap_values(Xs)
51: if isinstance(sv, list): sv = sv[1]
52: imp = pd.Series(np.abs(sv).mean(0), index=[n.split("__")[-1] for n in names])
53: agg = {}
54: for v in FE:
55:     agg[v] = imp[[i for i in imp.index if i == v or i.startswith(v+"_")]].sum()
56: order = pd.Series(agg).sort_values(ascending=False)
57: order.to_csv(f"{RES}/shap_importance_train.csv", encoding="utf-8-sig")
58: print(f"[SHAP 순서, 적합셋 기준] {list(order.index)}", flush=True)
59: 
60: W_sel = kchs.iloc[sel_idx]["W"].to_numpy(float); y_sel = y[sel_idx]
61: W_ho  = kchs.iloc[ho]["W"].to_numpy(float);      y_ho  = y[ho]
62: Wp, Ws = pre["W"].to_numpy(float), post["W"].to_numpy(float)
63: yp, ys = pre["dep"].astype(int).values, post["dep"].astype(int).values
64: 
65: rows=[]
66: for k in range(1, 18):
67:     f = list(order.index[:k])
68:     NU=[c for c in NUM if c in f]; BI=[c for c in BIN if c in f]; CA=[c for c in CAT if c in f]; FEk=NU+BI+CA
69:     m = Pipeline([("pre", make_ct(NU,BI,CA)), ("clf", lgb.LGBMClassifier(**LGB))]).fit(kchs.iloc[fit_idx][FEk], y[fit_idx])
70:     sel = roc_auc_score(y_sel, m.predict_proba(kchs.iloc[sel_idx][FEk])[:,1], sample_weight=W_sel)
71:     hoa = roc_auc_score(y_ho,  m.predict_proba(kchs.iloc[ho][FEk])[:,1],     sample_weight=W_ho)
72:     pa  = roc_auc_score(yp,    m.predict_proba(pre[FEk])[:,1],               sample_weight=Wp)
73:     sa  = roc_auc_score(ys,    m.predict_proba(post[FEk])[:,1],              sample_weight=Ws)
74:     print(f"   k={k:>2}  선택검증 {sel:.4f} | hold-out {hoa:.4f}  pre {pa:.4f}  post {sa:.4f}   +{f[-1]}", flush=True)
75:     rows.append(dict(k=k, added=f[-1], vars=";".join(f), selection_AUROC=round(sel,4),
76:                      holdout_AUROC=round(hoa,4), ext_pre=round(pa,4), ext_post=round(sa,4)))
77: df = pd.DataFrame(rows); df.to_csv(f"{RES}/parsimonious_clean.csv", index=False, encoding="utf-8-sig")
78: full_sel = float(df.loc[df.k==17,"selection_AUROC"].iloc[0])
79: cand = df[(df.k<17) & (df.selection_AUROC >= full_sel-0.01)]
80: kstar = int(cand.k.min()) if len(cand) else 17
81: print(f"\n[선택] 전체모델 선택검증 {full_sel:.4f} · 0.01 이내 최소 문항수 k*={kstar}", flush=True)
82: print(df.to_string(index=False), flush=True)
83: print("\n저장: results/parsimonious_clean.csv, shap_importance_train.csv\n완료.", flush=True)

===== 36_utility.py =====
1: # -*- coding: utf-8 -*-
2: """임상적 유용성 심화 ? 고민감도 트리아지 운영지점 + 순편익. 17변수 & 7문항 배포모델.
3: 가중(설계) 기반. 재보정(Platt)은 배포 시나리오로 순편익 계산에만 사용(외부라벨=지역재보정, 공개됨)."""
4: import sys, warnings, numpy as np, pandas as pd
5: sys.stdout.reconfigure(encoding="utf-8"); warnings.filterwarnings("ignore")
6: from sklearn.model_selection import train_test_split
7: from sklearn.compose import ColumnTransformer
8: from sklearn.pipeline import Pipeline
9: from sklearn.impute import SimpleImputer
10: from sklearn.preprocessing import StandardScaler, OneHotEncoder
11: from sklearn.linear_model import LogisticRegression
12: import lightgbm as lgb
13: SEED=42; D="C:/Users/rudtn/Desktop/claude code/지역사회건강/17var_model"
14: NUM=["age","sleep_hrs","bmi","income_q","srh","oral_health"]; BIN=["partnered","living_alone","current_drinker","active","htn","dm","employed","food_insecure"]; CAT=["sex","edu","smoking"]
15: FE17=NUM+BIN+CAT
16: # 배포모델 = 5문항 (사전지정 0.02 여유, 48_parsimonious_clean.py) / 7문항은 사후 변형
17: NUM5=["srh","age","sleep_hrs","oral_health"]; BIN5=[]; CAT5=["sex"]; FE5=NUM5+BIN5+CAT5
18: NUM8=["srh","age","sleep_hrs","oral_health"]; BIN8=["employed","partnered"]; CAT8=["sex"]; FE8=NUM8+BIN8+CAT8
19: LGB=dict(num_leaves=31,min_child_samples=1000,learning_rate=0.01,n_estimators=900,reg_alpha=1.0,reg_lambda=20.0,subsample=0.6,colsample_bytree=0.6,random_state=SEED,n_jobs=-1,verbose=-1)
20: kchs=pd.read_parquet(f"{D}/data/ext_kchs.parquet",columns=FE17+["dep","W"])
21: pre =pd.read_parquet(f"{D}/data/ext_pre.parquet", columns=FE17+["dep","W"])
22: post=pd.read_parquet(f"{D}/data/ext_post.parquet",columns=FE17+["dep","W"])
23: y=kchs["dep"].astype(int).values
24: tr,ho=train_test_split(np.arange(len(kchs)),train_size=500000,test_size=100000,stratify=y,random_state=SEED)
25: def ctf(NU,BI,CA): return ColumnTransformer([("num",Pipeline([("i",SimpleImputer(strategy="median")),("s",StandardScaler())]),NU),("bin","passthrough",BI),("cat",Pipeline([("i",SimpleImputer(strategy="most_frequent")),("o",OneHotEncoder(handle_unknown="ignore",drop="first"))]),CA)])
26: def train(NU,BI,CA):
27:     fe=NU+BI+CA; c=ctf(NU,BI,CA); m=lgb.LGBMClassifier(**LGB).fit(c.fit_transform(kchs.iloc[tr][fe]),y[tr])
28:     return c,m,fe
29: 
30: def wq(yv,p,w):  # 가중 지표 유틸
31:     return yv.astype(float),p,w.astype(float)
32: def sens_at(yv,p,w,target):
33:     # 양성자 점수의 가중 분위로 목표 민감도 임계 찾기
34:     pos=yv==1; order=np.argsort(-p[pos]); wp=w[pos][order]; cum=np.cumsum(wp)/wp.sum()
35:     k=int(np.searchsorted(cum,target)); k=min(k,len(order)-1)
36:     return p[pos][order][k]
37: def metrics(yv,p,w,t):
38:     P=w[(yv==1)&(p>=t)].sum(); FN=w[(yv==1)&(p<t)].sum(); FP=w[(yv==0)&(p>=t)].sum(); TN=w[(yv==0)&(p<t)].sum()
39:     sens=P/(P+FN) if P+FN>0 else 0; spec=TN/(TN+FP) if TN+FP>0 else 0
40:     ppv=P/(P+FP) if P+FP>0 else 0; npv=TN/(TN+FN) if TN+FN>0 else 0
41:     flag=(P+FP)/w.sum(); nns=1/ppv if ppv>0 else np.nan
42:     return sens,spec,ppv,npv,flag,nns
43: def recalib(p_ho_dummy, p_ext, yv, w):
44:     """절편/기울기 재보정 ? §2.10대로 5-fold 교차적합(cross-fit). 같은 표본에서 적합·적용하면
45:     순편익이 낙관적으로 부풀기 때문에 폴드 밖 예측만 사용한다."""
46:     from sklearn.model_selection import StratifiedKFold
47:     lp=np.log(np.clip(p_ext,1e-6,1-1e-6)/(1-np.clip(p_ext,1e-6,1-1e-6))).reshape(-1,1)
48:     oof=np.zeros(len(p_ext))
49:     for tri,tei in StratifiedKFold(5,shuffle=True,random_state=SEED).split(lp,yv):
50:         lr=LogisticRegression(penalty=None).fit(lp[tri],yv[tri],sample_weight=w[tri])
51:         oof[tei]=lr.predict_proba(lp[tei])[:,1]
52:     return oof
53: 
54: rows=[]; nb_rows=[]
55: for tag,(NU,BI,CA) in [("17-predictor",(NUM,BIN,CAT)),("5-item",(NUM5,BIN5,CAT5)),("7-item",(NUM8,BIN8,CAT8))]:
56:     c,m,fe=train(NU,BI,CA)
57:     sets={"Internal":(kchs.iloc[ho],), "NHANES pre":(pre,), "NHANES post":(post,)}
58:     for nm,(d,) in sets.items():
59:         p=m.predict_proba(c.transform(d[fe]))[:,1]; yv=d["dep"].astype(int).values; w=d["W"].astype(float).values
60:         for target in [0.85,0.90]:
61:             t=sens_at(yv,p,w,target); s,sp,ppv,npv,flag,nns=metrics(yv,p,w,t)
62:             rows.append((tag,nm,f"sens?{target:.2f}",round(s,3),round(sp,3),round(ppv,3),round(npv,3),round(flag,3),round(nns,1)))
63:         # 순편익(재보정 후) ? 외부만 재보정, 내부는 자체
64:         pc=recalib(None,p,yv,w)
65:         prev=np.average(yv,weights=w)
66:         for pt in [0.10,0.15]:
67:             TPr=w[(yv==1)&(pc>=pt)].sum()/w.sum(); FPr=w[(yv==0)&(pc>=pt)].sum()/w.sum()
68:             nb=TPr-FPr*(pt/(1-pt)); nb_all=prev-(1-prev)*(pt/(1-pt)); flag=(pc>=pt).astype(float)
69:             flagr=w[pc>=pt].sum()/w.sum()
70:             # 기본전략 2종: screen-all(nb_all, 음수 가능) / screen-none(0). 임상적 유용성 = 두 기본전략을 모두 상회.
71:             nb_rows.append((tag,nm,f"pt={pt:.2f}",round(nb,4),round(nb_all,4),round(nb-nb_all,4),round(nb-max(nb_all,0.0),4),round(flagr,3)))
72: 
73: op=pd.DataFrame(rows,columns=["model","set","operating point","sens","spec","PPV","NPV","flag rate","NNS"])
74: nb=pd.DataFrame(nb_rows,columns=["model","set","threshold","net benefit","screen-all NB","NB vs screen-all","NB vs best default","flag rate"])
75: op.to_csv(f"{D}/results/table_s4_operating.csv",index=False,encoding="utf-8-sig")
76: nb.to_csv(f"{D}/results/table_s4_netbenefit.csv",index=False,encoding="utf-8-sig")
77: print("=== 고민감도 트리아지 운영지점 (가중) ===")
78: print(op.to_string(index=False))
79: print("\n=== 순편익 (재보정 후, 가중) ===")
80: print(nb.to_string(index=False))
81: print("\n저장: results/table_s4_operating.csv, table_s4_netbenefit.csv")

===== 49_continuous_score.py =====
1: # -*- coding: utf-8 -*-
2: """49_continuous_score.py ? 프로토콜이 사전지정한 '연속점수' 민감도 분석(미이행분 이행).
3: 
4: 프로토콜 원문: "Sensitivity analyses use a ≥5 cut-off and the continuous score."
5: 컷오프 ≥5는 이미 수행되었으나 연속점수 분석은 누락되어 있었다.
6: 
7: (a) 배포된 이진 분류모델이 연속 PHQ-9 총점을 얼마나 잘 순위화하는가 (가중 Spearman)
8: (b) 동일 예측변수로 연속 총점을 직접 학습한 회귀모델의 내부·외부 성능 (가중 Spearman, R²)
9: 
10: 출력: results/continuous_score.csv
11: """
12: import sys, warnings, numpy as np, pandas as pd
13: sys.stdout.reconfigure(encoding="utf-8"); warnings.filterwarnings("ignore")
14: from sklearn.model_selection import train_test_split
15: from sklearn.compose import ColumnTransformer
16: from sklearn.pipeline import Pipeline
17: from sklearn.impute import SimpleImputer
18: from sklearn.preprocessing import StandardScaler, OneHotEncoder
19: import lightgbm as lgb
20: 
21: D = r"C:/Users/rudtn/Desktop/claude code/지역사회건강/17var_model"; RES = f"{D}/results"; SEED = 42
22: kchs = pd.read_parquet(f"{D}/data/ext_kchs.parquet"); pre = pd.read_parquet(f"{D}/data/ext_pre.parquet"); post = pd.read_parquet(f"{D}/data/ext_post.parquet")
23: NUM = ["age","sleep_hrs","bmi","income_q","srh","oral_health"]
24: BIN = ["partnered","living_alone","current_drinker","active","htn","dm","employed","food_insecure"]
25: CAT = ["sex","edu","smoking"]; FE = NUM+BIN+CAT
26: y = kchs["dep"].astype(int).values
27: P = dict(num_leaves=31, min_child_samples=1000, learning_rate=0.01, n_estimators=900, reg_alpha=1.0,
28:          reg_lambda=20.0, subsample=0.6, colsample_bytree=0.6, random_state=SEED, n_jobs=-1, verbose=-1)
29: def make_ct():
30:     return ColumnTransformer([("num", Pipeline([("i",SimpleImputer(strategy="median")),("s",StandardScaler())]), NUM),
31:                               ("bin","passthrough",BIN),
32:                               ("cat", Pipeline([("i",SimpleImputer(strategy="most_frequent")),("o",OneHotEncoder(handle_unknown="ignore",drop="first"))]), CAT)])
33: 
34: def wspearman(a, b, w):
35:     ra = pd.Series(a).rank().to_numpy(); rb = pd.Series(b).rank().to_numpy()
36:     ma = np.average(ra, weights=w); mb = np.average(rb, weights=w)
37:     ca = ra-ma; cb = rb-mb
38:     return float(np.sum(w*ca*cb) / np.sqrt(np.sum(w*ca*ca)*np.sum(w*cb*cb)))
39: def wr2(ytrue, ypred, w):
40:     m = np.average(ytrue, weights=w)
41:     return float(1 - np.sum(w*(ytrue-ypred)**2)/np.sum(w*(ytrue-m)**2))
42: 
43: tr, ho = train_test_split(np.arange(len(kchs)), train_size=500000, test_size=100000, stratify=y, random_state=SEED)
44: clf = Pipeline([("pre", make_ct()), ("clf", lgb.LGBMClassifier(**P))]).fit(kchs.iloc[tr][FE], y[tr])
45: sc = pd.to_numeric(kchs["phq_sum"]).to_numpy(float)
46: reg = Pipeline([("pre", make_ct()), ("clf", lgb.LGBMRegressor(**P))]).fit(kchs.iloc[tr][FE], sc[tr])
47: 
48: rows = []
49: for nm, d, s_col in [("Internal(hold-out)", kchs.iloc[ho], sc[ho]),
50:                      ("NHANES pre", pre, pd.to_numeric(pre["phq_sum"]).to_numpy(float)),
51:                      ("NHANES post", post, pd.to_numeric(post["phq_sum"]).to_numpy(float))]:
52:     w = d["W"].to_numpy(float)
53:     p_clf = clf.predict_proba(d[FE])[:,1]
54:     p_reg = reg.predict(d[FE])
55:     r_clf = wspearman(p_clf, s_col, w)
56:     r_reg = wspearman(p_reg, s_col, w)
57:     r2 = wr2(s_col, p_reg, w)
58:     print(f"  {nm:<20} 분류모델 순위상관 ρ={r_clf:.3f} | 연속회귀 ρ={r_reg:.3f}, R²={r2:.3f}  (평균 PHQ-9 {np.average(s_col,weights=w):.2f})", flush=True)
59:     rows.append(dict(set=nm, spearman_classifier=round(r_clf,3), spearman_regressor=round(r_reg,3),
60:                      R2_regressor=round(r2,3), mean_phq9=round(float(np.average(s_col,weights=w)),2)))
61: pd.DataFrame(rows).to_csv(f"{RES}/continuous_score.csv", index=False, encoding="utf-8-sig")
62: print("\n저장: results/continuous_score.csv\n완료.", flush=True)

===== 51_sap_compliance.py =====
1: # -*- coding: utf-8 -*-
2: """51_sap_compliance.py ? 사전 통계분석계획서(SAP) 규칙 대조 산출.
3: 
4: SAP §9.5(주모델 선택): 1순위 CV-AUROC 최대 → **ΔAUROC<0.005면 동률**로 보고 2순위 보정기울기가 1에 근접한 모델.
5:   실측: LightGBM 0.8396 vs RF 0.8350 → Δ=0.0046 < 0.005 ⇒ 동률 조항 발동. 두 모델의 CV 보정기울기를 산출해 규칙대로 판정한다.
6: SAP §14(민감도 사전목록): '음주 대안 정의' 미이행 → 현재 음주(current_drinker) 대신 연간 음주빈도/폭음을 쓴 대안 정의를 산출한다.
7: 
8: 출력: results/sap_tiebreak.csv, results/sap_alcohol_alt.csv
9: """
10: import sys, warnings, numpy as np, pandas as pd
11: sys.stdout.reconfigure(encoding="utf-8"); warnings.filterwarnings("ignore")
12: from sklearn.model_selection import train_test_split, StratifiedKFold, cross_val_predict
13: from sklearn.compose import ColumnTransformer
14: from sklearn.pipeline import Pipeline
15: from sklearn.impute import SimpleImputer
16: from sklearn.preprocessing import StandardScaler, OneHotEncoder
17: from sklearn.linear_model import LogisticRegression
18: from sklearn.ensemble import RandomForestClassifier
19: from sklearn.metrics import roc_auc_score
20: import lightgbm as lgb
21: 
22: D = r"C:/Users/rudtn/Desktop/claude code/지역사회건강/17var_model"; RES = f"{D}/results"; SEED = 42
23: kchs = pd.read_parquet(f"{D}/data/ext_kchs.parquet"); pre = pd.read_parquet(f"{D}/data/ext_pre.parquet"); post = pd.read_parquet(f"{D}/data/ext_post.parquet")
24: NUM = ["age","sleep_hrs","bmi","income_q","srh","oral_health"]
25: BIN = ["partnered","living_alone","current_drinker","active","htn","dm","employed","food_insecure"]
26: CAT = ["sex","edu","smoking"]; FE = NUM+BIN+CAT
27: y = kchs["dep"].astype(int).values
28: LGB = dict(num_leaves=31, min_child_samples=1000, learning_rate=0.01, n_estimators=900, reg_alpha=1.0,
29:            reg_lambda=20.0, subsample=0.6, colsample_bytree=0.6, random_state=SEED, n_jobs=-1, verbose=-1)
30: def make_ct(NU, BI, CA, native=True):
31:     return ColumnTransformer([("num", Pipeline([("i",SimpleImputer(strategy="median")),("s",StandardScaler())]), NU),
32:                               ("bin","passthrough" if native else SimpleImputer(strategy="most_frequent",add_indicator=True), BI),
33:                               ("cat", Pipeline([("i",SimpleImputer(strategy="most_frequent")),("o",OneHotEncoder(handle_unknown="ignore",drop="first"))]), CA)])
34: def cal_slope(yv,p):
35:     p=np.clip(p,1e-6,1-1e-6); lp=np.log(p/(1-p)).reshape(-1,1)
36:     return float(LogisticRegression(penalty=None,solver="lbfgs").fit(lp,yv).coef_[0,0])
37: 
38: tr, ho = train_test_split(np.arange(len(kchs)), train_size=500000, test_size=100000, stratify=y, random_state=SEED)
39: 
40: # ?? SAP §9.5 동률 판정 ??
41: print("="*80); print("[SAP §9.5] 동률(ΔAUROC<0.005) 판정 ? 알고리즘 비교와 동일 프로토콜(5-fold, 20만)"); print("="*80, flush=True)
42: sub = np.random.RandomState(SEED).permutation(tr)[:200000]
43: Xs, ys_ = kchs.iloc[sub], y[sub]
44: skf = StratifiedKFold(5, shuffle=True, random_state=SEED)
45: BEST = {
46:  "LightGBM": Pipeline([("pre", make_ct(NUM,BIN,CAT)), ("clf", lgb.LGBMClassifier(**LGB))]),
47:  "Random forest": Pipeline([("pre", make_ct(NUM,BIN,CAT)), ("clf", RandomForestClassifier(n_estimators=300, max_depth=14, min_samples_leaf=100, random_state=SEED, n_jobs=-1))]),
48:  "Elastic net": Pipeline([("pre", make_ct(NUM,BIN,CAT,native=False)), ("clf", LogisticRegression(penalty="elasticnet", solver="saga", C=1.0, l1_ratio=0.5, max_iter=300, n_jobs=-1))]),
49: }
50: rows=[]
51: for nm, mdl in BEST.items():
52:     oof = cross_val_predict(mdl, Xs[FE], ys_, cv=skf, method="predict_proba", n_jobs=-1)[:,1]
53:     a = roc_auc_score(ys_, oof); sl = cal_slope(ys_, oof)
54:     print(f"   {nm:<15} CV-AUROC {a:.4f}   보정기울기 {sl:.4f}   |slope-1| {abs(sl-1):.4f}", flush=True)
55:     rows.append(dict(algorithm=nm, cv_auroc=round(a,4), cal_slope=round(sl,4), abs_slope_minus_1=round(abs(sl-1),4)))
56: df = pd.DataFrame(rows).sort_values("cv_auroc", ascending=False).reset_index(drop=True)
57: top = df.iloc[0]; tied = df[df.cv_auroc >= top.cv_auroc - 0.005]
58: print(f"\n   1순위 {top.algorithm} (AUROC {top.cv_auroc:.4f}) · 동률권(Δ<0.005) {list(tied.algorithm)}")
59: win = tied.sort_values("abs_slope_minus_1").iloc[0]
60: print(f"   → SAP §9.5 규칙 적용 결과: 보정기울기 기준 승자 = **{win.algorithm}** (|slope-1|={win.abs_slope_minus_1:.4f})", flush=True)
61: df["in_tie_band"] = df.cv_auroc >= top.cv_auroc - 0.005
62: df["selected_by_SAP_rule"] = df.algorithm == win.algorithm
63: df.to_csv(f"{RES}/sap_tiebreak.csv", index=False, encoding="utf-8-sig")
64: 
65: # ?? SAP §14 음주 대안 정의 ??
66: print("\n" + "="*80); print("[SAP §14] 음주 대안 정의 민감도 (사전목록 중 미이행분)"); print("="*80, flush=True)
67: Who, yho = kchs.iloc[ho]["W"].to_numpy(float), y[ho]
68: Wp, Ws = pre["W"].to_numpy(float), post["W"].to_numpy(float)
69: yp, ys2 = pre["dep"].astype(int).values, post["dep"].astype(int).values
70: def run(NU, BI, CA, label):
71:     F = NU+BI+CA
72:     m = Pipeline([("pre", make_ct(NU,BI,CA)), ("clf", lgb.LGBMClassifier(**LGB))]).fit(kchs.iloc[tr][F], y[tr])
73:     i = roc_auc_score(yho, m.predict_proba(kchs.iloc[ho][F])[:,1], sample_weight=Who)
74:     p = roc_auc_score(yp,  m.predict_proba(pre[F])[:,1],  sample_weight=Wp)
75:     s = roc_auc_score(ys2, m.predict_proba(post[F])[:,1], sample_weight=Ws)
76:     print(f"   {label:<44} 내부 {i:.4f}  pre {p:.4f}  post {s:.4f}", flush=True)
77:     return dict(cond=label, internal=round(i,4), ext_pre=round(p,4), ext_post=round(s,4))
78: arows = [run(NUM, BIN, CAT, "기준(현재 음주 여부)")]
79: arows.append(run(NUM+["alcohol_freq"], [b for b in BIN if b!="current_drinker"], CAT, "대안 A: 연간 음주빈도(연속)로 대체"))
80: arows.append(run(NUM, [b for b in BIN if b!="current_drinker"]+["binge"], CAT, "대안 B: 폭음 여부로 대체"))
81: arows.append(run(NUM+["alcohol_freq"], BIN+["binge"], CAT, "대안 C: 현재음주+빈도+폭음 모두 포함"))
82: pd.DataFrame(arows).to_csv(f"{RES}/sap_alcohol_alt.csv", index=False, encoding="utf-8-sig")
83: print("\n저장: results/sap_tiebreak.csv, sap_alcohol_alt.csv\n완료.", flush=True)

===== 60_verify_manuscript.py =====
1: # -*- coding: utf-8 -*-
2: """60_verify_manuscript.py ? 원고 수치의 기계 검증 (반복 실행해도 같은 결과가 나오게 하는 장치).
3: 
4: 문제의식: 재계산으로 숫자가 바뀔 때마다 7개 문서에 손으로 옮겨 적어서 세대 혼재·출처 불일치가 반복됐다.
5: 해결: "정본 결과 파일 → 기대 문자열"을 코드로 정의하고, 문서에 그 문자열이 실제로 있는지 기계적으로 확인한다.
6:       또한 폐기된(superseded) 결과 파일 이름이 어느 문서에도 인용되지 않는지 확인한다.
7: 
8: 사용: python 60_verify_manuscript.py    → 실패 항목이 있으면 exit code 1
9: """
10: import io, os, re, sys, glob
11: import pandas as pd
12: from decimal import Decimal, ROUND_HALF_UP
13: sys.stdout.reconfigure(encoding="utf-8")
14: 
15: def R(v, nd=3):
16:     """보고 관례에 맞춘 half-up 반올림. Python의 기본 서식은 이진 표현 탓에 0.8075→0.807처럼 내려간다."""
17:     q = Decimal(1).scaleb(-nd)
18:     return f"{Decimal(str(v)).quantize(q, rounding=ROUND_HALF_UP):.{nd}f}"
19: 
20: D = os.path.dirname(os.path.abspath(__file__))
21: RES = f"{D}/results"; DOCS = f"{D}/docs"
22: def rd(name): return pd.read_csv(f"{RES}/{name}")
23: def doc(name): return io.open(f"{DOCS}/{name}", encoding="utf8").read()
24: 
25: M   = doc("manuscript_17var.md")
26: A1  = doc("TRIPOD_AI_checklist.md"); A2 = doc("appendix2_crosswalk.md")
27: A3  = doc("appendix3_utility.md");   A4 = doc("appendix4_ceiling.md")
28: MC  = doc("model_card_17var.md");    CL = doc("cover_letter.md"); LG = doc("evidence_ledger.md")
29: ALLDOCS = {"manuscript": M, "appendix1": A1, "appendix2": A2, "appendix3": A3,
30:            "appendix4": A4, "model_card": MC, "cover_letter": CL, "ledger": LG}
31: 
32: fails, checks = [], 0
33: def need(cond, label):
34:     global checks; checks += 1
35:     if not cond: fails.append(label)
36: 
37: def in_doc(token, where=("manuscript",), label=None):
38:     """token 문자열이 지정 문서들에 존재하는지."""
39:     lab = label or token
40:     for w in where:
41:         need(token in ALLDOCS[w], f"[{w}] missing: {lab}")
42: 
43: # ??????????????????????????????????????????????????????????????????????
44: # 1. 정본 파일 → 기대 문자열
45: # ??????????????????????????????????????????????????????????????????????
46: m3 = rd("review3_metrics.csv"); m3r = m3[m3.setting.str.startswith("year")].iloc[0]
47: m2 = rd("review2_metrics.csv").set_index("set")
48: g  = rd("review2_gain.csv").set_index("set")
49: f  = rd("review3_fairness_domain.csv")
50: o  = rd("review3_oracle_ci.csv"); best = o.sort_values("oracle_AUROC").iloc[-1]
51: pc = rd("parsimonious_clean.csv").set_index("k")
52: op = rd("review2_operating.csv"); opy = op[op.threshold.str.startswith("Youden")].set_index("set")
53: sh = rd("shap_importance_train.csv").set_index(rd("shap_importance_train.csv").columns[0]).iloc[:,0]
54: pv = rd("review2_prevalence.csv").set_index("cohort")
55: ov = rd("review2_overlap.csv").iloc[0]
56: cs = rd("continuous_score.csv").set_index("set")
57: tb = rd("sap_tiebreak.csv").set_index("algorithm")
58: al = rd("sap_alcohol_alt.csv")
59: sen= rd("final_sensitivity.csv").set_index("cond")
60: ch = rd("characteristics_availablecase.csv").set_index("characteristic")
61: nb = rd("table_s4_netbenefit.csv")
62: to = rd("table_s4_operating.csv")
63: bv = rd("bootstrap_validation.csv").set_index("cohort")
64: 
65: # 내부/외부 판별력·CI
66: in_doc(f"0.832 (95% CI {R(m3r.AUROC_lo)}?{R(m3r.AUROC_hi)})", ("manuscript",), "internal AUROC+CI")
67: in_doc(f"| 95% CI | {R(m3r.AUROC_lo)}?{R(m3r.AUROC_hi)} | {R(m2.loc['NHANES pre','CI_lo'])}?{R(m2.loc['NHANES pre','CI_hi'])} | ? | {R(m2.loc['NHANES post','CI_lo'])}?{R(m2.loc['NHANES post','CI_hi'])} | ? |",
68:        ("manuscript",), "Table 2 AUROC CI row")
69: in_doc(f"| 95% CI | {R(m3r.AUPRC_lo)}?{R(m3r.AUPRC_hi)} | {R(m2.loc['NHANES pre','AUPRC_lo'])}?{R(m2.loc['NHANES pre','AUPRC_hi'])} | ? | {R(m2.loc['NHANES post','AUPRC_lo'])}?{R(m2.loc['NHANES post','AUPRC_hi'])} | ? |",
70:        ("manuscript",), "Table 2 AUPRC CI row")
71: in_doc(f"| CITL | +{R(m2.loc['Internal(hold-out)','CITL'],2)} | +{R(m2.loc['NHANES pre','CITL'],2)} | 0.00 | +{R(m2.loc['NHANES post','CITL'],2)} | 0.00 |",
72:        ("manuscript",), "Table 2 CITL row")
73: # 모델카드도 같은 CI
74: in_doc(f"0.832 ({R(m3r.AUROC_lo)}?{R(m3r.AUROC_hi)})", ("model_card",), "model card internal CI")
75: in_doc(f"0.772 ({R(m2.loc['NHANES pre','CI_lo'])}?{R(m2.loc['NHANES pre','CI_hi'])})", ("model_card",), "model card pre CI")
76: in_doc(f"0.769 ({R(m2.loc['NHANES post','CI_lo'])}?{R(m2.loc['NHANES post','CI_hi'])})", ("model_card",), "model card post CI")
77: 
78: # 14→17 이득
79: for st, lab in [("NHANES pre","pre"), ("NHANES post","post")]:
80:     r = g.loc[st]
81:     in_doc(f"Δ+{R(r.delta)}, 95% CI +{R(r.CI_lo)} to +{R(r.CI_hi)}", ("manuscript",), f"gain {lab}")
82: 
83: # 오라클
84: in_doc(f"0.765?0.772 (best learner {R(best.oracle_AUROC)}, 95% CI {R(best.CI_lo)}?{R(best.CI_hi)}",
85:        ("manuscript",), "oracle range+CI")
86: for _, r in o.iterrows():
87:     in_doc(f"| {r.learner} | {R(r.oracle_AUROC)} | {R(r.CI_lo)}?{R(r.CI_hi)} |", ("appendix4",), f"oracle table {r.learner}")
88: 
89: # 경량모델
90: in_doc(f"hold-out AUROC **{R(pc.loc[5,'holdout_AUROC'])}**, NHANES pre **{R(pc.loc[5,'ext_pre'])}** and NHANES post **{R(pc.loc[5,'ext_post'])}**",
91:        ("manuscript",), "5-item evaluation")
92: in_doc(f"hold-out {R(pc.loc[7,'holdout_AUROC'])} and external {R(pc.loc[7,'ext_pre'])} (pre) and {R(pc.loc[7,'ext_post'])} (post)",
93:        ("manuscript",), "7-item evaluation")
94: for k in pc.index:
95:     need(f"| {k} |" in A3 or f"| **{k}** |" in A3, f"[appendix3] Table S8 missing row k={k}")
96: 
97: # Youden (정확)
98: in_doc(f"{R(opy.loc['Internal','sens'])}/{R(opy.loc['Internal','spec'])} (internal), {R(opy.loc['NHANES pre','sens'])}/{R(opy.loc['NHANES pre','spec'])} (NHANES pre), and {R(opy.loc['NHANES post','sens'])}/{R(opy.loc['NHANES post','spec'])}",
99:        ("manuscript",), "exact Youden points")
100: 
101: # SHAP (학습셋 기준)
102: rank = {v: i+1 for i, v in enumerate(sh.sort_values(ascending=False).index)}
103: in_doc(f"self-rated health (mean |SHAP| {R(sh['srh'],2)})", ("manuscript",), "SHAP srh")
104: in_doc(f"({R(sh['food_insecure'],2)}, ranked {rank['food_insecure']}th)", ("manuscript",), "SHAP food insecurity rank")
105: 
106: # 하위군: 모든 CI가 원고 또는 Table S9에 정확히 존재
107: for _, r in f.iterrows():
108:     tok = f"{R(r.CI_lo)}?{R(r.CI_hi)}"
109:     need(tok in A3, f"[appendix3] Table S9 missing CI {r.cohort}/{r.subgroup} {tok}")
110:     if "Education" not in str(r.subgroup):
111:         need(tok in M, f"[manuscript] §3.8 missing CI {r.cohort}/{r.subgroup} {tok}")
112: 
113: # 유병률·중첩·연속점수·특성
114: in_doc(f"{R(pv.loc['KCHS','available_case_pct'],1)}% in KCHS vs {R(pv.loc['NHANES pre','available_case_pct'],1)}% and {R(pv.loc['NHANES post','available_case_pct'],1)}%",
115:        ("manuscript",), "food insecurity available-case")
