===== 52_subgroup_ci_fix.py =====
1: # -*- coding: utf-8 -*-
2: """52_subgroup_ci_fix.py ? 하위군 CI의 단일 PSU 층(singleton stratum) 처리.
3: 
4: 문제: 전체 코호트에서는 층당 PSU가 2개 이상이지만, 하위군으로 자르면 층당 PSU가 1개인 층이 생긴다
5:       (예: NHANES pre 'Mexican American'은 23개 층 중 5개가 단일). 재척도 부트스트랩에서 단일 층을
6:       그대로 두면 그 층의 분산 기여가 0이 되어 하위군 CI가 좁아진다.
7: 해결: 단일 PSU 층들을 하나의 유사층(pseudo-stratum)으로 통합해 재표집한다(설문 분석의 표준 처리).
8: 
9: 출력: results/review3_fairness.csv  (하위군 AUROC·CI·보정slope·CITL, singleton 통합 적용)
10: """
11: import sys, warnings, numpy as np, pandas as pd
12: sys.stdout.reconfigure(encoding="utf-8"); warnings.filterwarnings("ignore")
13: from sklearn.model_selection import train_test_split
14: from sklearn.compose import ColumnTransformer
15: from sklearn.pipeline import Pipeline
16: from sklearn.impute import SimpleImputer
17: from sklearn.preprocessing import StandardScaler, OneHotEncoder
18: from sklearn.linear_model import LogisticRegression
19: from sklearn.metrics import roc_auc_score
20: import lightgbm as lgb
21: 
22: D = r"C:/Users/rudtn/Desktop/claude code/지역사회건강/17var_model"; RES = f"{D}/results"; SEED = 42
23: kchs = pd.read_parquet(f"{D}/data/ext_kchs.parquet"); pre = pd.read_parquet(f"{D}/data/ext_pre.parquet"); post = pd.read_parquet(f"{D}/data/ext_post.parquet")
24: NUM=["age","sleep_hrs","bmi","income_q","srh","oral_health"]
25: BIN=["partnered","living_alone","current_drinker","active","htn","dm","employed","food_insecure"]
26: CAT=["sex","edu","smoking"]; FE=NUM+BIN+CAT
27: y=kchs["dep"].astype(int).values
28: LGB=dict(num_leaves=31,min_child_samples=1000,learning_rate=0.01,n_estimators=900,reg_alpha=1.0,
29:          reg_lambda=20.0,subsample=0.6,colsample_bytree=0.6,random_state=SEED,n_jobs=-1,verbose=-1)
30: def make_ct():
31:     return ColumnTransformer([("num",Pipeline([("i",SimpleImputer(strategy="median")),("s",StandardScaler())]),NUM),
32:                               ("bin","passthrough",BIN),
33:                               ("cat",Pipeline([("i",SimpleImputer(strategy="most_frequent")),("o",OneHotEncoder(handle_unknown="ignore",drop="first"))]),CAT)])
34: 
35: class RaoWuBoot:
36:     """층 h에서 m_h=n_h-1개 PSU 복원추출 + 가중치 재척도.
37:        단일 PSU 층은 하나의 유사층으로 통합해 분산 기여가 사라지지 않게 한다."""
38:     def __init__(self, strata, psu, w, pool_singletons=True):
39:         st = pd.Series(strata).astype(str).reset_index(drop=True)
40:         ps = pd.Series(psu).astype(str).reset_index(drop=True)
41:         if pool_singletons:
42:             npsu = pd.DataFrame({"s":st,"p":ps}).drop_duplicates().groupby("s").size()
43:             single = set(npsu[npsu==1].index)
44:             st = st.where(~st.isin(single), "__SINGLETON_POOL__")
45:         cl = pd.factorize(st + "|" + ps)[0]
46:         sid = pd.factorize(st)[0]
47:         self.cl = cl; self.w = np.asarray(w, float)
48:         C = cl.max()+1; self.C = C
49:         cl_stratum = np.zeros(C, dtype=int); cl_stratum[cl] = sid; self.cl_stratum = cl_stratum
50:         self.n_h = np.bincount(cl_stratum); self.m_h = np.maximum(self.n_h-1, 1)
51:         o = np.argsort(cl_stratum, kind="stable"); self.cl_sorted = o
52:         s_sorted = cl_stratum[o]; sc = np.bincount(s_sorted)
53:         st_start = np.concatenate([[0], np.cumsum(sc)])[:-1]
54:         self.slot_start = st_start[s_sorted]; self.slot_n = sc[s_sorted]
55:         self.singleton = self.n_h[cl_stratum] == 1
56:         self.n_singleton_strata = int((self.n_h==1).sum())
57:     def weights(self, rng):
58:         r = np.zeros(self.C)
59:         draws = rng.random_sample(self.C)
60:         idx = np.arange(self.C) - self.slot_start
61:         keep = idx < self.m_h[self.cl_stratum[self.cl_sorted]]
62:         sel = np.where(keep)[0]
63:         pick = self.slot_start[sel] + (draws[sel]*self.slot_n[sel]).astype(int)
64:         np.add.at(r, self.cl_sorted[pick], 1.0)
65:         scale = np.where(self.singleton, 1.0, (self.n_h[self.cl_stratum]/self.m_h[self.cl_stratum])*r)
66:         return self.w * scale[self.cl]
67: 
68: def logit(p): p=np.clip(p,1e-6,1-1e-6); return np.log(p/(1-p))
69: def cal_slope(yv,p,w): return float(LogisticRegression(penalty=None,solver="lbfgs").fit(logit(p).reshape(-1,1),yv,sample_weight=w).coef_[0,0])
70: def citl(yv,p,w):
71:     lp=logit(p); a=0.0
72:     for _ in range(200):
73:         mu=1/(1+np.exp(-(a+lp))); g=np.sum(w*(yv-mu)); h=np.sum(w*mu*(1-mu))
74:         if h<=0: break
75:         s=g/h; a+=s
76:         if abs(s)<1e-10: break
77:     return float(a)
78: 
79: tr, ho = train_test_split(np.arange(len(kchs)), train_size=500000, test_size=100000, stratify=y, random_state=SEED)
80: model = Pipeline([("pre",make_ct()),("clf",lgb.LGBMClassifier(**LGB))]).fit(kchs.iloc[tr][FE], y[tr])
81: dho=kchs.iloc[ho].copy(); dho["_p"]=model.predict_proba(dho[FE])[:,1]
82: prd=pre.copy();  prd["_p"]=model.predict_proba(pre[FE])[:,1]
83: pod=post.copy(); pod["_p"]=model.predict_proba(post[FE])[:,1]
84: age=pd.to_numeric(dho["age"])
85: RACE={1:"Mexican American",2:"Other Hispanic",3:"Non-Hispanic White",4:"Non-Hispanic Black",6:"Non-Hispanic Asian",7:"Other/multiracial"}
86: groups=[("KCHS hold-out","Sex: female",dho,dho["sex"]=="F"),("KCHS hold-out","Sex: male",dho,dho["sex"]=="M"),
87:         ("KCHS hold-out","Age 20-39",dho,age<40),("KCHS hold-out","Age 40-59",dho,(age>=40)&(age<60)),("KCHS hold-out","Age 60+",dho,age>=60),
88:         ("KCHS hold-out","Education: college",dho,dho["edu"]=="college"),("KCHS hold-out","Education: high school",dho,dho["edu"]=="high"),
89:         ("KCHS hold-out","Education: middle",dho,dho["edu"]=="middle"),("KCHS hold-out","Education: <=elementary",dho,dho["edu"]=="elem_low")]
90: for c,l in RACE.items():
91:     groups.append(("NHANES pre",f"Race: {l}",prd,prd["race"]==c))
92:     groups.append(("NHANES post",f"Race: {l}",pod,pod["race"]==c))
93: 
94: print("="*92); print("[하위군] 단일 PSU 층 통합 적용 · 재척도 부트스트랩 CI"); print("="*92, flush=True)
95: rows=[]
96: for coh,lab,src,mask in groups:
97:     d=src[mask]
98:     if d["dep"].nunique()<2 or len(d)<100: continue
99:     yv=d["dep"].astype(int).values; w=d["W"].to_numpy(float); p=d["_p"].values
100:     a=roc_auc_score(yv,p,sample_weight=w)
101:     out={}
