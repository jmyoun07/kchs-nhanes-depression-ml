3: 가중(설계) 기반. 재보정(Platt)은 배포 시나리오로 순편익 계산에만 사용(외부라벨=지역재보정, 공개됨)."""
4: import sys, warnings, numpy as np, pandas as pd
5: sys.stdout.reconfigure(encoding="utf-8"); warnings.filterwarnings("ignore")
6: from sklearn.model_selection import train_test_split
7: from sklearn.compose import ColumnTransformer
8: from sklearn.pipeline import Pipeline
9: from sklearn.impute import SimpleImputer
10: from sklearn.preprocessing import StandardScaler, OneHotEncoder
11: from sklearn.linear_model import LogisticRegression
12: import lightgbm as lgb
13: SEED=42; D="C:/Users/rudtn/Desktop/claude code/지역사회건강/17var_model"
14: NUM=["age","sleep_hrs","bmi","income_q","srh","oral_health"]; BIN=["partnered","living_alone","current_drinker","active","htn","dm","employed","food_insecure"]; CAT=["sex","edu","smoking"]
15: FE17=NUM+BIN+CAT
16: # 배포모델 = 5문항 (사전지정 0.02 여유, 48_parsimonious_clean.py) / 7문항은 사후 변형
17: NUM5=["srh","age","sleep_hrs","oral_health"]; BIN5=[]; CAT5=["sex"]; FE5=NUM5+BIN5+CAT5
18: NUM8=["srh","age","sleep_hrs","oral_health"]; BIN8=["employed","partnered"]; CAT8=["sex"]; FE8=NUM8+BIN8+CAT8
19: LGB=dict(num_leaves=31,min_child_samples=1000,learning_rate=0.01,n_estimators=900,reg_alpha=1.0,reg_lambda=20.0,subsample=0.6,colsample_bytree=0.6,random_state=SEED,n_jobs=-1,verbose=-1)
20: kchs=pd.read_parquet(f"{D}/data/ext_kchs.parquet",columns=FE17+["dep","W"])
21: pre =pd.read_parquet(f"{D}/data/ext_pre.parquet", columns=FE17+["dep","W"])
22: post=pd.read_parquet(f"{D}/data/ext_post.parquet",columns=FE17+["dep","W"])
23: y=kchs["dep"].astype(int).values
24: tr,ho=train_test_split(np.arange(len(kchs)),train_size=500000,test_size=100000,stratify=y,random_state=SEED)
25: def ctf(NU,BI,CA): return ColumnTransformer([("num",Pipeline([("i",SimpleImputer(strategy="median")),("s",StandardScaler())]),NU),("bin","passthrough",BI),("cat",Pipeline([("i",SimpleImputer(strategy="most_frequent")),("o",OneHotEncoder(handle_unknown="ignore",drop="first"))]),CA)])
26: def train(NU,BI,CA):
27:     fe=NU+BI+CA; c=ctf(NU,BI,CA); m=lgb.LGBMClassifier(**LGB).fit(c.fit_transform(kchs.iloc[tr][fe]),y[tr])
28:     return c,m,fe
29: 
30: def wq(yv,p,w):  # 가중 지표 유틸
31:     return yv.astype(float),p,w.astype(float)
32: def sens_at(yv,p,w,target):
33:     # 양성자 점수의 가중 분위로 목표 민감도 임계 찾기
34:     pos=yv==1; order=np.argsort(-p[pos]); wp=w[pos][order]; cum=np.cumsum(wp)/wp.sum()
35:     k=int(np.searchsorted(cum,target)); k=min(k,len(order)-1)
36:     return p[pos][order][k]
37: def metrics(yv,p,w,t):
38:     P=w[(yv==1)&(p>=t)].sum(); FN=w[(yv==1)&(p<t)].sum(); FP=w[(yv==0)&(p>=t)].sum(); TN=w[(yv==0)&(p<t)].sum()
39:     sens=P/(P+FN) if P+FN>0 else 0; spec=TN/(TN+FP) if TN+FP>0 else 0
40:     ppv=P/(P+FP) if P+FP>0 else 0; npv=TN/(TN+FN) if TN+FN>0 else 0
41:     flag=(P+FP)/w.sum(); nns=1/ppv if ppv>0 else np.nan
42:     return sens,spec,ppv,npv,flag,nns
43: def recalib(p_ho_dummy, p_ext, yv, w):
44:     """절편/기울기 재보정 ? §2.10대로 5-fold 교차적합(cross-fit). 같은 표본에서 적합·적용하면
45:     순편익이 낙관적으로 부풀기 때문에 폴드 밖 예측만 사용한다."""
46:     from sklearn.model_selection import StratifiedKFold
47:     lp=np.log(np.clip(p_ext,1e-6,1-1e-6)/(1-np.clip(p_ext,1e-6,1-1e-6))).reshape(-1,1)
48:     oof=np.zeros(len(p_ext))
49:     for tri,tei in StratifiedKFold(5,shuffle=True,random_state=SEED).split(lp,yv):
50:         lr=LogisticRegression(penalty=None).fit(lp[tri],yv[tri],sample_weight=w[tri])
51:         oof[tei]=lr.predict_proba(lp[tei])[:,1]
52:     return oof
53: 
54: rows=[]; nb_rows=[]
55: for tag,(NU,BI,CA) in [("17-predictor",(NUM,BIN,CAT)),("5-item",(NUM5,BIN5,CAT5)),("7-item",(NUM8,BIN8,CAT8))]:
56:     c,m,fe=train(NU,BI,CA)
57:     sets={"Internal":(kchs.iloc[ho],), "NHANES pre":(pre,), "NHANES post":(post,)}
58:     for nm,(d,) in sets.items():
59:         p=m.predict_proba(c.transform(d[fe]))[:,1]; yv=d["dep"].astype(int).values; w=d["W"].astype(float).values
60:         for target in [0.85,0.90]:
61:             t=sens_at(yv,p,w,target); s,sp,ppv,npv,flag,nns=metrics(yv,p,w,t)
62:             rows.append((tag,nm,f"sens?{target:.2f}",round(s,3),round(sp,3),round(ppv,3),round(npv,3),round(flag,3),round(nns,1)))
63:         # 순편익(재보정 후) ? 외부만 재보정, 내부는 자체
64:         pc=recalib(None,p,yv,w)
65:         prev=np.average(yv,weights=w)
66:         for pt in [0.10,0.15]:
67:             TPr=w[(yv==1)&(pc>=pt)].sum()/w.sum(); FPr=w[(yv==0)&(pc>=pt)].sum()/w.sum()
68:             nb=TPr-FPr*(pt/(1-pt)); nb_all=prev-(1-prev)*(pt/(1-pt)); flag=(pc>=pt).astype(float)
69:             flagr=w[pc>=pt].sum()/w.sum()
70:             # 기본전략 2종: screen-all(nb_all, 음수 가능) / screen-none(0). 임상적 유용성 = 두 기본전략을 모두 상회.
71:             nb_rows.append((tag,nm,f"pt={pt:.2f}",round(nb,4),round(nb_all,4),round(nb-nb_all,4),round(nb-max(nb_all,0.0),4),round(flagr,3)))
72: 
73: op=pd.DataFrame(rows,columns=["model","set","operating point","sens","spec","PPV","NPV","flag rate","NNS"])
74: nb=pd.DataFrame(nb_rows,columns=["model","set","threshold","net benefit","screen-all NB","NB vs screen-all","NB vs best default","flag rate"])
75: op.to_csv(f"{D}/results/table_s4_operating.csv",index=False,encoding="utf-8-sig")
76: nb.to_csv(f"{D}/results/table_s4_netbenefit.csv",index=False,encoding="utf-8-sig")
77: print("=== 고민감도 트리아지 운영지점 (가중) ===")
78: print(op.to_string(index=False))
79: print("\n=== 순편익 (재보정 후, 가중) ===")
80: print(nb.to_string(index=False))
81: print("\n저장: results/table_s4_operating.csv, table_s4_netbenefit.csv")

