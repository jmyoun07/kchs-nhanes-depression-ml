117:        ("manuscript",), "hold-out PSU overlap")
118: in_doc(f"ρ={R(cs.loc['Internal(hold-out)','spearman_classifier'])} internally, {R(cs.loc['NHANES pre','spearman_classifier'])} pre-pandemic and {R(cs.loc['NHANES post','spearman_classifier'])} post-pandemic",
