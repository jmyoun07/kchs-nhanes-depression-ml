92: def logit(p): p=np.clip(p,1e-6,1-1e-6); return np.log(p/(1-p))
93: def cal_slope(yv,p,w): return float(LogisticRegression(penalty=None,solver="lbfgs").fit(logit(p).reshape(-1,1),yv,sample_weight=w).coef_[0,0])
94: def citl(yv,p,w):
95:     lp=logit(p); a=0.0
96:     for _ in range(200):
97:         mu=1/(1+np.exp(-(a+lp))); g=np.sum(w*(yv-mu)); h=np.sum(w*mu*(1-mu))
98:         if h<=0: break
99:         s=g/h; a+=s
100:         if abs(s)<1e-10: break
101:     return float(a)
102: def ece(yv,p,w,bins=10):
103:     q=np.quantile(p,np.linspace(0,1,bins+1)); q[0]-=1e-9; e=0.0; W=w.sum()
104:     for i in range(bins):
105:         m=(p>q[i])&(p<=q[i+1])
106:         if m.sum()==0: continue
107:         e+=w[m].sum()/W*abs(np.average(yv[m],weights=w[m])-np.average(p[m],weights=w[m]))
108:     return float(e)
