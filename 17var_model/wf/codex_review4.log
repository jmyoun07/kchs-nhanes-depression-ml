77: def boot_ci(d, p, fn, B=1000, seed=SEED):
78:     yv = d["dep"].astype(int).values
79:     rw = RaoWuBoot(d["strata"].values, d["psu"].values, d["W"].to_numpy(float))
80:     rng = np.random.RandomState(seed); a = []
81:     for _ in range(B):
82:         w = rw.weights(rng)
83:         m = w > 0
84:         if yv[m].min() == yv[m].max(): continue
85:         try: a.append(fn(yv, p, w))
86:         except Exception: pass
87:     a = np.array(a); return float(np.percentile(a, 2.5)), float(np.percentile(a, 97.5)), a
