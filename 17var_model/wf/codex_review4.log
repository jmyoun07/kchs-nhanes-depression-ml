36: class RaoWuBoot:
37:     """층 h에서 m_h=n_h-1개 PSU 복원추출 + w*(n_h/m_h)*r 재척도. 단일 PSU 층은 유사층으로 통합."""
38:     def __init__(self, strata, psu, w, pool_singletons=True):
39:         st=pd.Series(strata).astype(str).reset_index(drop=True); ps=pd.Series(psu).astype(str).reset_index(drop=True)
40:         if pool_singletons:
41:             npsu=pd.DataFrame({"s":st,"p":ps}).drop_duplicates().groupby("s").size()
42:             single=set(npsu[npsu==1].index)
43:             st=st.where(~st.isin(single),"__SINGLETON_POOL__")
44:         cl=pd.factorize(st+"|"+ps)[0]; sid=pd.factorize(st)[0]
45:         self.cl=cl; self.w=np.asarray(w,float); C=cl.max()+1; self.C=C
46:         cs=np.zeros(C,dtype=int); cs[cl]=sid; self.cl_stratum=cs
47:         self.n_h=np.bincount(cs); self.m_h=np.maximum(self.n_h-1,1)
48:         o=np.argsort(cs,kind="stable"); self.cl_sorted=o
49:         ss=cs[o]; sc=np.bincount(ss); start=np.concatenate([[0],np.cumsum(sc)])[:-1]
50:         self.slot_start=start[ss]; self.slot_n=sc[ss]; self.singleton=self.n_h[cs]==1
51:     def weights(self, rng):
52:         r=np.zeros(self.C); u=rng.random_sample(self.C)
53:         idx=np.arange(self.C)-self.slot_start
54:         sel=np.where(idx < self.m_h[self.cl_stratum[self.cl_sorted]])[0]
55:         pick=self.slot_start[sel]+(u[sel]*self.slot_n[sel]).astype(int)
56:         np.add.at(r,self.cl_sorted[pick],1.0)
57:         sc=np.where(self.singleton,1.0,(self.n_h[self.cl_stratum]/self.m_h[self.cl_stratum])*r)
58:         return self.w*sc[self.cl]
59: 
60: def rep_weights(d, strata, B=1000, seed=SEED):
61:     rw=RaoWuBoot(strata, d["psu"].values, d["W"].to_numpy(float))
62:     rng=np.random.RandomState(seed)
63:     return [rw.weights(rng) for _ in range(B)]
