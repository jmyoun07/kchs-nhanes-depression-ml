class ClusterBoot:
 def __init__(self,strata,psu):
  cl=pd.factorize(pd.Series(strata).astype(str)+'|'+pd.Series(psu).astype(str))[0];st=pd.factorize(pd.Series(strata).astype(str))[0];order=np.argsort(cl,kind='stable');self.members=order;self.counts=np.bincount(cl);self.offs=np.r_[0,np.cumsum(self.counts)];first=np.zeros(len(self.counts),dtype=int);first[cl[order]]=st[order];o2=np.argsort(first,kind='stable');self.cl_sorted=o2;sc=np.bincount(first[o2]);st_start=np.r_[0,np.cumsum(sc)][:-1];self.slot_start=st_start[first[o2]];self.slot_n=sc[first[o2]];self.C=len(self.counts)
 def draw(self,rng):
  cs=self.cl_sorted[self.slot_start+(rng.random_sample(self.C)*self.slot_n).astype(int)];L=self.counts[cs];tot=int(L.sum());return self.members[np.repeat(self.offs[cs],L)+np.arange(tot)-np.repeat(np.r_[0,np.cumsum(L)][:-1],L)]
