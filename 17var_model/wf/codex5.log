import pandas as pd, numpy as np
k=pd.read_parquet('data/ext_kchs.parquet')
vs=['income_q','partnered','living_alone','current_drinker','active','sleep_hrs','bmi','htn','dm','srh','employed','oral_health','alcohol_freq','alcohol_qty','alcohol_qty_drinks','binge','welfare','sleep_weekend','food_insecure']
for v in vs:
