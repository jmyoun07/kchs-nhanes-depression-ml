print('sleep both n',ok.sum(),'changed n',chg.sum(),'changed all%',chg.sum()/len(k)*100,'changed among both%',chg.mean()*100,'mean stored',np.average(k.loc[ok,'sleep_hrs'],weights=k.loc[ok,'W']),'mean weekday',np.average(swd,weights=k.loc[ok,'W']))
