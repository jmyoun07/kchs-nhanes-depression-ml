import pandas as pd, numpy as np
C={n:pd.read_parquet(f'data/ext_{f}.parquet') for n,f in [('KCHS','kchs'),('PRE','pre'),('POST','post')]}
for nm,d in C.items():
 print('\\n',nm)
 tests={
 'age<20':d.age<20,'age>100':d.age>100,
 'sleep<=0':d.sleep_hrs<=0,'sleep<2':d.sleep_hrs<2,'sleep>16':d.sleep_hrs>16,
 'bmi<10':d.bmi<10,'bmi>70':d.bmi>70,
 'W<=0':d.W<=0,'W nonfinite':~np.isfinite(d.W),
 'phq outside0-27':~d.phq_sum.between(0,27),'dep mismatch':d.dep.ne((d.phq_sum>=10).astype(float)),
 }
 for lab,m in tests.items():
  m=m.fillna(False) if hasattr(m,'fillna') else m
  print(f'{lab}: {int(m.sum())} ({m.mean()*100:.4f}%)')
 print('phq values',sorted(d.phq_sum.unique())[:5],sorted(d.phq_sum.unique())[-5:])
 print('sleep extreme values',d.loc[(d.sleep_hrs<2)|(d.sleep_hrs>16),'sleep_hrs'].value_counts().sort_index().to_dict())
