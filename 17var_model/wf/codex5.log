  76:     a=np.array(a); return float(np.percentile(a,2.5)), float(np.percentile(a,97.5)), len(a)
  77: 
  78: tr, ho = train_test_split(np.arange(len(kchs)), train_size=500000, test_size=100000, stratify=y, random_state=SEED)
  79: model=Pipeline([("pre",make_ct()),("clf",lgb.LGBMClassifier(**LGB))]).fit(kchs.iloc[tr][FE],y[tr])
  80: dho=kchs.iloc[ho].copy(); dho["_p"]=model.predict_proba(dho[FE])[:,1]
  81: prd=pre.copy();  prd["_p"]=model.predict_proba(pre[FE])[:,1]
  82: pod=post.copy(); pod["_p"]=model.predict_proba(post[FE])[:,1]
  83: 
  84: # ?? (A) 내부 CI: 층 = year|strata ??
  85: print("="*92); print("[A] KCHS 층 정의 ? year|strata 로 재구성한 내부 CI"); print("="*92, flush=True)
  86: st_old=dho["strata"].astype(str).values
  87: st_new=(dho["year"].astype(str)+"|"+dho["strata"].astype(str)).values
  88: yv=dho["dep"].astype(int).values; p=dho["_p"].values
  89: rows=[]
  90: for tag,st in [("strata only (superseded)",st_old),("year|strata (correct)",st_new)]:
  91:     reps=rep_weights(dho,st,B=1000)
  92:     lo,hi,n=ci_from(yv,p,reps); alo,ahi,_=ci_from(yv,p,reps,average_precision_score)
  93:     print(f"   {tag:<28} AUROC CI [{lo:.4f},{hi:.4f}]  AUPRC CI [{alo:.3f},{ahi:.3f}]  ({n} reps)", flush=True)
  94:     rows.append(dict(setting=tag, AUROC_lo=round(lo,4), AUROC_hi=round(hi,4), AUPRC_lo=round(alo,3), AUPRC_hi=round(ahi,3)))
  95: pd.DataFrame(rows).to_csv(f"{RES}/review3_metrics.csv", index=False, encoding="utf-8-sig")
  96: 
  97: # ?? (B) 하위군: 전체 설계 복제가중치를 도메인에 적용 ??
  98: print("\n"+"="*92); print("[B] 하위군 CI ? 전체 코호트 설계에서 만든 복제가중치를 도메인에 적용"); print("="*92, flush=True)
  99: def logit(x): x=np.clip(x,1e-6,1-1e-6); return np.log(x/(1-x))
 100: def cal_slope(a,b,w): return float(LogisticRegression(penalty=None,solver="lbfgs").fit(logit(b).reshape(-1,1),a,sample_weight=w).coef_[0,0])
 101: def citl(a,b,w):
 102:     lp=logit(b); z=0.0
 103:     for _ in range(200):
 104:         mu=1/(1+np.exp(-(z+lp))); g=np.sum(w*(a-mu)); h=np.sum(w*mu*(1-mu))
 105:         if h<=0: break
 106:         s=g/h; z+=s
 107:         if abs(s)<1e-10: break
 108:     return float(z)
