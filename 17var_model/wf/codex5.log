 106: def pa_nhanes_pre(m):
 107:     def c(x): return clean(m.get(x), (7, 9, 7777, 9999, 77, 99))
 108:     vig = np.where(c("PAQ650") == 1, c("PAQ655").fillna(0) * c("PAD660").fillna(0), 0)
 109:     mod = np.where(c("PAQ665") == 1, c("PAQ670").fillna(0) * c("PAD675").fillna(0), 0)
 110:     meets = (mod >= 150) | (vig >= 75)
 111:     any_pa = c("PAQ650").notna() | c("PAQ665").notna()
 112:     return pd.Series(np.where(any_pa, meets.astype(float), np.nan), index=m.index)
