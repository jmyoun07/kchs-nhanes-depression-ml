  19: from sklearn.ensemble import HistGradientBoostingClassifier
  20: from sklearn.metrics import roc_auc_score, average_precision_score
  21: import lightgbm as lgb
  22: 
  23: D = r"C:/Users/rudtn/Desktop/claude code/지역사회건강/17var_model"; RES = f"{D}/results"; SEED = 42
  24: kchs = pd.read_parquet(f"{D}/data/ext_kchs.parquet"); pre = pd.read_parquet(f"{D}/data/ext_pre.parquet"); post = pd.read_parquet(f"{D}/data/ext_post.parquet")
  25: NUM=["age","sleep_hrs","bmi","income_q","srh","oral_health"]
  26: BIN=["partnered","living_alone","current_drinker","active","htn","dm","employed","food_insecure"]
  27: CAT=["sex","edu","smoking"]; FE=NUM+BIN+CAT
  28: y=kchs["dep"].astype(int).values
  29: LGB=dict(num_leaves=31,min_child_samples=1000,learning_rate=0.01,n_estimators=900,reg_alpha=1.0,
  30:          reg_lambda=20.0,subsample=0.6,colsample_bytree=0.6,random_state=SEED,n_jobs=-1,verbose=-1)
  31: def make_ct(native=True):
  32:     return ColumnTransformer([("num",Pipeline([("i",SimpleImputer(strategy="median")),("s",StandardScaler())]),NUM),
  33:                               ("bin","passthrough" if native else SimpleImputer(strategy="most_frequent"),BIN),
  34:                               ("cat",Pipeline([("i",SimpleImputer(strategy="most_frequent")),("o",OneHotEncoder(handle_unknown="ignore",drop="first"))]),CAT)])
  35: 
  36: class RaoWuBoot:
  37:     """층 h에서 m_h=n_h-1개 PSU 복원추출 + w*(n_h/m_h)*r 재척도. 단일 PSU 층은 유사층으로 통합."""
  38:     def __init__(self, strata, psu, w, pool_singletons=True):
  39:         st=pd.Series(strata).astype(str).reset_index(drop=True); ps=pd.Series(psu).astype(str).reset_index(drop=True)
  40:         # 군집 정체성은 '원래' 층|PSU 로 고정한다. 단일층 통합은 '층 라벨'만 바꿀 뿐이며,
  41:         # 통합 후 라벨로 군집을 다시 만들면 서로 다른 층의 동일 PSU 라벨이 한 군집으로 합쳐진다(버그).
  42:         cl=pd.factorize(st+"|"+ps)[0]
  43:         st_group=st
  44:         if pool_singletons:
  45:             npsu=pd.DataFrame({"s":st,"p":ps}).drop_duplicates().groupby("s").size()
  46:             single=set(npsu[npsu==1].index)
  47:             st_group=st.where(~st.isin(single),"__SINGLETON_POOL__")
  48:         sid=pd.factorize(st_group)[0]
  49:         self.cl=cl; self.w=np.asarray(w,float); C=cl.max()+1; self.C=C
  50:         cs=np.zeros(C,dtype=int); cs[cl]=sid; self.cl_stratum=cs
  51:         self.n_h=np.bincount(cs); self.m_h=np.maximum(self.n_h-1,1)
  52:         o=np.argsort(cs,kind="stable"); self.cl_sorted=o
  53:         ss=cs[o]; sc=np.bincount(ss); start=np.concatenate([[0],np.cumsum(sc)])[:-1]
  54:         self.slot_start=start[ss]; self.slot_n=sc[ss]; self.singleton=self.n_h[cs]==1
  55:     def weights(self, rng):
  56:         r=np.zeros(self.C); u=rng.random_sample(self.C)
  57:         idx=np.arange(self.C)-self.slot_start
  58:         sel=np.where(idx < self.m_h[self.cl_stratum[self.cl_sorted]])[0]
  59:         pick=self.slot_start[sel]+(u[sel]*self.slot_n[sel]).astype(int)
  60:         np.add.at(r,self.cl_sorted[pick],1.0)
  61:         sc=np.where(self.singleton,1.0,(self.n_h[self.cl_stratum]/self.m_h[self.cl_stratum])*r)
  62:         return self.w*sc[self.cl]
  63: 
  64: def rep_weights(d, strata, B=1000, seed=SEED):
  65:     rw=RaoWuBoot(strata, d["psu"].values, d["W"].to_numpy(float))
  66:     rng=np.random.RandomState(seed)
