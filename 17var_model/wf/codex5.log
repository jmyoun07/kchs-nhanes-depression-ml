import pandas as pd,numpy as np
C=[('K',pd.read_parquet('data/ext_kchs.parquet')),('Pre',pd.read_parquet('data/ext_pre.parquet')),('Post',pd.read_parquet('data/ext_post.parquet'))]
cat=['sex','edu','income_q','partnered','living_alone','smoking','current_drinker','active','htn','dm','srh','employed','oral_health','food_insecure','alcohol_freq','alcohol_qty','binge','welfare','welfare_12mo','race']
cont=['age','income_raw','sleep_hrs','bmi','stress','alcohol_qty_drinks','sleep_weekend']
def cellcat(d,v):
 s=d[v];ok=s.notna()&d.W.notna()&(d.W>0);z=d.loc[ok].groupby(v).W.sum();z=z/z.sum()*100
 def lab(x):
  if isinstance(x,(float,np.floating)) and float(x).is_integer(): return str(int(x))
  return str(x)
 return f\"m{s.isna().mean()*100:.1f};\"+'/'.join(f'{lab(a)}:{b:.1f}' for a,b in z.items())
def cellcon(d,v):
 s=pd.to_numeric(d[v],errors='coerce');ok=s.notna()&(d.W>0);mean=np.average(s[ok],weights=d.W[ok]) if ok.any() else np.nan
 if not ok.any():return 'm100'
 return f'm{s.isna().mean()*100:.1f};{mean:.2f}[{s.min():.1f},{s.max():.1f}]'
for v in cat:
 print('|',v,'|',' | '.join(cellcat(d,v) for _,d in C),'|')
print('CONT')
for v in cont:print('|',v,'|',' | '.join(cellcon(d,v) for _,d in C),'|')
