===== 55_oracle_grouped.py =====
   1: # -*- coding: utf-8 -*-
   2: """55_oracle_grouped.py ? 오라클 교차검증을 PSU 단위로 분리 + 실험 레지스트리 생성.
   3: 
   4: 지적 1: 오라클이 개인 단위 StratifiedKFold를 써서 같은 PSU가 학습·검증 폴드에 동시에 들어갔다.
   5:         → 주기 내 PSU를 그룹으로 묶는 GroupKFold로 재산출.
   6: 지적 2: CI가 고정된 out-of-fold 예측을 재표집해 '모델 재적합 변동'을 포함하지 않는다.
   7:         → 각 부트스트랩 복제에서 오라클을 재적합하는 중첩 부트스트랩을 200회 수행해 비교.
   8: 지적 3: ">450 experiments"의 근거 파일이 지정 정본 목록에 없다.
   9:         → 탐색 CSV들을 기계적으로 세어 중복 제거한 레지스트리를 만든다.
  10: 
  11: 출력: results/review4_oracle_grouped.csv, results/experiment_registry.csv
  12: """
  13: import sys, glob, os, warnings, numpy as np, pandas as pd
  14: sys.stdout.reconfigure(encoding="utf-8"); warnings.filterwarnings("ignore")
  15: from sklearn.model_selection import StratifiedGroupKFold
  16: from sklearn.compose import ColumnTransformer
  17: from sklearn.pipeline import Pipeline
  18: from sklearn.impute import SimpleImputer
  19: from sklearn.preprocessing import StandardScaler, OneHotEncoder
  20: from sklearn.linear_model import LogisticRegression
  21: from sklearn.ensemble import HistGradientBoostingClassifier
  22: from sklearn.metrics import roc_auc_score
  23: import lightgbm as lgb
  24: 
  25: D = os.path.dirname(os.path.abspath(__file__)); RES = f"{D}/results"; SEED = 42
  26: pre = pd.read_parquet(f"{D}/data/ext_pre.parquet"); post = pd.read_parquet(f"{D}/data/ext_post.parquet")
  27: NUM=["age","sleep_hrs","bmi","income_q","srh","oral_health"]
  28: BIN=["partnered","living_alone","current_drinker","active","htn","dm","employed","food_insecure"]
  29: CAT=["sex","edu","smoking"]; FE=NUM+BIN+CAT
  30: def make_ct(native=True):
  31:     return ColumnTransformer([("num",Pipeline([("i",SimpleImputer(strategy="median")),("s",StandardScaler())]),NUM),
  32:                               ("bin","passthrough" if native else SimpleImputer(strategy="most_frequent"),BIN),
  33:                               ("cat",Pipeline([("i",SimpleImputer(strategy="most_frequent")),("o",OneHotEncoder(handle_unknown="ignore",drop="first"))]),CAT)])
  34: 
  35: pooled = pd.concat([pre.assign(_p="pre"), post.assign(_p="post")], ignore_index=True)
  36: strata = (pooled["_p"].astype(str)+"|"+pooled["strata"].astype(str)).values
  37: groups = (pooled["_p"].astype(str)+"|"+pooled["strata"].astype(str)+"|"+pooled["psu"].astype(str)).values
  38: yo = pooled["dep"].astype(int).values; Wo = pooled["W"].to_numpy(float)
  39: print(f"[설계] pooled n={len(pooled):,} · 층 {len(set(strata))} · PSU {len(set(groups))}", flush=True)
  40: 
  41: class RaoWuBoot:
  42:     def __init__(self, strata, psu, w, pool_singletons=True):
  43:         st=pd.Series(strata).astype(str).reset_index(drop=True); ps=pd.Series(psu).astype(str).reset_index(drop=True)
  44:         cl=pd.factorize(st+"|"+ps)[0]; st_group=st
  45:         if pool_singletons:
  46:             npsu=pd.DataFrame({"s":st,"p":ps}).drop_duplicates().groupby("s").size()
  47:             st_group=st.where(~st.isin(set(npsu[npsu==1].index)),"__SINGLETON_POOL__")
  48:         sid=pd.factorize(st_group)[0]
  49:         self.cl=cl; self.w=np.asarray(w,float); C=cl.max()+1; self.C=C
  50:         cs=np.zeros(C,dtype=int); cs[cl]=sid; self.cl_stratum=cs
  51:         self.n_h=np.bincount(cs); self.m_h=np.maximum(self.n_h-1,1)
  52:         o=np.argsort(cs,kind="stable"); self.cl_sorted=o
  53:         ss=cs[o]; sc=np.bincount(ss); start=np.concatenate([[0],np.cumsum(sc)])[:-1]
  54:         self.slot_start=start[ss]; self.slot_n=sc[ss]; self.singleton=self.n_h[cs]==1
  55:     def weights(self, rng):
  56:         r=np.zeros(self.C); u=rng.random_sample(self.C)
  57:         idx=np.arange(self.C)-self.slot_start
  58:         sel=np.where(idx < self.m_h[self.cl_stratum[self.cl_sorted]])[0]
  59:         pick=self.slot_start[sel]+(u[sel]*self.slot_n[sel]).astype(int)
  60:         np.add.at(r,self.cl_sorted[pick],1.0)
  61:         sc=np.where(self.singleton,1.0,(self.n_h[self.cl_stratum]/self.m_h[self.cl_stratum])*r)
  62:         return self.w*sc[self.cl]
  63: 
  64: LEARN = {
  65:  "Logistic regression": lambda: Pipeline([("pre",make_ct(False)),("clf",LogisticRegression(max_iter=2000))]),
  66:  "Penalized logistic (L2, C=0.1)": lambda: Pipeline([("pre",make_ct(False)),("clf",LogisticRegression(C=0.1,max_iter=2000))]),
  67:  "Histogram gradient boosting": lambda: Pipeline([("pre",make_ct()),("clf",HistGradientBoostingClassifier(random_state=SEED,max_iter=300,learning_rate=0.05))]),
  68:  "LightGBM (small)": lambda: Pipeline([("pre",make_ct()),("clf",lgb.LGBMClassifier(random_state=SEED,n_jobs=-1,verbose=-1,num_leaves=7,min_child_samples=200,learning_rate=0.05,n_estimators=300))]),
  69: }
  70: def oof_grouped(mk, idx=None):
  71:     """주기 내 PSU를 그룹으로 분리한 5-fold 층화 그룹 CV."""
  72:     sub = np.arange(len(pooled)) if idx is None else idx
  73:     yy = yo[sub]; gg = groups[sub]
  74:     oof = np.zeros(len(sub))
  75:     cv = StratifiedGroupKFold(5, shuffle=True, random_state=SEED)
  76:     X = pooled.iloc[sub]
  77:     for tri, tei in cv.split(X[FE], yy, groups=gg):
  78:         oof[tei] = mk().fit(X.iloc[tri][FE], yy[tri]).predict_proba(X.iloc[tei][FE])[:,1]
  79:     return oof
  80: 
  81: print("\n[오라클] PSU 분리 그룹 CV", flush=True)
  82: rw = RaoWuBoot(strata, pooled["psu"].values, Wo)
  83: reps = [rw.weights(np.random.RandomState(SEED+i)) for i in range(1000)]
  84: rows=[]
  85: best_name, best_auc = None, -1
  86: for nm, mk in LEARN.items():
  87:     oof = oof_grouped(mk)
  88:     a = roc_auc_score(yo, oof, sample_weight=Wo)
  89:     est=[]
  90:     for w in reps:
  91:         m=w>0
  92:         if m.sum()<10 or yo[m].min()==yo[m].max(): continue
  93:         try: est.append(roc_auc_score(yo, oof, sample_weight=w))
  94:         except Exception: pass
  95:     est=np.array(est); lo,hi=np.percentile(est,[2.5,97.5])
  96:     print(f"   {nm:<34} {a:.4f}  95% CI [{lo:.3f},{hi:.3f}]   (예측 고정 재표집)", flush=True)
  97:     rows.append(dict(learner=nm, oracle_AUROC=round(a,4), CI_lo=round(lo,3), CI_hi=round(hi,3), method="grouped CV, fixed-OOF bootstrap"))
  98:     if a>best_auc: best_auc, best_name, best_mk = a, nm, mk
  99: 
 100: # 중첩 부트스트랩: 복제마다 오라클을 재적합해 학습변동 포함
 101: print(f"\n[중첩 부트스트랩] {best_name} ? 복제마다 재적합(200회)", flush=True)
 102: nest=[]
 103: for i in range(200):
 104:     w = reps[i]
 105:     keep = np.where(w>0)[0]
 106:     if yo[keep].min()==yo[keep].max(): continue
 107:     try:
 108:         o2 = oof_grouped(best_mk, idx=keep)
 109:         nest.append(roc_auc_score(yo[keep], o2, sample_weight=w[keep]))
 110:     except Exception: pass
 111: nest=np.array(nest); nlo,nhi=np.percentile(nest,[2.5,97.5])
 112: print(f"   {best_name}: 재적합 포함 95% CI [{nlo:.3f},{nhi:.3f}]  (n={len(nest)} 복제)", flush=True)
 113: rows.append(dict(learner=f"{best_name} (refit within each replicate)", oracle_AUROC=round(best_auc,4),
 114:                  CI_lo=round(nlo,3), CI_hi=round(nhi,3), method="grouped CV, nested bootstrap with refit"))
 115: pd.DataFrame(rows).to_csv(f"{RES}/review4_oracle_grouped.csv", index=False, encoding="utf-8-sig")
 116: 
 117: # ── 실험 레지스트리 ──
 118: print("\n[레지스트리] 탐색 실험 수 집계", flush=True)
 119: pats = [f"{RES}/path*.csv", f"{RES}/p1_*.csv", f"{RES}/round*.csv", f"{RES}/methods_explore.csv",
 120:         f"{RES}/deeplearning_explore.csv", f"{RES}/ceiling_experiments.csv",
 121:         f"{D}/../results/path*.csv", f"{D}/../results/p1_*.csv", f"{D}/../results/round*.csv"]
 122: seen=set(); reg=[]
 123: for pat in pats:
 124:     for f in sorted(glob.glob(pat)):
 125:         try: d=pd.read_csv(f)
 126:         except Exception: continue
 127:         key=os.path.basename(f)
 128:         if key in seen: continue
 129:         seen.add(key)
 130:         reg.append(dict(file=key, rows=len(d), path=os.path.relpath(f, D).replace("\\","/")))
 131: rg=pd.DataFrame(reg).sort_values("file")
 132: rg.to_csv(f"{RES}/experiment_registry.csv", index=False, encoding="utf-8-sig")
 133: print(f"   파일 {len(rg)}개 · 실험행 합계 {int(rg['rows'].sum()):,}", flush=True)
 134: print("\n저장: results/review4_oracle_grouped.csv, experiment_registry.csv\n완료.", flush=True)
===== 56_income_fix.py =====
   1: # -*- coding: utf-8 -*-
   2: """56_income_fix.py ? 소득분위(income_q) 조화 결함 정량화 및 교정판 비교.
   3: 
   4: 결함: src/01_harmonize.py 는 코호트별로 pd.qcut(income_raw, 5, duplicates="drop") 를 쓴다.
   5:       NHANES post 는 INDFMPIR 상단이 5.00 에 top-code 되어 23.8% 가 동일값이므로 상위 두 분위가
   6:       조용히 합쳐져 **4단계**만 생성된다(0..3). income_q 는 단일 수치 서열변수로 투입되므로,
   7:       post 코호트의 상위 절반이 학습셋의 '4분위' 수준으로 사상된다.
   8: 
   9: 교정: income_raw 의 코호트 내 백분위 순위를 고정 절단점(0.2/0.4/0.6/0.8)에 사상해 항상 5단계를 만든다
  10:       (top-code 동일값은 평균 순위로 처리 → 동일값 집단이 여러 분위에 걸치면 중앙 분위로 배정).
  11: 
  12: 출력: results/income_fix_diagnostic.csv, results/income_fix_sensitivity.csv
  13: """
  14: import sys, os, warnings, numpy as np, pandas as pd
  15: sys.stdout.reconfigure(encoding="utf-8"); warnings.filterwarnings("ignore")
  16: from sklearn.model_selection import train_test_split
  17: from sklearn.compose import ColumnTransformer
  18: from sklearn.pipeline import Pipeline
  19: from sklearn.impute import SimpleImputer
  20: from sklearn.preprocessing import StandardScaler, OneHotEncoder
  21: from sklearn.linear_model import LogisticRegression
  22: from sklearn.metrics import roc_auc_score
  23: import lightgbm as lgb
  24: 
  25: D = os.path.dirname(os.path.abspath(__file__)); RES = f"{D}/results"; SEED = 42
  26: kchs = pd.read_parquet(f"{D}/data/ext_kchs.parquet"); pre = pd.read_parquet(f"{D}/data/ext_pre.parquet"); post = pd.read_parquet(f"{D}/data/ext_post.parquet")
  27: NUM=["age","sleep_hrs","bmi","income_q","srh","oral_health"]
  28: BIN=["partnered","living_alone","current_drinker","active","htn","dm","employed","food_insecure"]
  29: CAT=["sex","edu","smoking"]; FE=NUM+BIN+CAT
  30: LGB=dict(num_leaves=31,min_child_samples=1000,learning_rate=0.01,n_estimators=900,reg_alpha=1.0,
  31:          reg_lambda=20.0,subsample=0.6,colsample_bytree=0.6,random_state=SEED,n_jobs=-1,verbose=-1)
  32: def make_ct():
  33:     return ColumnTransformer([("num",Pipeline([("i",SimpleImputer(strategy="median")),("s",StandardScaler())]),NUM),
  34:                               ("bin","passthrough",BIN),
  35:                               ("cat",Pipeline([("i",SimpleImputer(strategy="most_frequent")),("o",OneHotEncoder(handle_unknown="ignore",drop="first"))]),CAT)])
  36: 
  37: # ── 진단 ──
  38: print("="*92); print("[진단] 코호트별 income_q 실제 단계 수와 분포"); print("="*92, flush=True)
  39: diag=[]
  40: for nm,d in [("KCHS",kchs),("NHANES pre",pre),("NHANES post",post)]:
  41:     v=pd.to_numeric(d["income_q"],errors="coerce"); w=d["W"].to_numpy(float)
  42:     lv=sorted(v.dropna().unique().tolist())
  43:     shares={int(k): round(float(w[(v==k).values].sum()/w[v.notna().values].sum())*100,1) for k in lv}
  44:     raw=pd.to_numeric(d["income_raw"],errors="coerce")
  45:     topmass=float((raw==raw.max()).mean()*100) if raw.notna().any() else np.nan
  46:     print(f"   {nm:<12} 단계 {len(lv)}개 {lv}  가중분포 {shares}  · income_raw 최대값 동일비중 {topmass:.1f}%", flush=True)
  47:     diag.append(dict(cohort=nm, n_levels=len(lv), levels=str(lv), weighted_shares=str(shares), top_code_share_pct=round(topmass,1)))
  48: pd.DataFrame(diag).to_csv(f"{RES}/income_fix_diagnostic.csv", index=False, encoding="utf-8-sig")
  49: 
  50: # ── 교정판: 백분위 순위 → 고정 절단점 ──
  51: def fixed_quintile(raw, w=None):
  52:     r = pd.to_numeric(raw, errors="coerce")
  53:     pct = r.rank(pct=True, method="average")
  54:     q = pd.cut(pct, [0, .2, .4, .6, .8, 1.0], labels=False, include_lowest=True)
  55:     return pd.Series(q, index=r.index).where(r.notna())
  56: 
  57: print("\n[교정] 백분위 순위 기반 5단계 재생성", flush=True)
  58: fx={}
  59: for nm,d in [("KCHS",kchs),("NHANES pre",pre),("NHANES post",post)]:
  60:     q=fixed_quintile(d["income_raw"])
  61:     lv=sorted(q.dropna().unique().tolist())
  62:     w=d["W"].to_numpy(float)
  63:     shares={int(k): round(float(w[(q==k).values].sum()/w[q.notna().values].sum())*100,1) for k in lv}
  64:     print(f"   {nm:<12} 단계 {len(lv)}개 {[int(x) for x in lv]}  가중분포 {shares}", flush=True)
  65:     fx[nm]=q
  66: 
  67: # ── 민감도: 교정 소득분위로 재적합·재평가 ──
  68: print("\n[민감도] 교정 income_q 로 모델 재적합 후 비교", flush=True)
  69: y = kchs["dep"].astype(int).values
  70: tr, ho = train_test_split(np.arange(len(kchs)), train_size=500000, test_size=100000, stratify=y, random_state=SEED)
  71: Who = kchs.iloc[ho]["W"].to_numpy(float); yho = y[ho]
  72: Wp, Ws = pre["W"].to_numpy(float), post["W"].to_numpy(float)
  73: yp, ys = pre["dep"].astype(int).values, post["dep"].astype(int).values
  74: 
  75: rows=[]
  76: for tag, use_fixed in [("기준(현행 income_q)", False), ("교정 income_q(항상 5단계)", True)]:
  77:     K, P_, S_ = kchs.copy(), pre.copy(), post.copy()
  78:     if use_fixed:
  79:         K["income_q"]=fx["KCHS"].values; P_["income_q"]=fx["NHANES pre"].values; S_["income_q"]=fx["NHANES post"].values
  80:     m=Pipeline([("pre",make_ct()),("clf",lgb.LGBMClassifier(**LGB))]).fit(K.iloc[tr][FE], y[tr])
  81:     i=roc_auc_score(yho, m.predict_proba(K.iloc[ho][FE])[:,1], sample_weight=Who)
  82:     p=roc_auc_score(yp,  m.predict_proba(P_[FE])[:,1], sample_weight=Wp)
  83:     s=roc_auc_score(ys,  m.predict_proba(S_[FE])[:,1], sample_weight=Ws)
  84:     def slope(yv,pp,w):
  85:         pp=np.clip(pp,1e-6,1-1e-6); lp=np.log(pp/(1-pp)).reshape(-1,1)
  86:         return float(LogisticRegression(penalty=None,solver="lbfgs").fit(lp,yv,sample_weight=w).coef_[0,0])
  87:     sl_p=slope(yp, m.predict_proba(P_[FE])[:,1], Wp); sl_s=slope(ys, m.predict_proba(S_[FE])[:,1], Ws)
  88:     print(f"   {tag:<26} 내부 {i:.4f}  pre {p:.4f}  post {s:.4f}   (보정기울기 pre {sl_p:.3f} / post {sl_s:.3f})", flush=True)
  89:     rows.append(dict(spec=tag, internal=round(i,4), ext_pre=round(p,4), ext_post=round(s,4),
  90:                      slope_pre=round(sl_p,3), slope_post=round(sl_s,3)))
  91: df=pd.DataFrame(rows); df.to_csv(f"{RES}/income_fix_sensitivity.csv", index=False, encoding="utf-8-sig")
  92: d0,d1=df.iloc[0],df.iloc[1]
  93: print(f"\n   Δ(교정 ? 기준): 내부 {d1.internal-d0.internal:+.4f}  pre {d1.ext_pre-d0.ext_pre:+.4f}  post {d1.ext_post-d0.ext_post:+.4f}", flush=True)
