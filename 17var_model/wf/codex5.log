import pandas as pd,numpy as np
from sklearn.model_selection import train_test_split
k=pd.read_parquet('data/ext_kchs.parquet',columns=['year','strata','psu','dep'])
y=k.dep.astype(int).values
_,ho=train_test_split(np.arange(len(k)),train_size=500000,test_size=100000,stratify=y,random_state=42)
for lab,d in [('full',k),('ho',k.iloc[ho])]:
 st=d.year.astype(str)+'|'+d.strata.astype(str)
 tab=pd.DataFrame({'s':st,'p':d.psu.astype(str)}).drop_duplicates().groupby('s').size()
 print(lab,len(d),'strata',len(tab),'psu',tab.sum(),'singletons',sum(tab==1),'median',tab.median(),'max',tab.max())
