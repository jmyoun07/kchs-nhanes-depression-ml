codex
I found three data-visible harmonization discontinuities worth quantifying before deciding whether they are reportable: KCHS current drinking jumps after the 2020 code change, 2018 activity uses a different fallback definition, and KCHS sleep switches between weekday-only and a 7-day average. I’m now rerunning the exact headline model under one correction at a time so I only report defects that measurably move the results.
exec
"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import pandas as pd,numpy as np,time
from sklearn.model_selection import train_test_split
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import StandardScaler,OneHotEncoder
from sklearn.metrics import roc_auc_score
from sklearn.linear_model import LogisticRegression
import lightgbm as lgb
SEED=42
NUM=['age','sleep_hrs','bmi','income_q','srh','oral_health']; BIN=['partnered','living_alone','current_drinker','active','htn','dm','employed','food_insecure']; CAT=['sex','edu','smoking']; FE=NUM+BIN+CAT
K0=pd.read_parquet('data/ext_kchs.parquet'); P0=pd.read_parquet('data/ext_pre.parquet'); S0=pd.read_parquet('data/ext_post.parquet')
y=K0.dep.astype(int).values
tr,ho=train_test_split(np.arange(len(K0)),train_size=500000,test_size=100000,stratify=y,random_state=SEED)
LGB=dict(num_leaves=31,min_child_samples=1000,learning_rate=.01,n_estimators=900,reg_alpha=1.,reg_lambda=20.,subsample=.6,colsample_bytree=.6,random_state=42,n_jobs=-1,verbose=-1)
def ct(): return ColumnTransformer([('num',Pipeline([('i',SimpleImputer(strategy='median')),('s',StandardScaler())]),NUM),('bin','passthrough',BIN),('cat',Pipeline([('i',SimpleImputer(strategy='most_frequent')),('o',OneHotEncoder(handle_unknown='ignore',drop='first'))]),CAT)])
def slope(y,p,w):
 p=np.clip(p,1e-6,1-1e-6); return LogisticRegression(penalty=None,solver='lbfgs').fit(np.log(p/(1-p)).reshape(-1,1),y,sample_weight=w).coef_[0,0]
def fixed(raw):
 r=pd.to_numeric(raw,errors='coerce'); pct=r.rank(pct=True,method='average'); return pd.cut(pct,[0,.2,.4,.6,.8,1],labels=False,include_lowest=True).where(r.notna())
def eval(tag,K,P,S):
 t=time.time(); m=Pipeline([('pre',ct()),('clf',lgb.LGBMClassifier(**LGB))]).fit(K.iloc[tr][FE],y[tr])
 out=[]
 for d,idx in [(K,ho),(P,None),(S,None)]:
  dd=d.iloc[idx] if idx is not None else d; yy=y[ho] if idx is not None else dd.dep.astype(int).values; w=dd.W.to_numpy(float); p=m.predict_proba(dd[FE])[:,1]
  out += [roc_auc_score(yy,p,sample_weight=w),slope(yy,p,w)]
 print(tag,' '.join(f'{x:.5f}' for x in out),'sec',round(time.time()-t,1),flush=True)
# output order: internal AUC slope, pre AUC slope, post AUC slope
eval('baseline',K0,P0,S0)
K=K0.copy(); m=(K.year>=2020)&(K.current_drinker==1)&(K.alcohol_qty_drinks==0); K.loc[m,'current_drinker']=0; eval('fix_current',K,P0,S0)
K=K0.copy(); K.loc[K.year==2018,'active']=np.nan; eval('fix_active2018_NA',K,P0,S0)
K=K0.copy(); ok=K.sleep_weekend.notna()&K.sleep_hrs.notna(); K.loc[ok,'sleep_hrs']=(7*K.loc[ok,'sleep_hrs']-2*K.loc[ok,'sleep_weekend'])/5; eval('fix_sleep_weekday',K,P0,S0)
K=K0.copy(); P=P0.copy(); S=S0.copy(); K.age=K.age.clip(upper=80); P.age=P.age.clip(upper=80); S.age=S.age.clip(upper=80); eval('fix_age_cap80',K,P,S)
K=K0.copy(); K.loc[(K.year==2017)&K.income_raw.isin([77,99]),'income_q']=np.nan; eval('fix_income2017_refusal',K,P0,S0)
K=K0.copy();P=P0.copy();S=S0.copy(); K.income_q=fixed(K.income_raw);P.income_q=fixed(P.income_raw);S.income_q=fixed(S.income_raw);eval('fix_income_rank',K,P,S)
