import pandas as pd,numpy as np
from sklearn.model_selection import train_test_split
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import StandardScaler,OneHotEncoder
from sklearn.metrics import roc_auc_score,average_precision_score,brier_score_loss
from sklearn.linear_model import LogisticRegression
import lightgbm as lgb
K=pd.read_parquet('data/ext_kchs.parquet');P=pd.read_parquet('data/ext_pre.parquet');S=pd.read_parquet('data/ext_post.parquet');y=K.dep.astype(int).values;tr,ho=train_test_split(np.arange(len(K)),train_size=500000,test_size=100000,stratify=y,random_state=42)
def fixed(r):r=pd.to_numeric(r,errors='coerce');q=pd.cut(r.rank(pct=True,method='average'),[0,.2,.4,.6,.8,1],labels=False,include_lowest=True);return q.where(r.notna())
# all reproducible harmonization corrections
m=(K.year>=2020)&(K.current_drinker==1)&(K.alcohol_qty_drinks==0);K.loc[m,'current_drinker']=0
K.loc[K.year==2018,'active']=np.nan
ok=K.sleep_weekend.notna()&K.sleep_hrs.notna();K.loc[ok,'sleep_hrs']=(7*K.loc[ok,'sleep_hrs']-2*K.loc[ok,'sleep_weekend'])/5
for d in [K,P,S]:d['age']=d.age.clip(upper=80)
K.income_q=K.groupby('year',group_keys=False).income_raw.apply(fixed).sort_index();K.loc[(K.year==2017)&K.income_raw.isin([77,99]),'income_q']=np.nan;P.income_q=fixed(P.income_raw);S.income_q=fixed(S.income_raw)
NUM=['age','sleep_hrs','bmi','income_q','srh','oral_health'];BIN=['partnered','living_alone','current_drinker','active','htn','dm','employed','food_insecure'];CAT=['sex','edu','smoking'];FE=NUM+BIN+CAT
ct=ColumnTransformer([('num',Pipeline([('i',SimpleImputer(strategy='median')),('s',StandardScaler())]),NUM),('bin','passthrough',BIN),('cat',Pipeline([('i',SimpleImputer(strategy='most_frequent')),('o',OneHotEncoder(handle_unknown='ignore',drop='first'))]),CAT)])
pars=dict(num_leaves=31,min_child_samples=1000,learning_rate=.01,n_estimators=900,reg_alpha=1,reg_lambda=20,subsample=.6,colsample_bytree=.6,random_state=42,n_jobs=-1,verbose=-1)
mod=Pipeline([('pre',ct),('clf',lgb.LGBMClassifier(**pars))]).fit(K.iloc[tr][FE],y[tr])
for nm,d,yy in [('internal',K.iloc[ho],y[ho]),('pre',P,P.dep.astype(int).values),('post',S,S.dep.astype(int).values)]:
 p=mod.predict_proba(d[FE])[:,1];w=d.W.to_numpy(float);lp=np.log(np.clip(p,1e-6,1-1e-6)/(1-np.clip(p,1e-6,1-1e-6))).reshape(-1,1);z=LogisticRegression(penalty=None).fit(lp,yy,sample_weight=w);print(nm,'AUC',roc_auc_score(yy,p,sample_weight=w),'AP',average_precision_score(yy,p,sample_weight=w),'Brier',brier_score_loss(yy,p,sample_weight=w),'slope',z.coef_[0,0],'intercept',z.intercept_[0])
