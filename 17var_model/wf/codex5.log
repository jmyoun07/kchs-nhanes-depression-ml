NUM=['age','sleep_hrs','bmi','income_q','srh','oral_health'];BIN=['partnered','living_alone','current_drinker','active','htn','dm','employed','food_insecure'];CAT=['sex','edu','smoking'];
configs=[('17',NUM,BIN,CAT),('5',['srh','age','sleep_hrs','oral_health'],[],['sex']),('7',['srh','age','sleep_hrs','oral_health'],['employed','partnered'],['sex'])]
pars=dict(num_leaves=31,min_child_samples=1000,learning_rate=.01,n_estimators=900,reg_alpha=1,reg_lambda=20,subsample=.6,colsample_bytree=.6,random_state=42,n_jobs=-1,verbose=-1)
def ct(N,B,C):return ColumnTransformer([('num',Pipeline([('i',SimpleImputer(strategy='median')),('s',StandardScaler())]),N),('bin','passthrough',B),('cat',Pipeline([('i',SimpleImputer(strategy='most_frequent')),('o',OneHotEncoder(handle_unknown='ignore',drop='first'))]),C)])
def thr(y,p,w,target):
 pos=y==1;o=np.argsort(-p[pos]);cum=np.cumsum(w[pos][o])/w[pos].sum();return p[pos][o][min(np.searchsorted(cum,target),len(o)-1)]
def met(y,p,w,t):
 TP=w[(y==1)&(p>=t)].sum();FN=w[(y==1)&(p<t)].sum();FP=w[(y==0)&(p>=t)].sum();TN=w[(y==0)&(p<t)].sum();return TP/(TP+FN),TN/(TN+FP),TP/(TP+FP),(TP+FP)/w.sum()
for tag,N,B,C in configs:
 fe=N+B+C;c=ct(N,B,C);m=lgb.LGBMClassifier(**pars).fit(c.fit_transform(K.iloc[tr][fe]),y[tr]);sets=[]
 for nm,d,yy in [('internal',K.iloc[ho],y[ho]),('pre',P,P.dep.astype(int).values),('post',S,S.dep.astype(int).values)]:sets.append((nm,yy,m.predict_proba(c.transform(d[fe]))[:,1],d.W.to_numpy(float)))
 print('\\nmodel',tag)
 for target in [.85,.90]:
  ti=thr(*sets[0][1:],target);print(' target',target,'internal threshold',ti)
  for nm,yy,p,w in sets:
