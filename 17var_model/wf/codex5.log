import pandas as pd,numpy as np
from sklearn.model_selection import train_test_split,StratifiedKFold
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import StandardScaler,OneHotEncoder
from sklearn.linear_model import LogisticRegression
import lightgbm as lgb
D='data';SEED=42
NUM=['age','sleep_hrs','bmi','income_q','srh','oral_health'];BIN=['partnered','living_alone','current_drinker','active','htn','dm','employed','food_insecure'];CAT=['sex','edu','smoking'];FE=NUM+BIN+CAT
NUM5=['srh','age','sleep_hrs','oral_health'];BIN5=[];CAT5=['sex']
NUM7=NUM5;BIN7=['employed','partnered'];CAT7=['sex']
k=pd.read_parquet('data/ext_kchs.parquet');y=k.dep.astype(int).values;tr,ho=train_test_split(np.arange(len(k)),train_size=500000,test_size=100000,stratify=y,random_state=42);d=k.iloc[ho]
pars=dict(num_leaves=31,min_child_samples=1000,learning_rate=.01,n_estimators=900,reg_alpha=1,reg_lambda=20,subsample=.6,colsample_bytree=.6,random_state=42,n_jobs=-1,verbose=-1)
def ctf(NU,BI,CA):return ColumnTransformer([('num',Pipeline([('i',SimpleImputer(strategy='median')),('s',StandardScaler())]),NU),('bin','passthrough',BI),('cat',Pipeline([('i',SimpleImputer(strategy='most_frequent')),('o',OneHotEncoder(handle_unknown='ignore',drop='first'))]),CA)])
def rec(p,y,w):
 lp=np.log(np.clip(p,1e-6,1-1e-6)/(1-np.clip(p,1e-6,1-1e-6))).reshape(-1,1);o=np.zeros(len(p))
 for a,b in StratifiedKFold(5,shuffle=True,random_state=42).split(lp,y):
  z=LogisticRegression(penalty=None).fit(lp[a],y[a],sample_weight=w[a]);o[b]=z.predict_proba(lp[b])[:,1]
 return o
def nb(p,y,w,pt):return w[(y==1)&(p>=pt)].sum()/w.sum()-w[(y==0)&(p>=pt)].sum()/w.sum()*pt/(1-pt)
for tag,NU,BI,CA in [('17',NUM,BIN,CAT),('5',NUM5,BIN5,CAT5),('7',NUM7,BIN7,CAT7)]:
