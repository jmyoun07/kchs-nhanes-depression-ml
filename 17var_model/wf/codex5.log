import pandas as pd, numpy as np
C={'KCHS':pd.read_parquet('data/ext_kchs.parquet'),'PRE':pd.read_parquet('data/ext_pre.parquet'),'POST':pd.read_parquet('data/ext_post.parquet')}
cat=['sex','edu','income_q','partnered','living_alone','smoking','current_drinker','active','htn','dm','srh','employed','oral_health','alcohol_freq','alcohol_qty','binge','welfare','welfare_12mo','food_insecure','race']
cont=['age','income_raw','sleep_hrs','bmi','stress','alcohol_qty_drinks','sleep_weekend']
def wd(d,v):
 s=d[v]; w=d.W
 ok=s.notna()&w.notna()&(w>0)
 z=pd.DataFrame({'x':s[ok],'w':w[ok]}).groupby('x',dropna=False).w.sum(); z=z/z.sum()*100
 return ','.join(f'{k}:{a:.1f}' for k,a in z.items())
for v in cat:
 print('\\n'+v)
 for nm,d in C.items():
  s=d[v]
  print(f' {nm}: miss={s.isna().mean()*100:.1f}% nuniq={s.nunique(dropna=True)} W%[{wd(d,v)}]')
for v in cont:
 print('\\n'+v)
 for nm,d in C.items():
  s=pd.to_numeric(d[v],errors='coerce'); w=d.W
  q=s.quantile([0,.01,.25,.5,.75,.99,1]).round(3).to_dict()
  ok=s.notna()&w.notna()&(w>0)
  wm=np.average(s[ok],weights=w[ok]) if ok.any() else np.nan
  print(f' {nm}: miss={s.isna().mean()*100:.1f}% meanW={wm:.3f} q={q}')
