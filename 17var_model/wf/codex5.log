class RW:
 def __init__(self,st,ps,w,mode):
  st=pd.Series(st).astype(str).reset_index(drop=True);ps=pd.Series(ps).astype(str).reset_index(drop=True);cl=pd.factorize(st+'|'+ps)[0];base=st
  npsu=pd.DataFrame({'s':st,'p':ps}).drop_duplicates().groupby('s').size();single=set(npsu[npsu==1].index)
  if mode=='global': sg=st.where(~st.isin(single),'__SINGLETON_POOL__')
  elif mode=='year': sg=st.where(~st.isin(single),st.str.split('|').str[0]+'|__SINGLETON_POOL__')
  else: sg=st
  sid=pd.factorize(sg)[0];C=cl.max()+1;cs=np.zeros(C,dtype=int);cs[cl]=sid;self.cl=cl;self.w=np.asarray(w);self.cs=cs;self.n=np.bincount(cs);self.m=np.maximum(self.n-1,1);o=np.argsort(cs,kind='stable');self.sort=o;ss=cs[o];cnt=np.bincount(ss);start=np.r_[0,np.cumsum(cnt)][:-1];self.start=start[ss];self.slotn=cnt[ss];self.singleton=self.n[cs]==1
 def weights(self,rng):
  r=np.zeros(len(self.cs));u=rng.random_sample(len(r));idx=np.arange(len(r))-self.start;sel=np.where(idx<self.m[self.cs[self.sort]])[0];pick=self.start[sel]+(u[sel]*self.slotn[sel]).astype(int);np.add.at(r,self.sort[pick],1);sc=np.where(self.singleton,1,(self.n[self.cs]/self.m[self.cs])*r);return self.w*sc[self.cl]
for mode in ['global','year','certainty']:
 rw=RW((d.year.astype(str)+'|'+d.strata.astype(str)).values,d.psu.values,W,mode);rng=np.random.RandomState(42);a=[];t=time.time()
 for i in range(300):
  w=rw.weights(rng);a.append(roc_auc_score(yy,p,sample_weight=w))
 print(mode,'singleton clusters',rw.singleton.sum(),'CI',np.percentile(a,[2.5,97.5]),'sd',np.std(a,ddof=1),'mean',np.mean(a),'sec',round(time.time()-t,1),flush=True)
