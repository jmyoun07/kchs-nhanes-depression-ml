# ============================================================
# 데이터 — 절대 커밋 금지
# KCHS 원시자료는 재배포 금지(질병관리청 예규 제124호),
# NHANES는 재다운로드 가능하므로 저장소에 두지 않는다.
# ============================================================
data/raw/**
data/interim/**
data/processed/**
!data/**/.gitkeep

# 학습된 모델 바이너리(대용량) — 구조만 유지
models/**
!models/.gitkeep

# 결과물 중 대용량/중간 산출물 (최종 표·그림은 필요시 개별 강제 추가)
results/figures/**
!results/figures/.gitkeep

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ============================================================
# R
# ============================================================
.Rhistory
.RData
.Rproj.user/
renv/library/

# ============================================================
# OS / 편집기
# ============================================================
.DS_Store
Thumbs.db
.vscode/
.idea/

# ============================================================
# 추가 (깃헙 업로드용) — 대용량 캐시·중간산출물·중복 압축본
# ============================================================
17var_model/data/**
experiments/cache/**
experiments/_p1cache/**
results/_p6_cache/**
results/_final_cache/**

# NHANES 원시자료 (공개자료지만 재다운로드 가능 — 저장소에 두지 않음)
*.xpt

# 폴더 중복 압축본
지역사회건강.zip
제출_클로드코드.zip

# Word 임시 락파일
~$*

# ============================================================
# 논문 최종 그림은 포함한다 (위 results/figures/** 제외의 예외)
# ============================================================
!results/figures/*.png

